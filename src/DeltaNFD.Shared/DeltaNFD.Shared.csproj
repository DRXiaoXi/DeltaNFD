<Project Sdk="Microsoft.NET.Sdk">

  <!--
    共享基础设施库（T6）：
    - 承载原先以 <Compile Include> 从主工程源码链接进执行库的基础设施（Native/Services）；
    - 物理搬迁后唯一副本：前端、执行库、脱机助手、冒烟测试均改为项目引用；
    - 不含 WinUI/WindowsAppSDK，可无 UI 编译；不引用执行库或主程序（无环）。
    - 设置、备份、目标定位、只读拓扑数据及脱机锁等共享基础设施。
    - CPU Sets/CPU 调度、内存清理、计时器/停核控制、NVAPI 写入与权限调整属于 Execution，不得放回本库。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>DeltaNFD.Shared</AssemblyName>
    <RootNamespace>DeltaNFD.Shared</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.915</Version>
    <InformationalVersion>Alpha0.915</InformationalVersion>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <!--
    既有 internal 成员（如 AppSettings.Copy、备份存储内部结构）仍被这些程序集使用，
    物理搬迁后通过 InternalsVisibleTo 保持编译与行为不变。
  -->
  <ItemGroup>
    <InternalsVisibleTo Include="DeltaNFD" />
    <InternalsVisibleTo Include="DeltaNFD.Execution" />
    <InternalsVisibleTo Include="DeltaNFD.OfflineHelper" />
    <InternalsVisibleTo Include="BackendSmokeTest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeltaNFD.Contracts\DeltaNFD.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
  </ItemGroup>

</Project>
