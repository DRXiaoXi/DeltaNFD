<Project Sdk="Microsoft.NET.Sdk">

  <!--
    「DPC 计时器常驻（Win10 研究）」拓展插件后端（规范 1.0）。
    独立工程：不引用宿主 DeltaNFD 或官方助手任何程序集/服务（规范第 1、9 节）。
    只依赖 BCL：命名管道 IPC、SCM/进程/计时器只读查询与用户自备原版 DPC 进程管理。
    本工程不包含、不提取、不直接加载任何驱动；驱动由玩家自备的原版 DPC 按其自身流程加载。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Plugin.DpcTimerHold</RootNamespace>
    <AssemblyName>Plugin.DpcTimerHold</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <!-- 插件不参与宿主的源链接/分析器配置 -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
