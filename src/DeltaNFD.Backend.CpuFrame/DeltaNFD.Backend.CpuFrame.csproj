<Project Sdk="Microsoft.NET.Sdk">

  <!--
    CPU/帧格后端（T4）：持久驻留，持有唯一的游戏监控与状态通道。
    - 只引用共享执行库 DeltaNFD.Execution（其中链接/承载 CPU 拓扑、帧格临时优化、电源守护与执行引擎）；
    - 不引用主程序 DeltaNFD，不含任何 UI/WinUI；
    - 空闲时由宿主状态通道推送实际生效状态快照。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>DeltaNFD.Backend.CpuFrame</AssemblyName>
    <RootNamespace>DeltaNFD.Backend.CpuFrame</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseAppHost>true</UseAppHost>
    <Version>0.9195</Version>
    <InformationalVersion>Alpha0.9195</InformationalVersion>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeltaNFD.Execution\DeltaNFD.Execution.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="obj\**\*.cs" />
  </ItemGroup>

</Project>
