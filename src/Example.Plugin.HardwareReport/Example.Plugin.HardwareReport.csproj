<Project Sdk="Microsoft.NET.Sdk">

  <!--
    拓展插件规范 1.0 的最小只读示例（hardware-report）。
    独立工程：不引用宿主 DeltaNFD 或官方助手任何程序集/服务（规范第 1、9 节）。
    只读操作：收集系统摘要并返回 result；不修改系统、不请求 continuous / offlineAutonomous。
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Example.Plugin</RootNamespace>
    <AssemblyName>Example.Plugin.HardwareReport</AssemblyName>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
  </PropertyGroup>

</Project>
