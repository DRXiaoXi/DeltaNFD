{
  // 自动更新来源与网络参数（Delta NFD）—— 这是“随程序发布”的默认配置。
  //
  // 注意：本文件在程序目录（Assets\）下，升级安装会被新版本覆盖。
  //       修改用户级配置，可用设置页「更新源配置」生成并编辑
  //       %APPDATA%\Delta NFD\update-source.json —— 它优先级更高，且升级不会覆盖。
  //
  // manifestUrls  : 公测来源，GitHub 优先；失败后尝试自建服务器。
  // internalManifestUrls : 内测来源，同样优先 GitHub，失败后尝试自建服务器。
  // GitHub 发布列表按所选内测/公测通道筛选，再按数值选择最高版本，不读取未发布的 main/update.json。
  // 旧官方来源与代理配置会迁移为 GitHub 优先、自建服务器备用。
  // allowedHosts  : 允许下载/取清单的主机白名单（精确匹配或子域后缀匹配）。
  //                 完全自定义来源须配置其主机；不再使用 GitHub 加速代理。
  // autoCheckThrottleHours : 旧字段，保留兼容；现在每次启动都检查，不再按小时跳过。
  // checkTimeoutSeconds    : 取清单的超时（秒）。
  // downloadTimeoutMinutes : 下载安装包的单次静默超时（分钟，实际按“无数据”空闲计时）。
  // releasePageUrl         : 清单不可用 / 未安装版时，给用户手动下载的兜底页面。
  "schemaVersion": 1,
  "manifestUrls": [
    "https://api.github.com/repos/DRXiaoXi/DeltaNFD/releases?per_page=100",
    "https://deltaxiaoxi.xin/updates/update.json"
  ],
  "internalManifestUrls": [
    "https://api.github.com/repos/DRXiaoXi/DeltaNFD/releases?per_page=100",
    "https://deltaxiaoxi.xin/updates/internal/update.json"
  ],
  "allowedHosts": [
    "deltaxiaoxi.xin",
    "githubusercontent.com",
    "github.com",
    "api.github.com",
    "objects.githubusercontent.com",
    "release-assets.githubusercontent.com"
  ],
  "autoCheckThrottleHours": 6,
  "checkTimeoutSeconds": 15,
  "downloadTimeoutMinutes": 60,
  "releasePageUrl": "https://github.com/DRXiaoXi/DeltaNFD/releases"
}
