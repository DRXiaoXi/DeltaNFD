  {
    "Name": "OneDrive",
    "Type": "DOUBLE",
    "Tweaks": [
      {
        "TweakType": "CMD",
        "Path": "OneDriveUninstall",
        "Values": [
          { "ValueTypes": [ "BEST", "ON" ], "Value": "cmd /d /c \"if exist \\\"%SystemRoot%\\System32\\OneDriveSetup.exe\\\" (\\\"%SystemRoot%\\System32\\OneDriveSetup.exe\\\" /uninstall) else if exist \\\"%SystemRoot%\\SysWOW64\\OneDriveSetup.exe\\\" (\\\"%SystemRoot%\\SysWOW64\\OneDriveSetup.exe\\\" /uninstall)\"" },
          { "ValueTypes": [ "DEFAULT", "OFF" ], "Value": "" }
        ]
      }
    ]
  }
