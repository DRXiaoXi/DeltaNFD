  {
    "Name": "HandwritingEN",
    "Type": "DOUBLE",
    "Tweaks": [
      {
        "TweakType": "CMD",
        "Path": "Language.Handwriting.en-US",
        "Values": [
          { "ValueTypes": [ "BEST", "ON" ], "Value": "powershell -NoProfile -Command \"Get-WindowsCapability -Online | Where-Object { $_.Name -like 'Language.Handwriting*en-US*' -and $_.State -eq 'Installed' } | Remove-WindowsCapability -Online\"" },
          { "ValueTypes": [ "DEFAULT", "OFF" ], "Value": "powershell -NoProfile -Command \"Get-WindowsCapability -Online | Where-Object { $_.Name -like 'Language.Handwriting*en-US*' -and $_.State -ne 'Installed' } | Add-WindowsCapability -Online\"" }
        ]
      }
    ]
  },
