<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        统一 UI 基线（2026-10 UI 统一轮）。
        取值以主页磁贴实现为准：标题 15/正文 13/数值 14/脚注 12、圆角 8–12、间距 8/12/16、强调色 AppAccentBrush。
        页面只引用这里的命名样式，不再写死字号，避免同一屏里出现 11/12/12.5/13/13.5 混杂。
    -->
    <!-- ============================ 文本层级 ============================ -->
    <!-- 页面大标题（每页唯一） -->
    <Style x:Key="H1Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- 区块 / 卡片标题 -->
    <Style x:Key="H2Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- 小节标题（卡片内分组） -->
    <Style x:Key="H3Style" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <!-- 正文：零基础用户的主要阅读层 -->
    <Style x:Key="BodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <!-- 说明文字（比正文弱一档，用于"为什么/会怎样"） -->
    <Style x:Key="NoteStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="LineHeight" Value="18"/>
    </Style>
    <!-- 数值 / 读数（等宽数字，防止跳动） -->
    <Style x:Key="MetricStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    </Style>
    <!-- 大数值 -->
    <Style x:Key="MetricLargeStyle" TargetType="TextBlock" BasedOn="{StaticResource MetricStyle}">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- 徽标 / 小胶囊文字 -->
    <Style x:Key="BadgeTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <!-- ============================ 按钮 ============================ -->
    <!-- 次级按钮：所有"非主操作"按钮统一用它，避免默认按钮尺寸不一 -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}"/>
    </Style>
    <!-- 主操作按钮（强调色实心 + 已有指针态动画） -->
    <!-- 危险操作（恢复、卸载、强制） -->
    <!-- 页面标题按钮：透明、左对齐、零内边距，按下/悬停只做轻微亮度，不改变 H1 排版 -->
    <Style x:Key="PageHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <!-- 返回主页的「‹」：比标题略小、次要色，避免与标题抢视觉重量 -->
    <Style x:Key="PageHeaderChevronStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Opacity" Value="0.72"/>
        <Setter Property="Margin" Value="0,0,2,0"/>
    </Style>
    <!-- ============================ 功能磁贴 ============================ -->
    <!--
        功能行磁贴：把"一行开关/一组设置"从裸行升级成独立磁贴（与主页磁贴同一材质语言）。
        只设外观与内边距，不改元素类型；配合 controls:HoverLift.Enabled="True" 获得统一的悬停抬升。
    -->
    <Style x:Key="FeatureTileGridStyle" TargetType="Grid">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="ColumnSpacing" Value="16"/>
    </Style>
    <Style x:Key="FeatureTilePanelStyle" TargetType="StackPanel">
        <Setter Property="Padding" Value="16"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Spacing" Value="4"/>
    </Style>
    <!-- ============================ 容器 ============================ -->
    <!-- 卡片内的小分隔线 -->
    <Style x:Key="DividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{ThemeResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="Margin" Value="0,2"/>
    </Style>
    <!-- 卡片内的强调块（提示 / 结论） -->
</ResourceDictionary>
