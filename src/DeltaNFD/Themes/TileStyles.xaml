<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:DeltaNFD.Controls">
    <!-- Presentation adapted from the supplied UI branch. States and actions remain in current code. -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="DashboardFrameStrokeBrush" Color="#D47745" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DashboardFrameStrokeBrush" Color="#A8440B" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DashboardFrameStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
    <Style x:Key="DashboardTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="22" />
        <Setter Property="ui:HoverLift.Enabled" Value="True" />
    </Style>
    <Style x:Key="DashboardFrameTileStyle" TargetType="Border" BasedOn="{StaticResource DashboardTileStyle}">
        <!-- Accent identifies the frame section; it does not claim execution is active. -->
        <Setter Property="BorderBrush" Value="{ThemeResource DashboardFrameStrokeBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
</ResourceDictionary>
