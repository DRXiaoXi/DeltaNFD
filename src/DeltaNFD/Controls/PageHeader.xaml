<UserControl
    x:Class="DeltaNFD.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        页面标题 + 返回主页入口：
        标题本身可点，左侧再加一个「‹」作为可发现性提示；两者都走同一套 H1 排版，
        返回统一调用 App.MainWindow.NavigateByTag("dashboard")（与主页快捷磁贴同一导航方式）。
    -->
    <Button x:Name="HeaderButton"
            Style="{StaticResource PageHeaderButtonStyle}"
            Click="OnBackToHome"
            ToolTipService.ToolTip="返回主页">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock x:Name="ChevronText"
                       Text="&#x2039;"
                       Style="{StaticResource PageHeaderChevronStyle}"
                       VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText"
                       Style="{StaticResource H1Style}"
                       VerticalAlignment="Center" />
        </StackPanel>
    </Button>
</UserControl>
