<Window
    x:Class="DeltaNFD.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 背景图（自定义图或 Assets\background.* 存在时显示，覆盖整个窗口；遮罩浓度可在设置里调） -->
        <Image x:Name="BgImage" Grid.RowSpan="2" Stretch="UniformToFill" Visibility="Collapsed" />
        <!-- 背景图上的暗色遮罩，保证卡片与文字可读 -->
        <Border x:Name="BgDim" Grid.RowSpan="2" Visibility="Collapsed" />

        <!-- 自定义标题栏（延伸进内容区） -->
        <Grid x:Name="AppTitleBar" Background="Transparent">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="10" Margin="16,0,0,0">
                <Border Width="26" Height="26" CornerRadius="7">
                    <Image x:Name="AppLogoImage" Source="ms-appx:///Assets/DeltaNFD.png"
                           Stretch="Uniform" />
                </Border>
                <TextBlock Text="三角帧不掉洲" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border Style="{StaticResource ChipBorderStyle}" Background="{StaticResource AppAccentChipBrush}"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="AppVersionText" FontSize="10" FontWeight="SemiBold"
                               Foreground="{StaticResource AppAccentBrush}" />
                </Border>
                <TextBlock Text="三角洲行动优化工具 · 作者 逐梦之子-晓夕" FontSize="12" Opacity="0.55" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            PaneDisplayMode="Left"
            OpenPaneLength="190"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.Resources>
                <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent" />
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem Tag="dashboard" Content="主页">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="system" Content="系统优化">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE945;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="spoof" Content="显卡伪装">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AB;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="nvsettings" Content="NVIDIA显卡设置">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE7F4;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="frame" Content="帧格">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="shader" Content="着色器">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF211;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="ace" Content="ACE相关">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE72E;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="runtime" Content="运行库">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE90F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="lab" Content="CPU实验室">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Tag="plugins" Content="拓展插件">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEA86;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.FooterMenuItems>
                <NavigationViewItem x:Name="SettingsNavItem" Tag="settings" Content="设置">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
