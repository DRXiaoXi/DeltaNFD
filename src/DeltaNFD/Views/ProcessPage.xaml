<Page x:Class="DeltaNFD.Views.ProcessPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:DeltaNFD.ViewModels">
  <Page.Resources>
    <!-- 进程行模板：名称/PID/内存/持有数；选中后右侧加载详情 -->
    <DataTemplate x:Key="ProcessRowTemplate" x:DataType="vm:ProcessRowVm">
      <Grid ColumnSpacing="8" Padding="14,9">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="2*" />
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="72" />
          <ColumnDefinition Width="50" />
        </Grid.ColumnDefinitions>
        <StackPanel Spacing="1">
          <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ExecutablePath}" />
          <TextBlock Text="{x:Bind PidText}" FontSize="11" Opacity="0.6" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{x:Bind CpuText}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" />
        <TextBlock Grid.Column="2" Text="{x:Bind WorkingSetText}" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextAlignment="Right" ToolTipService.ToolTip="进程工作集内存" />
        <Border Grid.Column="3" Style="{StaticResource ChipBorderStyle}" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center" Visibility="{x:Bind ProtectedVisibility}">
          <TextBlock Text="受保护" FontSize="10" Opacity="0.75" />
        </Border>
      </Grid>
    </DataTemplate>
  </Page.Resources>
  <Grid Padding="24,18,24,18" RowSpacing="14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="进程管理" Style="{StaticResource PageTitleStyle}" />
      <TextBlock Text="查看运行状态、调整进程属性，管理自动应用的规则。" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
    </StackPanel>
    <!-- 按任务拆分页签，避免规则与保护设置挤占进程列表高度。 -->
    <TabView Grid.Row="1" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent" x:Name="ProcessTabs">
      <TabViewItem Header="进程与属性" IsClosable="False">
        <Grid ColumnSpacing="16" RowSpacing="12" Margin="0,12,0,0" SizeChanged="ProcessWorkspace_SizeChanged" x:Name="ProcessWorkspace">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" x:Name="ListRow" />
            <RowDefinition Height="0" x:Name="DetailRow" />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.8*" x:Name="ListColumn" />
            <ColumnDefinition Width="1.2*" x:Name="DetailColumn" />
          </Grid.ColumnDefinitions>
          <!-- 左：进程列表 -->
          <Border Style="{StaticResource CardBorderStyle}" Padding="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Padding="14,14,14,4" ColumnSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" PlaceholderText="搜索进程名称" TextChanged="SearchBox_TextChanged" MaxLength="80" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                  <Button Content="刷新" Click="RefreshButton_Click" />
                  <ToggleButton x:Name="AutoRefreshToggle" Content="自动刷新" IsChecked="True" />
                </StackPanel>
                <TextBlock Text="运行中的进程" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
              </Grid>
              <Grid Grid.Row="1" ColumnSpacing="8" Padding="14,2,14,4" Opacity="0.65">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="52" />
                  <ColumnDefinition Width="72" />
                  <ColumnDefinition Width="50" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="名称 / PID" FontSize="11" />
                <TextBlock Grid.Column="1" Text="CPU" FontSize="11" TextAlignment="Right" />
                <TextBlock Grid.Column="2" Text="内存" FontSize="11" TextAlignment="Right" />
              </Grid>
              <ListView Grid.Row="2" x:Name="ProcessList" ItemTemplate="{StaticResource ProcessRowTemplate}" SelectionMode="Single" SelectionChanged="ProcessList_SelectionChanged" VirtualizingStackPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListView.ItemContainerStyle>
                  <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,1" />
                  </Style>
                </ListView.ItemContainerStyle>
              </ListView>
              <StackPanel Grid.Row="3" Padding="14,6,14,10" Spacing="6">
                <TextBlock x:Name="ListNoteText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" MaxLines="2" />
                <TextBlock x:Name="ListSummaryText" FontSize="11" Opacity="0.65" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="PreviousPageButton" Content="上一页" Click="PreviousPage_Click" IsEnabled="False" />
                  <Button x:Name="NextPageButton" Content="下一页" Click="NextPage_Click" IsEnabled="False" />
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
          <!-- 右：详情 + 控制 -->
          <Border x:Name="DetailCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
            <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" x:Name="DetailControlsHost">
              <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                <StackPanel Spacing="12" Padding="16,14,16,16">
                  <!-- 未选择占位 -->
                  <StackPanel x:Name="DetailEmptyPanel" Spacing="14" Padding="16,40">
                    <TextBlock Text="选择一个进程" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Text="从列表中选择目标，查看实际属性并调整运行方式。受保护的系统进程仅提供查看。" />
                  </StackPanel>
                  <!-- 详情内容 -->
                  <StackPanel x:Name="DetailPanel" Spacing="12" Visibility="Collapsed">
                    <StackPanel Spacing="3">
                      <TextBlock x:Name="DetailNameText" Style="{StaticResource SectionTitleStyle}" FontSize="20" TextTrimming="CharacterEllipsis" />
                      <Expander Header="可执行文件路径" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <TextBlock x:Name="DetailPathText" FontSize="11" Opacity="0.65" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                      </Expander>
                      <TextBlock x:Name="DetailMetaText" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                    <InfoBar x:Name="DetailIdentityWarning" IsOpen="False" Severity="Warning" IsClosable="False" />
                    <!-- 能力面板 -->
                    <Expander Header="当前属性与控制方" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                      <ItemsControl x:Name="CapabilityList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:CapabilityVm">
                            <Border Padding="0,7" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                              <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                  <Border Style="{StaticResource ChipBorderStyle}" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center" Visibility="{x:Bind ChipVisibility}">
                                    <TextBlock Text="{x:Bind ChipText}" FontSize="10" Opacity="0.75" />
                                  </Border>
                                </StackPanel>
                                <TextBlock Text="{x:Bind ValueText}" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Bind ErrorText}" FontSize="11" Opacity="0.7" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="{x:Bind ErrorVisibility}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </Expander>
                    <!-- 控制区 -->
                    <StackPanel x:Name="ControlPanel" Spacing="10">
                      <TextBlock Text="属性设置" Style="{StaticResource SectionTitleStyle}" />
                      <RadioButtons x:Name="ApplyScopePicker" Header="作用范围" SelectedIndex="0" MaxColumns="2" SelectionChanged="ApplyScopePicker_SelectionChanged">
                        <RadioButton Content="当前" />
                        <RadioButton Content="总是" />
                      </RadioButtons>
                      <TextBlock x:Name="ApplyScopeNote" Text="当前：只调整选中的本次进程，不新增或修改总是规则。" TextWrapping="Wrap" FontSize="12" />
                      <CheckBox x:Name="AlwaysTakeoverCheck" Visibility="Collapsed">
                        <TextBlock Text="允许总是规则接管游戏模式控制的同一属性" TextWrapping="Wrap" />
                      </CheckBox>
                      <TextBlock x:Name="SelectedAlwaysSummary" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource AppAccentBrush}" />
                      <!-- CPU 优先级 -->
                      <StackPanel Spacing="4">
                        <TextBlock Text="CPU 优先级" FontSize="12" FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <ComboBox x:Name="PriorityCombo" Width="180" SelectedIndex="2">
                            <ComboBoxItem Content="Idle（低）" />
                            <ComboBoxItem Content="Below Normal" />
                            <ComboBoxItem Content="Normal（默认）" />
                            <ComboBoxItem Content="Above Normal" />
                            <ComboBoxItem Content="High（高）" />
                          </ComboBox>
                          <Button Content="应用" Click="ApplyPriority_Click" />
                        </StackPanel>
                        <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap" Text="实时优先级不开放（自动策略与常规入口均禁用）。修改前会先记录原值，可随时还原。" />
                      </StackPanel>
                      <!-- 亲和性/CPU 集合（按处理器组） -->
                      <Expander Header="CPU 亲和性与 CPU 集合" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Name="AffinityExpander">
                        <StackPanel Spacing="4">
                          <TextBlock Text="CPU 亲和性（按处理器组）" FontSize="12" FontWeight="SemiBold" />
                          <StackPanel x:Name="AffinityGroupPanel" Spacing="4" />
                          <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                              <RowDefinition Height="Auto" />
                              <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Button Content="应用亲和性" Click="ApplyAffinity_Click" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" />
                            <Button Content="应用 CPU 集合" Click="ApplyCpuSet_Click" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" />
                            <Button Content="清除 CPU 集合" Click="ClearCpuSet_Click" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" />
                            <Button Content="解除亲和性限制" Click="ClearAffinity_Click" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" />
                          </Grid>
                          <TextBlock x:Name="TopologyNoteText" FontSize="10" Opacity="0.55" TextWrapping="Wrap" Text="按处理器组设置；P/E 核与 NUMA 拓扑无法识别时不猜测标签。" />
                        </StackPanel>
                      </Expander>
                      <!-- 动态优先级提升 / 效率模式 -->
                      <Expander Header="效率模式与动态优先级" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="PriorityBoostToggle" Header="动态优先级提升" OnContent="启用" OffContent="禁用" />
                            <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap" MaxWidth="220" Text="Windows API 为反向禁用参数，此处已按「是否启用」如实呈现。" />
                          </StackPanel>
                          <StackPanel Spacing="4">
                            <ToggleSwitch x:Name="EcoQosToggle" Header="效率模式（EcoQoS）" OnContent="允许降速" OffContent="高性能" />
                            <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap" MaxWidth="220" Text="仅在可读取原始状态时开放；设置与还原均回读核验。" />
                          </StackPanel>
                          <Button Content="应用开关设置" Click="ApplyToggles_Click" />
                        </StackPanel>
                      </Expander>
                      <!-- I/O 优先级 / GPU 首选项（P3） -->
                      <Expander Header="I/O 与 GPU 首选项" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="14">
                          <StackPanel Spacing="4">
                            <TextBlock Text="I/O 优先级" FontSize="12" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ComboBox x:Name="IoPriorityCombo" Width="160" SelectedIndex="2">
                                <ComboBoxItem Content="VeryLow（后台）" />
                                <ComboBoxItem Content="Low" />
                                <ComboBoxItem Content="Normal（默认）" />
                                <ComboBoxItem Content="High" />
                              </ComboBox>
                              <Button Content="应用" Click="ApplyIoPriority_Click" />
                            </StackPanel>
                            <TextBlock FontSize="10" Opacity="0.55" TextWrapping="Wrap" MaxWidth="220" Text="Native 兼容层（ntdll）；Critical 为系统保留不开放。" />
                          </StackPanel>
                          <StackPanel Spacing="4">
                            <TextBlock Text="GPU 首选项（按应用）" FontSize="12" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <ComboBox x:Name="GpuPreferenceCombo" Width="160" SelectedIndex="0">
                                <ComboBoxItem Content="Windows 默认" />
                                <ComboBoxItem Content="省电" />
                                <ComboBoxItem Content="高性能" />
                              </ComboBox>
                              <Button Content="应用" Click="ApplyGpuPreference_Click" />
                            </StackPanel>
                            <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap" Text="GPU 首选项由 Windows 按应用保存，不受“当前 / 总是”选择影响；生效可能需要重启目标程序。" />
                          </StackPanel>
                        </StackPanel>
                      </Expander>
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="ResetSelectedButton" Content="还原当前进程修改" Click="ResetAll_Click" />
                      </StackPanel>
                    </StackPanel>
                    <!-- 持有记录 -->
                    <Expander Header="内存与 GPU 调度" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                      <StackPanel x:Name="AdditionalControlPanel" Spacing="8">
                        <ComboBox x:Name="MemoryPriorityCombo" Header="内存优先级" SelectedIndex="4" HorizontalAlignment="Stretch">
                          <ComboBoxItem Content="很低" />
                          <ComboBoxItem Content="低" />
                          <ComboBoxItem Content="中等" />
                          <ComboBoxItem Content="低于正常" />
                          <ComboBoxItem Content="正常（最高可用）" />
                        </ComboBox>
                        <Button Content="应用内存优先级" Click="ApplyMemoryPriority_Click" />
                        <ComboBox x:Name="GpuPriorityCombo" Header="GPU 调度优先级（以驱动支持为准）" SelectedIndex="2">
                          <ComboBoxItem Content="Idle" />
                          <ComboBoxItem Content="BelowNormal" />
                          <ComboBoxItem Content="Normal" />
                          <ComboBoxItem Content="AboveNormal" />
                          <ComboBoxItem Content="High" />
                        </ComboBox>
                        <Button Content="应用 GPU 调度优先级" Click="ApplyGpuPriority_Click" />
                      </StackPanel>
                    </Expander>
                    <StackPanel x:Name="HeldPanel" Spacing="6" Visibility="Collapsed">
                      <TextBlock Text="本工具持有的修改记录" Style="{StaticResource SectionTitleStyle}" />
                      <ItemsControl x:Name="HeldList">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:HeldChangeVm">
                            <TextBlock FontSize="12" TextWrapping="Wrap" Padding="0,2" Text="{x:Bind DisplayText}" />
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                    <!-- 操作反馈 -->
                    <!-- 核对/恢复 -->
                    <StackPanel Spacing="8">
                      <TextBlock Text="核对与恢复" Style="{StaticResource SectionTitleStyle}" />
                      <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Text="「核对」逐条比对记录与当前实际值（只读）；外部已修改的记录会以冲突保留，绝不盲目覆盖。「全部还原」用于退出前收尾。" />
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="核对记录" Click="Reconcile_Click" />
                        <Button Content="全部还原" Click="RestoreAll_Click" />
                      </StackPanel>
                      <TextBlock x:Name="ReconcileText" FontSize="11" Opacity="0.75" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    </StackPanel>
                  </StackPanel>
                  <Expander Header="管理所有“总是”规则" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Name="AlwaysRulesExpander">
                    <StackPanel Spacing="16">
                      <StackPanel Spacing="12" Visibility="Collapsed" x:Name="SavedRuleEditor">
                        <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                          <StackPanel Spacing="4">
                            <TextBlock x:Name="RuleTargetNameText" Text="尚未选择目标进程" FontWeight="SemiBold" />
                            <TextBlock x:Name="RuleTargetPathText" Text="选择进程后即可创建规则。" FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                          </StackPanel>
                        </Border>
                        <StackPanel x:Name="RuleEditorPanel" Spacing="12">
                          <ComboBox x:Name="RuleCapabilityCombo" Header="能力" SelectedIndex="0" MinWidth="180" SelectionChanged="RuleCapabilityCombo_SelectionChanged" HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="CPU 优先级" />
                            <ComboBoxItem Content="效率模式（EcoQoS）" />
                            <ComboBoxItem Content="动态优先级提升" />
                            <ComboBoxItem Content="CPU 亲和性（g0:0x掩码）" />
                            <ComboBoxItem Content="CPU 集合（按组掩码）" />
                            <ComboBoxItem Content="I/O 优先级（Low/Normal 等）" />
                            <ComboBoxItem Content="内存优先级" />
                            <ComboBoxItem Content="GPU 调度优先级（0–4）" />
                          </ComboBox>
                          <ComboBox x:Name="RuleValueCombo" Header="应用的设置" HorizontalAlignment="Stretch" />
                          <StackPanel x:Name="RuleMaskPanel" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="可使用进程页中勾选的 CPU，或编辑处理器组掩码。" FontSize="12" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                              <Button Content="使用勾选的 CPU" Click="UseSelectedCpus_Click" />
                              <Button Content="选择 CPU" Click="GoToCpuSelection_Click" />
                            </StackPanel>
                            <TextBox x:Name="RuleValueBox" Header="处理器组掩码" PlaceholderText="例：g0:0xF" MaxLength="512" />
                          </StackPanel>
                          <ToggleSwitch x:Name="RuleEnabledToggle" Header="启用规则" OnContent="启用" OffContent="停用" IsOn="True" />
                          <CheckBox x:Name="RuleAutoTakeoverCheck" Content="允许规则接管游戏模式控制的同一属性" />
                        </StackPanel>
                        <Button Content="保存总是设置" Click="SaveRule_Click" Style="{StaticResource AccentButtonStyle}" />
                      </StackPanel>
                      <StackPanel Orientation="Vertical" Spacing="10">
                        <TextBlock Text="总是规则" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" FontSize="20" />
                      </StackPanel>
                      <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Text="在属性设置中选择“总是”即可保存。下方可管理已有规则，包括当前未运行的应用。" />
                      <TextBlock FontWeight="SemiBold" Text="尚未读取规则" x:Name="RuleCountText" />
                      <Button Content="刷新" Click="LoadRules_Click" />
                      <StackPanel x:Name="RuleListPanel" Spacing="3" />
                      <TextBlock x:Name="RuleNoteText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                  </Expander>
                </StackPanel>
              </ScrollViewer>
            </ContentControl>
          </Border>
        </Grid>
      </TabViewItem>
      <TabViewItem Header="后台抑制" IsClosable="False">
        <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Padding="0" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Padding="24" MaxWidth="760" HorizontalAlignment="Left">
              <StackPanel Orientation="Vertical" Spacing="10">
                <TextBlock Text="保持前台应用响应" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" FontSize="20" />
              </StackPanel>
              <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Text="CPU 持续繁忙时，暂时降低合适的后台应用优先级；负载回落后恢复。排除三角洲主进程、所有系统进程、前台应用，以及已有属性设置或持久规则的进程。" />
              <ToggleSwitch x:Name="ResponsivenessToggle" Header="启用后台抑制" OnContent="启用" OffContent="关闭（默认）" />
              <Grid ColumnSpacing="12" RowSpacing="16">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <NumberBox x:Name="BusyThresholdBox" Header="触发 CPU%（默认80）" Value="80" Minimum="10" Maximum="99" SpinButtonPlacementMode="Compact" Grid.Row="0" Grid.Column="0" />
                <NumberBox x:Name="IdleThresholdBox" Grid.Column="1" Header="恢复 CPU%（默认60）" Value="60" Minimum="5" Maximum="99" SpinButtonPlacementMode="Compact" Grid.Row="0" />
                <NumberBox x:Name="MaxAdjustBox" Grid.Column="0" Header="每轮上限（默认2）" Value="2" Minimum="1" Maximum="4" SpinButtonPlacementMode="Compact" Grid.Row="1" />
                <NumberBox x:Name="CooldownBox" Grid.Column="1" Header="冷却秒（默认10）" Value="10" Minimum="0" Maximum="600" SpinButtonPlacementMode="Compact" Grid.Row="1" />
              </Grid>
              <Button Content="保存设置" Click="SaveResponsiveness_Click" Style="{StaticResource AccentButtonStyle}" />
              <TextBlock FontSize="12" Opacity="0.75" TextWrapping="Wrap" Text="系统进程按系统目录、服务会话、系统账户及关键进程状态核对；身份或权限无法确认时跳过。前台应用不参与；任何属性已有手动设置或已启用规则的进程均跳过。采样失败时不新增调整，关闭后恢复。" />
              <TextBlock x:Name="ResponsivenessNoteText" FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
              <Button Content="查看事件" Click="LoadResponsivenessEvents_Click" />
              <TextBlock FontSize="12" TextWrapping="Wrap" IsTextSelectionEnabled="True" x:Name="ResponsivenessEventsText" />
            </StackPanel>
          </ScrollViewer>
        </Border>
      </TabViewItem>
    </TabView>
    <InfoBar x:Name="OperationResultBar" IsOpen="False" IsClosable="True" Grid.Row="2" />
  </Grid>
</Page>