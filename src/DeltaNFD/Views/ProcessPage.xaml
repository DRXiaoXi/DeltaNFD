<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:DeltaNFD.Controls" xmlns:vm="using:DeltaNFD.ViewModels" x:Class="DeltaNFD.Views.ProcessPage">
    <Page.Resources>
        <SolidColorBrush x:Key="TabViewBackground" Color="Transparent"/>
        <SolidColorBrush x:Key="TabViewItemHeaderBackground" Color="Transparent"/>
        <!-- 进程行模板：名称/PID/内存/持有数；选中后右侧加载详情 -->
        <DataTemplate x:Key="ProcessRowTemplate" x:DataType="vm:ProcessRowVm">
            <Grid ColumnSpacing="8" Padding="14,9">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="1">
                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ExecutablePath}" Style="{StaticResource H3Style}"/>
                    <TextBlock Text="{x:Bind PidText, Mode=OneWay}" TextTrimming="CharacterEllipsis" Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{x:Bind CpuText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" Style="{StaticResource CaptionStyle}"/>
                <TextBlock Grid.Column="2" Text="{x:Bind WorkingSetText, Mode=OneWay}" VerticalAlignment="Center" TextAlignment="Right" ToolTipService.ToolTip="进程工作集内存" Style="{StaticResource CaptionStyle}"/>
                <Border Grid.Column="3" Style="{StaticResource ChipBorderStyle}" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center" Visibility="{x:Bind ProtectedVisibility, Mode=OneWay}">
                    <TextBlock Text="{x:Bind ProtectionText, Mode=OneWay}" Style="{StaticResource CaptionStyle}"/>
                </Border>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Padding="24,18,24,18" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Spacing="4">
            <ui:PageHeader Title="进程管理"/>
            <TextBlock Text="查看运行状态、调整进程属性，管理自动应用的规则。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <!-- 按任务拆分页签，避免规则与保护设置挤占进程列表高度。 -->
        <TabView Grid.Row="1" IsAddTabButtonVisible="False" CanDragTabs="False" CanReorderTabs="False" TabWidthMode="SizeToContent" x:Name="ProcessTabs" Background="Transparent" SelectionChanged="ProcessTabs_SelectionChanged">
            <TabViewItem x:Name="GeneralTab" Header="进程与属性" IsClosable="False">
                <ContentControl x:Name="GeneralWorkspaceHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                    <Grid ColumnSpacing="16" RowSpacing="12" Margin="0,12,0,0" SizeChanged="ProcessWorkspace_SizeChanged" x:Name="ProcessWorkspace">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" x:Name="ListRow"/>
                            <RowDefinition Height="0" x:Name="DetailRow"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.8*" x:Name="ListColumn"/>
                            <ColumnDefinition Width="1.2*" x:Name="DetailColumn"/>
                        </Grid.ColumnDefinitions>
                        <!-- 左：进程列表 -->
                        <Border Style="{StaticResource CardBorderStyle}" Padding="0">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Padding="14,14,14,4" ColumnSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SearchBox" PlaceholderText="搜索进程名称" TextChanged="SearchBox_TextChanged" MaxLength="80" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,10,0,0"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                        <Button Content="刷新" Click="RefreshButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                        <ToggleButton x:Name="AutoRefreshToggle" Content="自动刷新" IsChecked="True"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ProcessListTitle" Text="其他运行中的进程" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource H2Style}"/>
                                </Grid>
                                <Grid Grid.Row="1" ColumnSpacing="8" Padding="14,2,14,4" Opacity="0.65">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="50"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="名称 / PID" Style="{StaticResource NoteStyle}"/>
                                    <TextBlock Grid.Column="1" Text="CPU" TextAlignment="Right" Style="{StaticResource NoteStyle}"/>
                                    <TextBlock Grid.Column="2" Text="内存" TextAlignment="Right" Style="{StaticResource NoteStyle}"/>
                                </Grid>
                                <ListView Grid.Row="2" x:Name="ProcessList" Background="Transparent" ItemTemplate="{StaticResource ProcessRowTemplate}" SelectionMode="Single" SelectionChanged="ProcessList_SelectionChanged" VirtualizingStackPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListView.ItemContainerTransitions>
                                        <TransitionCollection/>
                                    </ListView.ItemContainerTransitions>
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="0"/>
                                            <Setter Property="Margin" Value="0,1"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>
                                </ListView>
                                <StackPanel Grid.Row="3" Padding="14,6,14,10" Spacing="6">
                                    <TextBlock x:Name="ScopeNoteText" Text="按名称稳定排列，只更新变化的数值。三角洲属性请在“调度改善”中预先配置，后台开关请在帧格开启。" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"/>
                                    <TextBlock x:Name="ListNoteText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" MaxLines="2"/>
                                    <TextBlock x:Name="ListSummaryText" Style="{StaticResource CaptionStyle}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="PreviousPageButton" Content="上一页" Click="PreviousPage_Click" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}"/>
                                        <Button x:Name="NextPageButton" Content="下一页" Click="NextPage_Click" IsEnabled="False" Style="{StaticResource SecondaryButtonStyle}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- 右：详情 + 控制 -->
                        <Border x:Name="DetailCard" Grid.Column="1" Style="{StaticResource CardBorderStyle}" Padding="0" ui:HoverLift.Enabled="False">
                            <ContentControl HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" x:Name="DetailControlsHost">
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                    <StackPanel Spacing="12" Padding="16,14,16,16">
                                        <!-- 未选择占位 -->
                                        <StackPanel x:Name="DetailEmptyPanel" Spacing="14" Padding="16,40">
                                            <TextBlock Text="选择一个进程" Style="{StaticResource H2Style}"/>
                                            <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="从列表中选择目标，查看实际属性并调整运行方式。受保护的系统进程仅提供查看。"/>
                                        </StackPanel>
                                        <!-- 详情内容 -->
                                        <StackPanel x:Name="DetailPanel" Spacing="12" Visibility="Collapsed">
                                            <StackPanel Spacing="3">
                                                <TextBlock x:Name="DetailNameText" Style="{StaticResource H1Style}" TextTrimming="CharacterEllipsis"/>
                                                <Expander x:Name="DetailPathExpander" Header="可执行文件路径" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                    <TextBlock x:Name="DetailPathText" x:Load="False" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                                </Expander>
                                                <TextBlock x:Name="DetailMetaText" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <InfoBar x:Name="DetailIdentityWarning" IsOpen="False" Severity="Warning" IsClosable="False"/>
                                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                                                <StackPanel Spacing="8">
                                                    <TextBlock x:Name="SelectedExclusionStatusText" Text="正在读取排除状态…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Style="{StaticResource NoteStyle}"/>
                                                    <Button x:Name="ExcludeSelectedButton" Content="排除内存回收" Click="ExcludeSelected_Click" HorizontalAlignment="Stretch" Style="{StaticResource DangerButtonStyle}"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- 定时器精度请求忽略列表：让系统忽略该进程的定时器分辨率请求（Windows 11 起） -->
                                            <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                                                <StackPanel Spacing="8">
                                                    <TextBlock x:Name="TimerIgnoreListStatusText" Text="正在读取定时器忽略列表…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Style="{StaticResource NoteStyle}"/>
                                                    <Button x:Name="TimerIgnoreListButton" Content="加入定时器忽略列表" Click="TimerIgnoreList_Click" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"/>
                                                    <TextBlock Text="只忽略该进程自己的精度请求；系统、反作弊与本工具自身不允许。" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"/>
                                                </StackPanel>
                                            </Border>
                                            <!-- 能力面板 -->
                                            <Expander x:Name="CapabilityExpander" Header="当前属性与控制方" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <ItemsControl x:Name="CapabilityList" x:Load="False">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:CapabilityVm">
                                                            <Border Padding="0,7" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                                                <StackPanel Spacing="3">
                                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                                        <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource H3Style}"/>
                                                                        <Border Style="{StaticResource ChipBorderStyle}" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center" Visibility="{x:Bind ChipVisibility}">
                                                                            <TextBlock Text="{x:Bind ChipText}" Style="{StaticResource CaptionStyle}"/>
                                                                        </Border>
                                                                    </StackPanel>
                                                                    <TextBlock Text="{x:Bind ValueText}" IsTextSelectionEnabled="True" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                                                                    <TextBlock Text="{x:Bind ErrorText}" Foreground="{ThemeResource SystemFillColorCautionBrush}" TextWrapping="Wrap" Visibility="{x:Bind ErrorVisibility}" Style="{StaticResource CaptionStyle}"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                            <!-- 控制区 -->
                                            <StackPanel x:Name="ControlPanel" Spacing="10" Style="{StaticResource FeatureTilePanelStyle}" ui:HoverLift.Enabled="True">
                                                <TextBlock Text="属性设置" Style="{StaticResource H2Style}"/>
                                                <RadioButtons x:Name="ApplyScopePicker" Header="作用范围" SelectedIndex="0" MaxColumns="2" SelectionChanged="ApplyScopePicker_SelectionChanged">
                                                    <RadioButton Content="当前"/>
                                                    <RadioButton Content="总是"/>
                                                </RadioButtons>
                                                <TextBlock x:Name="ApplyScopeNote" Text="当前：只调整选中的本次进程，不新增或修改总是规则。" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                                                <CheckBox x:Name="AlwaysTakeoverCheck" Visibility="Collapsed">
                                                    <TextBlock Text="允许总是规则接管游戏模式控制的同一属性" TextWrapping="Wrap"/>
                                                </CheckBox>
                                                <Button Content="管理此应用的总是规则" Click="OpenSelectedRules_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"/>
                                                <TextBlock x:Name="SelectedAlwaysSummary" TextWrapping="Wrap" Foreground="{StaticResource AppAccentBrush}"/>
                                                <!-- CPU 优先级 -->
                                                <StackPanel Spacing="4">
                                                    <TextBlock Text="CPU 优先级" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <ComboBox x:Name="PriorityCombo" Width="180" SelectedIndex="2">
                                                            <ComboBoxItem Content="Idle（低）"/>
                                                            <ComboBoxItem Content="Below Normal"/>
                                                            <ComboBoxItem Content="Normal（默认）"/>
                                                            <ComboBoxItem Content="Above Normal"/>
                                                            <ComboBoxItem Content="High（高）"/>
                                                        </ComboBox>
                                                        <Button Content="应用" Click="ApplyPriority_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                                    </StackPanel>
                                                    <TextBlock TextWrapping="Wrap" Text="实时优先级不开放（自动策略与常规入口均禁用）。修改前会先记录原值，可随时还原。" Style="{StaticResource CaptionStyle}"/>
                                                </StackPanel>
                                                <!-- 亲和性/CPU 集合（按处理器组） -->
                                                <Expander Header="CPU 亲和性与 CPU 集合" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" x:Name="AffinityExpander">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="按 CPU 拓扑选择亲和性 / CPU 集合" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                                                        <StackPanel x:Name="AffinityGroupPanel" Spacing="4"/>
                                                        <Grid ColumnSpacing="8" RowSpacing="8">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Button Content="应用亲和性" Click="ApplyAffinity_Click" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"/>
                                                            <Button x:Name="ApplyCpuSetButton" Content="应用 CPU 集合" Click="ApplyCpuSet_Click" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"/>
                                                            <Button x:Name="ClearCpuSetButton" Content="清除 CPU 集合" Click="ClearCpuSet_Click" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Stretch" Style="{StaticResource SecondaryButtonStyle}"/>
                                                            <Button Content="解除亲和性限制" Click="ClearAffinity_Click" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Style="{StaticResource DangerButtonStyle}"/>
                                                        </Grid>
                                                        <TextBlock x:Name="TopologyNoteText" TextWrapping="Wrap" Text="正在读取进程管理独立 CPU 拓扑…" Style="{StaticResource CaptionStyle}"/>
                                                    </StackPanel>
                                                </Expander>
                                                <!-- 动态优先级提升 / 效率模式 -->
                                                <Expander Header="效率模式与动态优先级" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                    <StackPanel Spacing="14">
                                                        <StackPanel Spacing="4">
                                                            <ToggleSwitch x:Name="PriorityBoostToggle" Header="动态优先级提升" OnContent="启用" OffContent="禁用"/>
                                                            <TextBlock TextWrapping="Wrap" MaxWidth="220" Text="Windows API 为反向禁用参数，此处已按「是否启用」如实呈现。" Style="{StaticResource CaptionStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <ToggleSwitch x:Name="EcoQosToggle" Header="效率模式（EcoQoS）" OnContent="允许降速" OffContent="高性能"/>
                                                            <TextBlock TextWrapping="Wrap" MaxWidth="220" Text="仅在可读取原始状态时开放；设置与还原均回读核验。" Style="{StaticResource CaptionStyle}"/>
                                                        </StackPanel>
                                                        <Button Content="应用开关设置" Click="ApplyToggles_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                                    </StackPanel>
                                                </Expander>
                                                <!-- I/O 优先级 / GPU 首选项（P3） -->
                                                <Expander Header="I/O 与 GPU 首选项" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                    <StackPanel Spacing="14">
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="I/O 优先级" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <ComboBox x:Name="IoPriorityCombo" Width="160" SelectedIndex="2">
                                                                    <ComboBoxItem Content="VeryLow（后台）"/>
                                                                    <ComboBoxItem Content="Low"/>
                                                                    <ComboBoxItem Content="Normal（默认）"/>
                                                                    <ComboBoxItem Content="High"/>
                                                                </ComboBox>
                                                                <Button Content="应用" Click="ApplyIoPriority_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                                            </StackPanel>
                                                            <TextBlock TextWrapping="Wrap" MaxWidth="220" Text="Native 兼容层（ntdll）；Critical 为系统保留不开放。" Style="{StaticResource CaptionStyle}"/>
                                                        </StackPanel>
                                                        <StackPanel Spacing="4">
                                                            <TextBlock Text="GPU 首选项（按应用）" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <ComboBox x:Name="GpuPreferenceCombo" Width="160" SelectedIndex="0">
                                                                    <ComboBoxItem Content="Windows 默认"/>
                                                                    <ComboBoxItem Content="省电"/>
                                                                    <ComboBoxItem Content="高性能"/>
                                                                </ComboBox>
                                                                <Button Content="应用" Click="ApplyGpuPreference_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                                            </StackPanel>
                                                            <TextBlock TextWrapping="Wrap" Text="GPU 首选项由 Windows 按应用保存，不受“当前 / 总是”选择影响；生效可能需要重启目标程序。" Style="{StaticResource CaptionStyle}"/>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander>
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button x:Name="ResetSelectedButton" Content="还原当前进程修改" Click="ResetAll_Click" Style="{StaticResource DangerButtonStyle}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <!-- 持有记录 -->
                                            <Expander Header="内存与 GPU 调度" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                                <StackPanel x:Name="AdditionalControlPanel" Spacing="8">
                                                    <ComboBox x:Name="MemoryPriorityCombo" Header="内存优先级" SelectedIndex="4" HorizontalAlignment="Stretch">
                                                        <ComboBoxItem Content="很低"/>
                                                        <ComboBoxItem Content="低"/>
                                                        <ComboBoxItem Content="中等"/>
                                                        <ComboBoxItem Content="低于正常"/>
                                                        <ComboBoxItem Content="正常（最高可用）"/>
                                                    </ComboBox>
                                                    <Button Content="应用内存优先级" Click="ApplyMemoryPriority_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                                    <ComboBox x:Name="GpuPriorityCombo" Header="GPU 调度优先级（以驱动支持为准）" SelectedIndex="2">
                                                        <ComboBoxItem Content="Idle"/>
                                                        <ComboBoxItem Content="BelowNormal"/>
                                                        <ComboBoxItem Content="Normal"/>
                                                        <ComboBoxItem Content="AboveNormal"/>
                                                        <ComboBoxItem Content="High"/>
                                                    </ComboBox>
                                                    <Button Content="应用 GPU 调度优先级" Click="ApplyGpuPriority_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                                </StackPanel>
                                            </Expander>
                                            <StackPanel x:Name="HeldPanel" Spacing="6" Visibility="Collapsed">
                                                <TextBlock Text="本工具持有的修改记录" Style="{StaticResource H2Style}"/>
                                                <ItemsControl x:Name="HeldList">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:HeldChangeVm">
                                                            <TextBlock TextWrapping="Wrap" Padding="0,2" Text="{x:Bind DisplayText}" Style="{StaticResource NoteStyle}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                            <!-- 操作反馈 -->
                                            <!-- 核对/恢复 -->
                                            <StackPanel Spacing="8" Style="{StaticResource FeatureTilePanelStyle}" ui:HoverLift.Enabled="True">
                                                <TextBlock Text="核对与恢复" Style="{StaticResource H2Style}"/>
                                                <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="「核对」逐条比对记录与当前实际值（只读）；外部已修改的记录会以冲突保留，绝不盲目覆盖。「全部还原」用于退出前收尾。"/>
                                                <StackPanel Orientation="Horizontal" Spacing="8" Style="{StaticResource FeatureTilePanelStyle}" ui:HoverLift.Enabled="True">
                                                    <Button Content="核对记录" Click="Reconcile_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                                    <Button Content="全部还原" Click="RestoreAll_Click" Style="{StaticResource DangerButtonStyle}"/>
                                                </StackPanel>
                                                <TextBlock x:Name="ReconcileText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </ContentControl>
                        </Border>
                    </Grid>
                </ContentControl>
            </TabViewItem>
            <TabViewItem x:Name="RulesTab" Header="总是规则" IsClosable="False">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl x:Name="GenericRulesWorkspaceHost" HorizontalContentAlignment="Stretch">
                        <Border x:Name="RulesWorkspace" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0">
                            <StackPanel Spacing="16">
                                <TextBlock x:Name="RulesWorkspaceTitle" Text="总是规则" Style="{StaticResource H2Style}"/>
                                <StackPanel x:Name="GenericRuleTargetPanel" Spacing="12">
                                    <TextBox x:Name="StandaloneRulePathBox" Header="应用完整 EXE 路径" PlaceholderText="可粘贴当前未运行的应用路径" MaxLength="32760"/>
                                    <Button Content="创建此应用的规则" Click="SetStandaloneRuleTarget_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                                <StackPanel Spacing="12" Visibility="Collapsed" x:Name="SavedRuleEditor">
                                    <Border Background="{ThemeResource ControlFillColorDefaultBrush}" CornerRadius="8" Padding="12">
                                        <StackPanel Spacing="4">
                                            <TextBlock x:Name="RuleTargetNameText" Text="尚未选择目标进程" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="RuleTargetPathText" Text="选择进程后即可创建规则。" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource NoteStyle}"/>
                                        </StackPanel>
                                    </Border>
                                    <ContentControl x:Name="RuleEditorHost" HorizontalContentAlignment="Stretch">
                                        <StackPanel x:Name="RuleEditorPanel" Spacing="12">
                                            <ComboBox x:Name="RuleCapabilityCombo" Header="能力" SelectedIndex="0" MinWidth="180" SelectionChanged="RuleCapabilityCombo_SelectionChanged" HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="CPU 优先级"/>
                                                <ComboBoxItem Content="效率模式（EcoQoS）"/>
                                                <ComboBoxItem Content="动态优先级提升"/>
                                                <ComboBoxItem Content="CPU 亲和性（g0:0x掩码）"/>
                                                <ComboBoxItem Content="CPU 集合（按组掩码）"/>
                                                <ComboBoxItem Content="I/O 优先级（Low/Normal 等）"/>
                                                <ComboBoxItem Content="内存优先级"/>
                                                <ComboBoxItem Content="GPU 调度优先级（0–4）"/>
                                            </ComboBox>
                                            <ComboBox x:Name="RuleValueCombo" Header="应用的设置" HorizontalAlignment="Stretch"/>
                                            <StackPanel x:Name="RuleMaskPanel" Spacing="8" Visibility="Collapsed">
                                                <TextBlock Text="直接选择本机逻辑 CPU，无需启动目标进程；也可手动编辑处理器组掩码。" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                                                <StackPanel x:Name="RuleCpuGroupPanel" Spacing="12"/>
                                                <Button Content="使用所选 CPU" Click="UseRuleCpus_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"/>
                                                <TextBox x:Name="RuleValueBox" Header="处理器组掩码" PlaceholderText="例：g0:0xF" MaxLength="512"/>
                                            </StackPanel>
                                            <ToggleSwitch x:Name="RuleEnabledToggle" Header="启用规则" OnContent="启用" OffContent="停用" IsOn="True"/>
                                            <CheckBox x:Name="RuleAutoTakeoverCheck" Content="允许规则接管游戏模式控制的同一属性"/>
                                        </StackPanel>
                                    </ContentControl>
                                    <Button x:Name="SaveRuleButton" Content="保存规则" Click="SaveRule_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                                </StackPanel>
                                <StackPanel Orientation="Vertical" Spacing="10">
                                    <TextBlock Text="已保存规则" Style="{StaticResource H2Style}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="在此独立创建、编辑和删除持久规则，支持当前未运行的应用。进程属性中的“总是”仍可作为快捷设置。"/>
                                <TextBlock FontWeight="SemiBold" Text="尚未读取规则" x:Name="RuleCountText" TextWrapping="Wrap"/>
                                <Button Content="刷新" Click="LoadRules_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                <StackPanel x:Name="RuleListPanel" Spacing="3"/>
                                <TextBlock x:Name="RuleNoteText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                            </StackPanel>
                        </Border>
                    </ContentControl>
                </ScrollViewer>
            </TabViewItem>
            <TabViewItem x:Name="BackgroundTab" Header="后台保护与回收" IsClosable="False">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Padding="0" ui:HoverLift.Enabled="False">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ContentControl x:Name="BackgroundSettingsPanel" HorizontalContentAlignment="Stretch">
                            <StackPanel Spacing="16" Padding="24" MaxWidth="760" HorizontalAlignment="Left">
                                <StackPanel Orientation="Vertical" Spacing="10">
                                    <TextBlock Text="后台保护与手动回收" Style="{StaticResource H2Style}" VerticalAlignment="Center" ui:HelpTip.Text="请先在帧格页选择自动内存回收，再开启“一键帧格模式”。本页只调整具体参数、排除名单和手动回收；保存参数不会独立开启后台功能。"/>
                                </StackPanel>
                                <Button Content="前往帧格开启后台功能" Click="OpenFrameBackground_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"/>
                                <TextBlock x:Name="MemoryParametersTitle" Text="内存回收参数" Style="{StaticResource H3Style}" ui:HelpTip.Text="自动回收需内存持续高压至少 30 秒，并满足用户设置的清理间隔。无明显效果或快速回涨不再额外延长至 20–30 分钟；紧急策略仍可能提高最短间隔。"/>
                                <NumberBox x:Name="MemoryPressureBox" Header="自动回收的系统内存占用阈值（%）" Value="85" Minimum="30" Maximum="95" SpinButtonPlacementMode="Compact"/>
                                <TextBlock Text="可设置范围：30–95%。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                                <ComboBox x:Name="MemoryModeCombo" SelectedIndex="0" SelectionChanged="MemoryMode_SelectionChanged" HorizontalAlignment="Stretch">
                                    <ComboBox.Header>
                                        <TextBlock x:Name="MemoryModeHelpTitle" Text="内存回收模式" ui:HelpTip.Text="选择普通、激进或稳洲回收模式，点击说明查看各模式的保护范围。"/>
                                    </ComboBox.Header>
                                    <ComboBoxItem Content="普通回收模式"/>
                                    <ComboBoxItem Content="激进回收模式"/>
                                    <ComboBoxItem Content="稳洲回收模式"/>
                                </ComboBox>
                                <NumberBox x:Name="MemoryBatchLimitBox" Header="单次内存回收进程数（手动 / 自动）" Value="5" Minimum="1" Maximum="256" SmallChange="1" SpinButtonPlacementMode="Compact"/>
                                <NumberBox x:Name="MemoryCooldownBox" Header="内存回收最短间隔（分钟）" Value="10" Minimum="1" Maximum="1440" SmallChange="1" SpinButtonPlacementMode="Compact"/>
                                <TextBlock x:Name="MemoryCooldownPolicyText" Text="可设置范围：1–1440 分钟。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                                <TextBlock x:Name="MemoryBatchPolicyText" Text="可设置范围：1–256 个进程。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                                <Button Content="保存后台参数" Click="SaveBackgroundParameters_Click" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                                    <StackPanel Spacing="12" Style="{StaticResource FeatureTilePanelStyle}" ui:HoverLift.Enabled="True">
                                        <TextBlock Text="手动内存回收" TextWrapping="Wrap" Style="{StaticResource H2Style}" ui:HelpTip.Text="预览并选择后台应用回收工作集，不结束进程。三角洲、工具、系统、前台应用和排除名单中的应用仍受保护；自动回收请在帧格页开启。"/>
                                        <TextBlock Text="预览后选择后台应用回收工作集，不结束进程。" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                                        <StackPanel x:Name="MemoryPrelaunchPanel" Visibility="Collapsed" Spacing="8">
                                            <ToggleSwitch x:Name="MemoryPrelaunchToggle" Header="关闭预启动" OnContent="已关闭" OffContent="尚未全部关闭" IsEnabled="False" Toggled="MemoryPrelaunchToggle_Toggled"/>
                                            <TextBlock Style="{StaticResource WarningTextStyle}" Text="与系统优化页的预读取设置同步，修改前自动备份；部分设置需重启生效。" TextWrapping="Wrap"/>
                                            <TextBlock x:Name="MemoryPrelaunchStatusText" Style="{StaticResource CaptionStyle}" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
                                            <Button x:Name="MemoryPrelaunchRefreshButton" Content="重新检测预启动" Click="MemoryPrelaunchRefresh_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                        </StackPanel>
                                        <Button Content="刷新后台状态" Click="RefreshBackground_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                        <TextBlock x:Name="AutomaticMemoryStatusText" Text="正在读取设置…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" Style="{StaticResource NoteStyle}"/>
                                        <Button x:Name="MemoryPreviewButton" Content="预览可回收进程" Click="PreviewMemory_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                        <TextBlock x:Name="MemoryTrimStatusText" Visibility="Collapsed" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite" Style="{StaticResource NoteStyle}"/>
                                    </StackPanel>
                                </Border>
                                <Border BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,18,0,0">
                                    <StackPanel Spacing="12" Style="{StaticResource FeatureTilePanelStyle}" ui:HoverLift.Enabled="True">
                                        <TextBlock Text="内存回收排除名单" Style="{StaticResource H2Style}" ui:HelpTip.Text="名单内的应用免于普通模式的内存回收，按完整程序路径匹配，重启后保留。在“进程与属性”中选择应用即可加入；也可粘贴完整 EXE 路径，排除当前未运行的应用。"/>
                                        <TextBox x:Name="BackgroundExcludePathBox" Header="程序完整路径" PlaceholderText="C:\Apps\Example.exe" MaxLength="32760"/>
                                        <Button Content="添加排除" Click="AddExclusion_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                        <StackPanel x:Name="BackgroundExclusionsPanel" Spacing="8"/>
                                        <TextBlock x:Name="BackgroundConfigNoteText" Style="{StaticResource CaptionStyle}" AutomationProperties.LiveSetting="Polite"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ContentControl>
                    </ScrollViewer>
                </Border>
            </TabViewItem>
        </TabView>
        <InfoBar x:Name="OperationResultBar" IsOpen="False" IsClosable="True" Grid.Row="2"/>
    </Grid>
</Page>
