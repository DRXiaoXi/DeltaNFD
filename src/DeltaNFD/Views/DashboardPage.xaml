<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:DeltaNFD.ViewModels" x:Class="DeltaNFD.Views.DashboardPage">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="HomeBrandTextBrush" Color="White"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HomeBrandTextBrush" Color="White"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="HomeBrandTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <Grid x:Name="DashboardLayoutRoot">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Compact">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DashboardPrimaryColumn.Width" Value="*"/>
                        <Setter Target="DashboardSecondaryColumn.Width" Value="0"/>
                        <Setter Target="FramePanel.(Grid.Column)" Value="0"/>
                        <Setter Target="FramePanel.(Grid.Row)" Value="1"/>
                        <Setter Target="HealthTile.(Grid.Row)" Value="2"/>
                        <Setter Target="HealthTile.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="ComponentPanel.(Grid.Row)" Value="3"/>
                        <Setter Target="ComponentPanel.(Grid.ColumnSpan)" Value="1"/>
                        <Setter Target="DashboardTileGrid.ColumnSpacing" Value="0"/>
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="1250"/>
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="DashboardPrimaryColumn.Width" Value="3*"/>
                        <Setter Target="DashboardSecondaryColumn.Width" Value="2*"/>
                        <Setter Target="FramePanel.(Grid.Column)" Value="1"/>
                        <Setter Target="FramePanel.(Grid.Row)" Value="0"/>
                        <Setter Target="HealthTile.(Grid.Row)" Value="1"/>
                        <Setter Target="HealthTile.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="ComponentPanel.(Grid.Row)" Value="2"/>
                        <Setter Target="ComponentPanel.(Grid.ColumnSpan)" Value="2"/>
                        <Setter Target="DashboardTileGrid.ColumnSpacing" Value="16"/>
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
            <StackPanel MaxWidth="1200" Padding="24,20,24,28" Spacing="16">
                <TextBlock Text="主页" Style="{StaticResource PageTitleStyle}"/>
                <InfoBar x:Name="TimerWarning" IsOpen="True" IsClosable="False" Severity="Informational" Title="正在检测 HPET 与启动计时器选项">
                    <InfoBar.ActionButton><Button Content="查看并恢复" Click="TimerRecovery_Click"/></InfoBar.ActionButton>
                </InfoBar>
                <InfoBar IsOpen="{x:Bind ViewModel.IsLimitedTestBuild}" IsClosable="False" Severity="Informational" Title="更新测试版" Message="运行库功能将在 Alpha0.9194 完整版开放，请到设置中检查更新。"/>
                <Grid ColumnSpacing="16" RowSpacing="16" x:Name="DashboardTileGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" x:Name="DashboardPrimaryColumn"/>
                        <ColumnDefinition Width="0" x:Name="DashboardSecondaryColumn"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="BrandPanel" Background="{ThemeResource HomeBrandBrush}" CornerRadius="14" Padding="24" MinHeight="220" Style="{StaticResource DashboardTileStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="18" VerticalAlignment="Center">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Image Source="ms-appx:///Assets/DeltaNFD.png" Width="48" Height="48" Stretch="Uniform" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw"/>
                                    <TextBlock Grid.Column="1" Text="三角帧不掉洲" FontSize="28" FontWeight="Bold" TextWrapping="Wrap" Foreground="{ThemeResource HomeBrandTextBrush}" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Spacing="6">
                                    <TextBlock Text="当前游戏目标" FontSize="12" Foreground="{ThemeResource HomeBrandTextBrush}"/>
                                    <TextBlock Text="{x:Bind ViewModel.TargetName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource HomeBrandTextBrush}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind ViewModel.TargetPathText, Mode=OneWay}"/>
                                    <TextBlock Text="{x:Bind ViewModel.TargetModeText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource HomeBrandTextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Tag="settings" Click="JumpButton_Click" VerticalAlignment="Top" Padding="8" Background="Transparent" Foreground="{ThemeResource HomeBrandTextBrush}" ToolTipService.ToolTip="游戏目标设置" AutomationProperties.Name="游戏目标设置">
                                <SymbolIcon Symbol="Setting"/>
                            </Button>
                        </Grid>
                    </Border>
                    <Border x:Name="FramePanel" Style="{StaticResource DashboardFrameTileStyle}" MinHeight="220" Grid.Row="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border Width="46" Height="46" CornerRadius="8" Background="{StaticResource AppAccentSoftBrush}" Grid.Row="0" HorizontalAlignment="Left">
                                <FontIcon Glyph="" FontSize="22" Foreground="{StaticResource AppAccentBrush}"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" Spacing="4" Grid.Row="1" Margin="0,12,0,16">
                                <TextBlock Text="一键帧格模式" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind ViewModel.Frame.StatusText, Mode=OneWay}" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent="" AutomationProperties.Name="一键帧格模式" IsOn="{x:Bind ViewModel.Frame.FrameModeEnabled, Mode=OneWay}" Toggled="FrameModeToggle_Toggled" Grid.Row="2" HorizontalAlignment="Left"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource DashboardTileStyle}" x:Name="HealthTile" Grid.Row="2">
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="12" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock Text="组件检测状态" Style="{StaticResource SectionTitleStyle}"/>
                                    <TextBlock Text="{x:Bind ViewModel.HealthSummary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                                <ProgressRing Grid.Column="1" Width="18" Height="18" IsActive="{x:Bind ViewModel.IsHealthScanning, Mode=OneWay}"/>
                                <Button Grid.Column="2" Click="RefreshHealthButton_Click" VerticalAlignment="Center" Padding="8" IsEnabled="{x:Bind ViewModel.CanRefreshHealth, Mode=OneWay}" ToolTipService.ToolTip="重新检测组件" AutomationProperties.Name="重新检测组件">
                                    <SymbolIcon Symbol="Refresh"/>
                                </Button>
                            </Grid>
                            <Grid ColumnSpacing="10" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind StatusBrush(ViewModel.ShaderHealthState), Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Text="着色器" Width="64" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ShaderStatusText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{x:Bind StatusBrush(ViewModel.ShaderHealthState), Mode=OneWay}" FontWeight="{x:Bind WeightFor(ViewModel.ShaderHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Click="ShaderAction_Click" Content="{x:Bind ViewModel.ShaderActionText, Mode=OneWay}" Padding="12,5" Visibility="{x:Bind ActionVisibility(ViewModel.ShaderHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="10" Padding="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind StatusBrush(ViewModel.AceHealthState), Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Text="ACE" Width="64" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.AceStatusText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{x:Bind StatusBrush(ViewModel.AceHealthState), Mode=OneWay}" FontWeight="{x:Bind WeightFor(ViewModel.AceHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Tag="ace" Click="JumpButton_Click" Content="去处理" Padding="12,5" Visibility="{x:Bind ActionVisibility(ViewModel.AceHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnSpacing="10" Padding="0,6" Visibility="{x:Bind RuntimeFeatureVisibility}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind StatusBrush(ViewModel.RuntimeHealthState), Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Text="运行库" Width="80" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RuntimeStatusText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{x:Bind StatusBrush(ViewModel.RuntimeHealthState), Mode=OneWay}" FontWeight="{x:Bind WeightFor(ViewModel.RuntimeHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Tag="runtime" Click="JumpButton_Click" Content="{x:Bind ViewModel.RuntimeActionText, Mode=OneWay}" Padding="12,5" Visibility="{x:Bind ActionVisibility(ViewModel.RuntimeHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid x:Name="MemoryHealthRow" ColumnSpacing="10" Padding="0,6" ToolTipService.ToolTip="内存冗余按系统可用物理内存计算（1 GB = 1024³ 字节）。仅检测，不执行回收。">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind StatusBrush(ViewModel.MemoryHealthState), Mode=OneWay}"/>
                                <TextBlock Grid.Column="1" Text="内存" Width="64" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.MemoryStatusText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{x:Bind StatusBrush(ViewModel.MemoryHealthState), Mode=OneWay}" FontWeight="{x:Bind WeightFor(ViewModel.MemoryHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                            </Grid>
                            <StackPanel Spacing="6" Margin="18,0,0,8" Visibility="{x:Bind ViewModel.MemoryRecoverySuggested, Mode=OneWay}">
                                <TextBlock Text="可用内存不足，建议同时开启「自动内存回收」和「一键帧格模式」，让内存回收随帧格运行。" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                                <Button Click="MemoryRecoveryButton_Click" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left">
                                    <TextBlock Text="设置内存回收与帧格" TextWrapping="Wrap"/>
                                </Button>
                            </StackPanel>
                            <TextBlock Text="{x:Bind ViewModel.LastHealthCheckText, Mode=OneWay}" FontSize="12" Margin="0,6,0,0" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ComponentPanel" Style="{StaticResource DashboardTileStyle}" Grid.Row="3">
                        <StackPanel Spacing="4">
                            <TextBlock Text="优化项目预读" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.ScanProgressText, Mode=OneWay}" TextWrapping="Wrap"/>
                            <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Maximum="100" Height="3"/>
                            <TextBlock Text="{x:Bind ViewModel.ScanCompletedText, Mode=OneWay}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
