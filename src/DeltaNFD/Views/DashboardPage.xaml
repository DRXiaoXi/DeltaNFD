<Page
    x:Class="DeltaNFD.Views.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DeltaNFD.ViewModels">
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="HomeBrandTextBrush" Color="White"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="HomeBrandTextBrush" Color="White"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="HomeBrandTextBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled">
        <StackPanel MaxWidth="1080" Padding="28,20,28,32" Spacing="16">
            <TextBlock Text="主页" Style="{StaticResource PageTitleStyle}"/>
            <Border x:Name="BrandPanel" Background="{ThemeResource HomeBrandBrush}" CornerRadius="8" Padding="28" MinHeight="220">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Spacing="18" VerticalAlignment="Center">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Image Source="ms-appx:///Assets/DeltaNFD.png" Width="48" Height="48" Stretch="Uniform" VerticalAlignment="Center"
                                   AutomationProperties.AccessibilityView="Raw"/>
                            <TextBlock Grid.Column="1" Text="三角帧不掉洲" FontSize="28" FontWeight="Bold" TextWrapping="Wrap"
                                       Foreground="{ThemeResource HomeBrandTextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Spacing="6">
                            <TextBlock Text="当前游戏目标" FontSize="12" Foreground="{ThemeResource HomeBrandTextBrush}"/>
                            <TextBlock Text="{x:Bind ViewModel.TargetName, Mode=OneWay}" FontSize="16" FontWeight="SemiBold"
                                       Foreground="{ThemeResource HomeBrandTextBrush}" TextWrapping="Wrap"
                                       ToolTipService.ToolTip="{x:Bind ViewModel.TargetPathText, Mode=OneWay}"/>
                            <TextBlock Text="{x:Bind ViewModel.TargetModeText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource HomeBrandTextBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Tag="settings" Click="JumpButton_Click" VerticalAlignment="Top" Padding="8"
                            Background="Transparent" Foreground="{ThemeResource HomeBrandTextBrush}"
                            ToolTipService.ToolTip="游戏目标设置" AutomationProperties.Name="游戏目标设置">
                        <SymbolIcon Symbol="Setting"/>
                    </Button>
                </Grid>
            </Border>

            <Border x:Name="FramePanel" Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="46" Height="46" CornerRadius="8" Background="{StaticResource AppAccentSoftBrush}">
                        <FontIcon Glyph="&#xE9D9;" FontSize="22" Foreground="{StaticResource AppAccentBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="一键帧格模式" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.Frame.StatusText, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center" MinWidth="0" OnContent="" OffContent=""
                                  AutomationProperties.Name="一键帧格模式"
                                  IsOn="{x:Bind ViewModel.Frame.FrameModeEnabled, Mode=OneWay}" Toggled="FrameModeToggle_Toggled"/>
                </Grid>
            </Border>

            <Border x:Name="ComponentPanel" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <Grid ColumnSpacing="12" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="组件检测状态" Style="{StaticResource SectionTitleStyle}"/>
                            <TextBlock Text="{x:Bind ViewModel.HealthSummary, Mode=OneWay}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                        <ProgressRing Grid.Column="1" Width="18" Height="18" IsActive="{x:Bind ViewModel.IsHealthScanning, Mode=OneWay}"/>
                        <Button Grid.Column="2" Click="RefreshHealthButton_Click" VerticalAlignment="Center" Padding="8"
                                IsEnabled="{x:Bind ViewModel.CanRefreshHealth, Mode=OneWay}"
                                ToolTipService.ToolTip="重新检测组件" AutomationProperties.Name="重新检测组件">
                            <SymbolIcon Symbol="Refresh"/>
                        </Button>
                    </Grid>

                    <Grid ColumnSpacing="10" Padding="0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind StatusBrush(ViewModel.ShaderHealthState), Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" Text="着色器" Width="64" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ShaderStatusText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{x:Bind StatusBrush(ViewModel.ShaderHealthState), Mode=OneWay}"
                                   FontWeight="{x:Bind WeightFor(ViewModel.ShaderHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Tag="shader" Click="JumpButton_Click" Content="去处理" Padding="12,5"
                                Visibility="{x:Bind ActionVisibility(ViewModel.ShaderHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnSpacing="10" Padding="0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind StatusBrush(ViewModel.AceHealthState), Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" Text="ACE" Width="64" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.AceStatusText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{x:Bind StatusBrush(ViewModel.AceHealthState), Mode=OneWay}"
                                   FontWeight="{x:Bind WeightFor(ViewModel.AceHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Tag="ace" Click="JumpButton_Click" Content="去处理" Padding="12,5"
                                Visibility="{x:Bind ActionVisibility(ViewModel.AceHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid ColumnSpacing="10" Padding="0,6">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{x:Bind StatusBrush(ViewModel.RuntimeHealthState), Mode=OneWay}"/>
                        <TextBlock Grid.Column="1" Text="运行库" Width="64" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.RuntimeStatusText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                   Foreground="{x:Bind StatusBrush(ViewModel.RuntimeHealthState), Mode=OneWay}"
                                   FontWeight="{x:Bind WeightFor(ViewModel.RuntimeHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Tag="runtime" Click="JumpButton_Click" Content="去处理" Padding="12,5"
                                Visibility="{x:Bind ActionVisibility(ViewModel.RuntimeHealthState), Mode=OneWay}" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.LastHealthCheckText, Mode=OneWay}" FontSize="11" Margin="0,6,0,0"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
