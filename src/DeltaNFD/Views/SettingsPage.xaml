<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:DeltaNFD.Controls" xmlns:local="using:DeltaNFD.Views" x:Class="DeltaNFD.Views.SettingsPage">
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1440" Padding="28,20,28,32" Spacing="12">
            <StackPanel Spacing="4">
                <ui:PageHeader Title="设置"/>
                <TextBlock Text="外观与常规选项" Style="{StaticResource NoteStyle}"/>
            </StackPanel>
            <!-- 外观 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <ToggleSwitch x:Name="CustomGameModeToggle" Header="不玩三角洲辣" Toggled="CustomGameMode_Toggled"/>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="TargetFileNameText" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock x:Name="TargetFilePathText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button x:Name="SelectGameExeButton" Grid.Column="1" Click="SelectGameExe_Click" VerticalAlignment="Top" ToolTipService.ToolTip="选择主进程 EXE" Style="{StaticResource SecondaryButtonStyle}">
                            <FontIcon Glyph=""/>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="TargetModeStatusText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" ui:HoverLift.Enabled="False">
                <StackPanel Spacing="4">
                    <TextBlock Text="外观" Style="{StaticResource H2Style}" Margin="0,0,0,8"/>
                    <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="应用主题" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="切换界面明暗主题" Style="{StaticResource NoteStyle}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="150" VerticalAlignment="Center" ItemsSource="{x:Bind ThemeOptions}" IsEnabled="{x:Bind ViewModel.ThemeSelectionEnabled, Mode=OneWay}" SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}"/>
                    </Grid>
                    <!-- 背景图片模式（总开关；开启时界面锁定深色主题） -->
                    <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="背景图片模式" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="开启：显示背景图（自定义或内置）；关闭：使用系统 Mica 云母背景。开启背景图片模式期间，界面主题锁定为深色（背景图按深色调设计），浅色/深色选择暂不可用。"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.BackgroundImageEnabled, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 主题色（自由切换工具强调色） -->
                    <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="主题色" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="自由切换工具强调色（按钮 / 开关 / 主页横幅等），立即生效并保存" Style="{StaticResource NoteStyle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ItemsControl x:Name="AccentSwatchList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AccentOption">
                                        <Button Click="AccentSwatch_Click" Tag="{x:Bind Hex}" Padding="0" MinWidth="34" MinHeight="26" CornerRadius="7" BorderThickness="0" VerticalAlignment="Center" ToolTipService.ToolTip="{x:Bind Name}">
                                            <Grid>
                                                <Border Width="28" Height="18" CornerRadius="5">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{x:Bind Color}"/>
                                                    </Border.Background>
                                                </Border>
                                                <FontIcon Glyph="" FontSize="11" Foreground="White" Visibility="{x:Bind IsSelected}"/>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="自定义…" Click="CustomAccentButton_Click" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="自定义背景图片" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="选择 PNG / JPG / WebP 图片作为全局背景（覆盖整个窗口，立即生效并持久保存）" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Content="选择图片" Click="PickBackgroundButton_Click" IsEnabled="{x:Bind ViewModel.BackgroundImageEnabled, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="恢复默认" Click="ResetBackgroundButton_Click" IsEnabled="{x:Bind ViewModel.BackgroundImageEnabled, Mode=OneWay}" Style="{StaticResource DangerButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="背景遮罩浓度" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="背景图上的暗色遮罩：越暗文字越清晰，越透背景越明显" Style="{StaticResource NoteStyle}"/>
                        </StackPanel>
                        <Slider Grid.Column="1" MinWidth="180" VerticalAlignment="Center" Minimum="0" Maximum="95" StepFrequency="5" x:Name="DimSlider" IsEnabled="{x:Bind ViewModel.BackgroundImageEnabled, Mode=OneWay}" ValueChanged="DimSlider_ValueChanged"/>
                    </Grid>
                    <TextBlock x:Name="BackgroundStatusText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Margin="0,2,0,6"/>
                </StackPanel>
            </Border>
            <!-- 常规 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="未确认的后端操作" Style="{StaticResource H2Style}"/>
                    <TextBlock Text="超时或断线不代表操作已恢复。请先确认相关程序已结束，并核对系统状态；证据会保留。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                    <Button Content="核对未确认操作" Click="ReviewBackendOperations_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}" ui:HoverLift.Enabled="False">
                <StackPanel Spacing="4">
                    <TextBlock Text="常规" Style="{StaticResource H2Style}" Margin="0,0,0,8"/>
                    <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="开机自动启动" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="登录 Windows 后自动运行（计划任务，不弹 UAC）" Style="{StaticResource NoteStyle}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChangeAutoStart, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="自启动时静默运行" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="登录后仅显示托盘图标，不弹出主窗口；点击托盘或手动打开可显示窗口。需先开启开机自动启动。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.SilentStartup, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.CanChangeSilentStartup, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="自启动时静默运行"/>
                    </Grid>
                    <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="关闭时最小化到托盘" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="开启后关闭窗口将驻留托盘；未开启时，若帧格或 CPU 调度正在运行，关闭窗口会提示是否开启后台运行。" Style="{StaticResource NoteStyle}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}" IsEnabled="{x:Bind ViewModel.NormalAutomationSettingsEnabled, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 运行日志（排障用） -->
                    <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="运行日志" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="记录启动环境、页面导航与全部系统操作的执行结果与异常（%APPDATA%\Delta NFD\logs）。在其他电脑上出问题时，把对应时间的日志文件发回来即可定位。每次启动一个文件，自动保留 14 天。"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开日志文件夹" Click="OpenLogFolderButton_Click" VerticalAlignment="Center" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.GeneralStatusText, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="问题反馈" Style="{StaticResource H2Style}"/>
                    <TextBlock Text="填写问题所在模块和复现步骤，可附带最近应用日志。无需登录，预览并确认后才发送至作者服务器。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="BugFeedbackButton" Content="反馈 BUG" Click="SendBugFeedback_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="RetryFeedbackButton" Content="重试上次反馈" Click="RetryBugFeedback_Click" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="CancelFeedbackButton" Content="取消发送" Click="CancelBugFeedback_Click" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}"/>
                        <ProgressRing x:Name="FeedbackProgressRing" Width="22" Height="22" IsActive="False"/>
                    </StackPanel>
                    <TextBlock x:Name="FeedbackStatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
                    <InfoBar x:Name="FeedbackResultBar" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Assertive"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="恢复出厂设置" Style="{StaticResource H2Style}"/>
                    <TextBlock Text="用于清理新旧配置冲突：备份当前配置，停止并恢复工具的临时修改，将外观、游戏目录、自动功能、进程规则和后台参数重置为默认值。完成后关闭并重新打开工具。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                    <TextBlock Text="系统优化的原值备份、日志和插件文件保留；已应用的系统优化不会在此重置，仍可在对应页面按备份还原。未完成的操作必须先核对，不能靠清空记录跳过恢复。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                    <Button x:Name="FactoryResetButton" Content="一键恢复出厂设置" Click="FactoryReset_Click" HorizontalAlignment="Left" Style="{StaticResource DangerButtonStyle}"/>
                    <TextBlock x:Name="FactoryResetStatusText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <!-- Recovery only: shown solely for existing records from retired versions. -->
            <Border x:Name="LegacyRecoveryCard" Style="{StaticResource CardBorderStyle}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <TextBlock Text="旧版设置待恢复" Style="{StaticResource H2Style}"/>
                    <TextBlock x:Name="LegacyRecoveryStatusText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <Button x:Name="LegacyRecoveryButton" Content="恢复旧版遗留设置" Click="LegacyRecoveryButton_Click" Style="{StaticResource DangerButtonStyle}"/>
                </StackPanel>
            </Border>
            <!-- 三角洲目录识别（支持多安装） -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="三角洲安装目录" Style="{StaticResource H2Style}"/>
                    <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="登记本机所有三角洲安装目录；着色器清理、ACE 清理、运行库防护、全屏优化等功能会对每个登记目录同时生效。未登记的目录仍会被 WeGame 注册表和常见路径自动识别。"/>
                    <ListView x:Name="GameRootsList" MaxHeight="220" SelectionMode="None"/>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GamePathBox" VerticalAlignment="Center" PlaceholderText="手动粘贴安装目录后点添加，或用下方搜索"/>
                        <Button x:Name="PickGameFolderButton" Grid.Column="1" Content="浏览" Click="PickGameFolderButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="AddGamePathButton" Grid.Column="2" Content="添加" Style="{StaticResource PrimaryButtonStyle}" Click="AddGamePathButton_Click"/>
                        <Button x:Name="SearchGameFoldersButton" Grid.Column="3" Content="搜索添加" Click="SearchGameFoldersButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="FullScanGameFoldersButton" Content="全盘搜索" Click="FullScanGameFoldersButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="ScopedScanGameFoldersButton" Content="指定目录搜索" Click="ScopedScanGameFoldersButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="ClearGamePathButton" Content="清除旧手动指定" Click="ClearGamePathButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="GamePathStatusText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <!-- 三角帧本体设置 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="三角帧本体设置" Style="{StaticResource H2Style}"/>
                    <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="针对游戏主程序（DeltaForceClient-Win64-Shipping.exe）的兼容性调整，直接写入用户级注册表，无需重启电脑，下次启动游戏生效。"/>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="禁用全屏优化" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="禁用游戏的全屏优化（Fullscreen Optimizations），可降低全屏模式下的输入延迟与帧生成波动。开启后写入注册表兼容性标记，关闭时恢复原值。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="FsoDisableToggle" Grid.Column="1" Toggled="FsoDisableToggle_Toggled" OnContent="" OffContent="" MinWidth="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock x:Name="FsoStatusText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Opacity="0.8"/>
                </StackPanel>
            </Border>
            <!-- 软件更新 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="软件更新" Style="{StaticResource H2Style}"/>
                    <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="默认从自建服务器下载并替换变化文件，失败时自动回退全量更新；也可直接选择全量更新。更新前会安全退出主程序和后端，设置、备份与日志都会保留。"/>
                    <TextBlock Text="Alpha0.9193 为更新测试版，未开放运行库；更新至 Alpha0.9194 后获得完整功能。" Visibility="{x:Bind LimitedUpdateTestVisibility}" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="更新方式" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Update.UpdateModeDescription, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind Update.UpdateModeIndex, Mode=TwoWay}" IsEnabled="{x:Bind Update.ModeEnabled, Mode=OneWay}" AutomationProperties.Name="更新方式" VerticalAlignment="Center" MinWidth="210">
                            <ComboBoxItem Content="仅替换变更文件（默认）"/>
                            <ComboBoxItem Content="全量更新"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="启动时自动检查更新" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Update.CurrentVersionDetail}" Style="{StaticResource NoteStyle}"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Update.AutoCheck, Mode=TwoWay}" OnContent="" OffContent="" MinWidth="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="更新通道" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Update.UpdateChannelDescription, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind Update.UpdateChannelIndex, Mode=TwoWay}" IsEnabled="{x:Bind Update.ChannelEnabled, Mode=OneWay}" AutomationProperties.Name="更新通道" VerticalAlignment="Center" MinWidth="140">
                            <ComboBoxItem Content="内测通道"/>
                            <ComboBoxItem Content="公测通道"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="更新服务器" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Update.UpdateServerDescription, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedIndex="{x:Bind Update.UpdateServerIndex, Mode=TwoWay}" IsEnabled="{x:Bind Update.ServerEnabled, Mode=OneWay}" AutomationProperties.Name="更新服务器" VerticalAlignment="Center" MinWidth="210">
                            <ComboBoxItem Content="自动（GitHub 优先）"/>
                            <ComboBoxItem Content="仅 GitHub"/>
                            <ComboBoxItem Content="仅自建服务器"/>
                        </ComboBox>
                    </Grid>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="接收紧急算法策略" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="已安装版本启动时及每 15 分钟检查一次，沿用上方更新通道。仅应用签名验证通过的参数、内置方案和故障功能停用策略，无需重装；新算法代码仍需安装更新。关闭后立即使用内置算法。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Update.EmergencyPolicyEnabled, Mode=TwoWay}" AutomationProperties.Name="接收紧急算法策略" OnContent="" OffContent="" MinWidth="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{x:Bind Update.EmergencyPolicyStatus, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                    <InfoBar IsOpen="{x:Bind Update.InfoBarOpen, Mode=OneWay}" Severity="{x:Bind Update.Severity, Mode=OneWay}" Title="更新" Message="{x:Bind Update.StatusText, Mode=OneWay}" IsClosable="False"/>
                    <!-- 有新版本时的详情与操作 -->
                    <StackPanel Spacing="10" Visibility="{x:Bind Update.UpdateAvailable, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="新版本" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Border Style="{StaticResource ChipBorderStyle}" Background="{StaticResource AppAccentChipBrush}">
                                <TextBlock Text="{x:Bind Update.AvailableVersionText, Mode=OneWay}" Foreground="{StaticResource AppAccentBrush}" TextWrapping="Wrap" Style="{StaticResource BadgeTextStyle}"/>
                            </Border>
                            <Border Style="{StaticResource ChipBorderStyle}" Background="#33E5484D" Visibility="{x:Bind Update.Mandatory, Mode=OneWay}">
                                <TextBlock Text="必须更新" Foreground="#FFE5484D" TextWrapping="Wrap" Style="{StaticResource BadgeTextStyle}"/>
                            </Border>
                        </StackPanel>
