<Page
    x:Class="DeltaNFD.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DeltaNFD.Views">

    <ScrollViewer>
        <StackPanel MaxWidth="1080" Padding="28,20,28,32" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="外观与常规选项" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- 外观 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />

                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="应用主题" FontWeight="SemiBold" />
                            <TextBlock Text="切换界面明暗主题" Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="150" VerticalAlignment="Center"
                                  ItemsSource="{x:Bind ThemeOptions}"
                                  IsEnabled="{x:Bind ViewModel.ThemeSelectionEnabled, Mode=OneWay}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" />
                    </Grid>

                    <!-- 背景图片模式（总开关；开启时界面锁定深色主题） -->
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="背景图片模式" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                       Text="开启：显示背景图（自定义或内置）；关闭：使用系统 Mica 云母背景。开启背景图片模式期间，界面主题锁定为深色（背景图按深色调设计），浅色/深色选择暂不可用。" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.BackgroundImageEnabled, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0" Margin="0"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 主题色（自由切换工具强调色） -->
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="主题色" FontWeight="SemiBold" />
                            <TextBlock Text="自由切换工具强调色（按钮 / 开关 / 主页横幅等），立即生效并保存"
                                       Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <ItemsControl x:Name="AccentSwatchList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="local:AccentOption">
                                        <Button Click="AccentSwatch_Click" Tag="{x:Bind Hex}"
                                                Padding="0" MinWidth="34" MinHeight="26"
                                                CornerRadius="7" BorderThickness="0" VerticalAlignment="Center"
                                                ToolTipService.ToolTip="{x:Bind Name}">
                                            <Grid>
                                                <Border Width="28" Height="18" CornerRadius="5">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="{x:Bind Color}" />
                                                    </Border.Background>
                                                </Border>
                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="White"
                                                          Visibility="{x:Bind IsSelected}" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="自定义…" Click="CustomAccentButton_Click" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="自定义背景图片" FontWeight="SemiBold" />
                            <TextBlock Text="选择 PNG / JPG / WebP 图片作为全局背景（覆盖整个窗口，立即生效并持久保存）"
                                       Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Button Content="选择图片" Click="PickBackgroundButton_Click"
                                    IsEnabled="{x:Bind ViewModel.BackgroundImageEnabled, Mode=OneWay}" />
                            <Button Content="恢复默认" Click="ResetBackgroundButton_Click"
                                    IsEnabled="{x:Bind ViewModel.BackgroundImageEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="背景遮罩浓度" FontWeight="SemiBold" />
                            <TextBlock Text="背景图上的暗色遮罩：越暗文字越清晰，越透背景越明显"
                                       Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                        <Slider Grid.Column="1" MinWidth="180" VerticalAlignment="Center"
                                Minimum="0" Maximum="95" StepFrequency="5"
                                x:Name="DimSlider"
                                IsEnabled="{x:Bind ViewModel.BackgroundImageEnabled, Mode=OneWay}"
                                ValueChanged="DimSlider_ValueChanged" />
                    </Grid>

                    <TextBlock x:Name="BackgroundStatusText"
                               Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Margin="0,2,0,6" />
                </StackPanel>
            </Border>

            <!-- 常规 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="4">
                    <TextBlock Text="常规" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8" />

                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="开机自动启动" FontWeight="SemiBold" />
                            <TextBlock Text="登录 Windows 后自动运行（计划任务，不弹 UAC）" Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.AutoStart, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0" Margin="0"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="关闭时最小化到托盘" FontWeight="SemiBold" />
                            <TextBlock Text="开启后关闭窗口将驻留托盘；未开启时，若帧格或 CPU 调度正在运行，关闭窗口会提示是否开启后台运行。" Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind ViewModel.MinimizeToTray, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0" Margin="0"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- 运行日志（排障用） -->
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="运行日志" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                       Text="记录启动环境、页面导航与全部系统操作的执行结果与异常（%APPDATA%\Delta NFD\logs）。在其他电脑上出问题时，把对应时间的日志文件发回来即可定位。每次启动一个文件，自动保留 14 天。" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开日志文件夹" Click="OpenLogFolderButton_Click"
                                VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.GeneralStatusText, Mode=OneWay}"
                               Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 三角洲目录识别 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="三角洲目录识别" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="默认通过 WeGame 注册表与常见安装路径自动识别三角洲目录；如果工具无法识别（未安装 WeGame、游戏装在自定义位置），在此手动指定游戏目录，保存后着色器清理、ACE 清理、运行库拦截等功能立即使用新目录。" />

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="GamePathBox" VerticalAlignment="Center"
                                 PlaceholderText="例如 D:\WeGameApps\rail_apps\DeltaForce(2001918)" />
                        <Button Grid.Column="1" Content="浏览" Click="PickGameFolderButton_Click" />
                        <Button Grid.Column="2" Content="清除" Click="ClearGamePathButton_Click" />
                        <Button Grid.Column="3" Content="保存" Style="{StaticResource AccentButtonStyle}"
                                Click="SaveGamePathButton_Click" />
                    </Grid>

                    <TextBlock x:Name="GamePathStatusText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- 软件更新 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="软件更新" Style="{StaticResource SectionTitleStyle}" />

                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="从发布页面检查新版本：只提醒，下载与安装都需要你确认；安装包会先校验 SHA256 才允许执行。安装前本工具会退出，装完自动重新打开新版本，设置、备份与日志都会保留。" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="启动时自动检查更新" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind Update.CurrentVersionDetail}"
                                       Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsOn="{x:Bind Update.AutoCheck, Mode=TwoWay}"
                                      OnContent="" OffContent="" MinWidth="0" Margin="0"
                                      HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <InfoBar IsOpen="{x:Bind Update.InfoBarOpen, Mode=OneWay}"
                             Severity="{x:Bind Update.Severity, Mode=OneWay}"
                             Title="更新" Message="{x:Bind Update.StatusText, Mode=OneWay}"
                             IsClosable="False" />

                    <!-- 有新版本时的详情与操作 -->
                    <StackPanel Spacing="10" Visibility="{x:Bind Update.UpdateAvailable, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="新版本" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <Border Style="{StaticResource ChipBorderStyle}"
                                    Background="{StaticResource AppAccentChipBrush}">
                                <TextBlock Text="{x:Bind Update.AvailableVersionText, Mode=OneWay}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource AppAccentBrush}" />
                            </Border>
                            <Border Style="{StaticResource ChipBorderStyle}"
                                    Background="#33E5484D" Visibility="{x:Bind Update.Mandatory, Mode=OneWay}">
                                <TextBlock Text="必须更新" FontSize="11" FontWeight="SemiBold" Foreground="#FFE5484D" />
                            </Border>
                        </StackPanel>

                        <Expander Header="更新说明" HorizontalAlignment="Stretch"
                                  Visibility="{x:Bind Update.DetailsVisible, Mode=OneWay}">
                            <TextBlock Text="{x:Bind Update.Notes, Mode=OneWay}" TextWrapping="Wrap"
                                       Style="{StaticResource CardDescStyle}" Margin="0,4,0,0" />
                        </Expander>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="{x:Bind Update.ActionButtonText, Mode=OneWay}"
                                    Style="{StaticResource AccentButtonStyle}"
                                    Click="PrimaryUpdateAction_Click"
                                    IsEnabled="{x:Bind Update.ActionEnabled, Mode=OneWay}" />
                            <Button Content="跳过此版本" Click="SkipUpdateVersion_Click"
                                    IsEnabled="{x:Bind Update.SkipEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!-- 下载进度 -->
                    <StackPanel Spacing="6" Visibility="{x:Bind Update.ShowProgress, Mode=OneWay}">
                        <ProgressBar Maximum="100" Value="{x:Bind Update.ProgressPercent, Mode=OneWay}" />
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Update.ProgressText, Mode=OneWay}"
                                       Style="{StaticResource CardDescStyle}" VerticalAlignment="Center" />
                            <Button Content="取消下载" Click="CancelUpdateDownload_Click"
                                    IsEnabled="{x:Bind Update.CancelEnabled, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="检查更新" Click="CheckUpdateButton_Click"
                                IsEnabled="{x:Bind Update.CheckEnabled, Mode=OneWay}" />
                        <Button Content="更新源配置" Click="OpenUpdateSourceConfig_Click"
                                ToolTipService.ToolTip="添加国内镜像：编辑这里生成的 update-source.json（升级不会覆盖）" />
                        <HyperlinkButton Content="打开发布页面" Padding="4,0" VerticalAlignment="Center"
                                         Click="OpenUpdateReleasePage_Click" />
                        <Button Content="打开下载文件夹" Click="OpenUpdateDownloadFolder_Click" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Opacity="0.7"
                               Text="{x:Bind Update.SourceHint}" />

                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Opacity="0.7"
                               Text="说明：只有通过安装包安装的版本才支持自动更新；开发构建或手动解压运行会提示手动下载。下载失败的安装包不会被安装，可在下载文件夹里查看或重试。" />
                </StackPanel>
            </Border>

            <!-- 关于 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Border Width="48" Height="48" CornerRadius="12">
                            <Image x:Name="AboutLogoImage" Source="ms-appx:///Assets/DeltaNFD.png"
                                   Stretch="Uniform" />
                        </Border>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="三角帧不掉洲" FontSize="17" FontWeight="SemiBold" />
                                <Border Style="{StaticResource ChipBorderStyle}" Background="{StaticResource AppAccentChipBrush}">
                                    <TextBlock Text="{x:Bind ViewModel.VersionText}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource AppAccentBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Delta No FPS Drops（Delta NFD）· 三角洲行动系统级优化工具" Style="{StaticResource CardDescStyle}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,4" />

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="作者：逐梦之子-晓夕" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <HyperlinkButton NavigateUri="https://space.bilibili.com/630440925"
                                         Content="B 站主页 @逐梦之子-晓夕"
                                         Padding="4,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="本工具的大部分优化功能已真实生效（详见 README），关闭 Defender/更新禁用等高危项会降低系统安全性，使用时请自行权衡并遵守游戏用户协议。" />
                    <TextBlock FontSize="11" Opacity="0.5" TextWrapping="Wrap"
                               Text="显卡驱动级设置（低延迟 / 数字振动等）尚未实现，当前为演示数据。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
