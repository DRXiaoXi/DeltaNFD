<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:DeltaNFD.Controls" xmlns:local="using:DeltaNFD.Views" x:Class="DeltaNFD.Views.PluginPage">
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1440" Padding="28,20,28,32" Spacing="12">
            <StackPanel Spacing="4">
                <ui:PageHeader Title="拓展插件"/>
                <TextBlock Text="导入 .dnfdplugin 包并管理授权；宿主渲染声明式界面，不加载插件代码" Style="{StaticResource NoteStyle}"/>
            </StackPanel>
            <!-- 信任边界（固定常驻说明） -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <TextBlock Text="安全边界说明" Style="{StaticResource H2Style}"/>
                    <TextBlock x:Name="TrustBoundaryText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>
            <!-- 导入 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="导入插件包" Style="{StaticResource H2Style}"/>
                    <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="选择 .dnfdplugin 文件（非加密 ZIP，≤100MiB）。导入只做解析、验证与解包，不运行任何入口、依赖或安装脚本；导入后默认禁用，必须逐项确认授权后才能使用。"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="ImportButton" Content="选择文件并导入…" Click="ImportButton_Click" AutomationProperties.Name="选择插件包并导入" Style="{StaticResource PrimaryButtonStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="ImportStatusText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>
            <!-- 插件列表 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="已导入插件" Style="{StaticResource H2Style}"/>
                    <TextBlock x:Name="PluginListStatusText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    <ListView x:Name="PluginList" SelectionMode="Single" IsItemClickEnabled="False" SelectionChanged="PluginList_SelectionChanged" Visibility="{x:Bind ViewModel.HasListItems, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:PluginRowItem">
                                <Grid ColumnSpacing="12" Padding="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{x:Bind Name}" TextWrapping="Wrap" Style="{StaticResource H3Style}"/>
                                        <TextBlock Style="{StaticResource NoteStyle}" Text="{x:Bind IdLine}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{x:Bind StateText}" VerticalAlignment="Center" Style="{StaticResource NoteStyle}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>
            <!-- 选中插件详情 -->
            <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <TextBlock Text="插件详情" Style="{StaticResource H2Style}"/>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="DetailNameText" FontWeight="SemiBold" FontSize="16"/>
                        <TextBlock x:Name="DetailMetaText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                        <TextBlock x:Name="DetailPermissionsText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                    </StackPanel>
                    <StackPanel x:Name="DetailActions" Orientation="Horizontal" Spacing="8">
                        <Button x:Name="AuthorizeButton" Content="查看授权清单并启用…" Click="AuthorizeButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="DisableButton" Content="停用" Click="DisableButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="UninstallButton" Content="卸载…" Click="UninstallButton_Click" Style="{StaticResource DangerButtonStyle}"/>
                        <Button x:Name="RestoreButton" Content="恢复备份…" Click="RestoreButton_Click" Style="{StaticResource DangerButtonStyle}"/>
                        <Button x:Name="PersistentButton" Content="持续运行" Click="PersistentButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <Button x:Name="StopPersistentButton" Content="停止持续运行" Click="StopPersistentButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <!-- 声明式表单：与管理页/侧栏入口共用的渲染控件（不加载插件 XAML/HTML/脚本） -->
                    <StackPanel x:Name="PluginFormHost" Spacing="10" Visibility="Collapsed">
                        <TextBlock Text="插件界面" Style="{StaticResource H2Style}"/>
                        <local:PluginDeclarativeView x:Name="DeclarativeView"/>
                    </StackPanel>
                    <TextBlock x:Name="DetailStatusText" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                </StackPanel>
            </Border>
            <StackPanel Spacing="10">
                <TextBlock Text="运行历史" Style="{StaticResource H2Style}"/>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="HistoryPluginFilter" PlaceholderText="全部插件" HorizontalAlignment="Stretch" SelectionChanged="HistoryFilter_SelectionChanged"/>
                    <ComboBox x:Name="HistoryStatusFilter" Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0" SelectionChanged="HistoryFilter_SelectionChanged">
                        <ComboBoxItem Content="全部结果" Tag=""/>
                        <ComboBoxItem Content="成功" Tag="success"/>
                        <ComboBoxItem Content="部分成功" Tag="partial"/>
                        <ComboBoxItem Content="失败 / 被阻止" Tag="failed"/>
                        <ComboBoxItem Content="取消" Tag="cancelled"/>
                        <ComboBoxItem Content="结果未知" Tag="unknown"/>
                        <ComboBoxItem Content="待恢复" Tag="pending_restore"/>
                        <ComboBoxItem Content="请求开始" Tag="started"/>
                    </ComboBox>
                    <Button x:Name="HistoryRefreshButton" Grid.Column="2" Click="HistoryRefresh_Click" ToolTipService.ToolTip="刷新历史" AutomationProperties.Name="刷新历史" Style="{StaticResource SecondaryButtonStyle}">
                        <SymbolIcon Symbol="Refresh"/>
                    </Button>
                </Grid>
                <TextBlock x:Name="HistoryStatusText" TextWrapping="Wrap" Style="{StaticResource CardDescStyle}"/>
                <ListView x:Name="HistoryList" Height="280" SelectionMode="Single" SelectionChanged="HistoryList_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:PluginHistoryRow">
                            <StackPanel Padding="0,5" Spacing="3">
                                <TextBlock Text="{x:Bind Heading}" TextWrapping="Wrap" Style="{StaticResource BodyStyle}"/>
                                <TextBlock Text="{x:Bind Summary}" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <Button x:Name="HistoryMoreButton" Content="加载更多" Click="HistoryMore_Click" Visibility="Collapsed" Style="{StaticResource SecondaryButtonStyle}"/>
                <TextBlock x:Name="HistoryDetailText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource CardDescStyle}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
