<Page
    x:Class="DeltaNFD.Views.TimerRecoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="16" Padding="24" MaxWidth="1040" HorizontalAlignment="Stretch">
            <Button Content="返回主页" Click="Back_Click"/>
            <TextBlock Text="启动计时器配置恢复" Style="{StaticResource TitleTextBlockStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="只检测并恢复 useplatformtick 和 disabledynamictick 两项启动覆盖，不查询或修改设备管理器中的 HPET 设备。" TextWrapping="Wrap"/>
            <TextBlock Text="任一启动选项开启时显示红色警告；恢复会移除这两项覆盖，交由 Windows 使用默认行为。" TextWrapping="Wrap"/>
            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Title="正在检测当前配置"/>
            <TextBlock x:Name="CurrentText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
            <TextBlock Text="没有旧备份也可以根据当前启动配置恢复；操作前保存当前状态与执行记录，旧优化备份继续保留。" TextWrapping="Wrap"/>
            <TextBlock Text="请先退出三角洲。恢复后需手动重启电脑；本次启动的计时器行为不会立即改变。工具不会自动重启，恢复中断时可以回此页重新检测和核对。" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button x:Name="RefreshButton" Content="重新检测" Click="Refresh_Click"/>
                <Button x:Name="RecoverButton" Content="预览并恢复 Windows 默认计时器配置" Style="{StaticResource AccentButtonStyle}" Click="Recover_Click"/>
            </StackPanel>
            <TextBlock x:Name="ResultText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
        </StackPanel>
    </ScrollViewer>
</Page>
