<Page x:Class="DeltaNFD.Views.ShaderRecoveryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="1080" Padding="28,20,28,32" Spacing="16">
            <Button Content="返回检测页" Click="Back_Click" HorizontalAlignment="Left" />
            <TextBlock Text="着色器缓存修复与预热" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="先退出三角洲，再调整驱动设置、清理旧缓存，最后在游戏内重新预热。" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
            <InfoBar x:Name="StatusBar" IsOpen="True" Severity="Informational" IsClosable="False" Title="正在检测" AutomationProperties.LiveSetting="Polite" />
            <Button x:Name="RefreshButton" Content="重新检测" Click="Refresh_Click" HorizontalAlignment="Left" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="1. 恢复驱动默认（推荐）" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="全局设置会影响其他游戏；三角洲设置仅修改其程序配置中的缓存大小。非默认容量有三角洲抽帧反馈，请优先恢复驱动默认。数据库只读锁定时，先到 N 卡设置页解除锁定。" TextWrapping="Wrap" />
                    <TextBlock x:Name="CurrentText" Text="正在读取全局和三角洲的当前值…" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="全局着色器缓存大小" FontWeight="SemiBold" />
                    <ComboBox x:Name="GlobalSize" HorizontalAlignment="Stretch" AutomationProperties.Name="全局着色器缓存大小" SelectionChanged="Size_Changed" />
                    <Button x:Name="ApplyGlobalButton" Content="应用全局大小" Click="ApplyGlobal_Click" HorizontalAlignment="Left" />
                    <TextBlock Text="仅三角洲着色器缓存大小" FontWeight="SemiBold" />
                    <ComboBox x:Name="GameSize" HorizontalAlignment="Stretch" AutomationProperties.Name="三角洲着色器缓存大小" SelectionChanged="Size_Changed" />
                    <Button x:Name="ApplyGameButton" Content="应用三角洲大小" Click="ApplyGame_Click" HorizontalAlignment="Left" />
                    <InfoBar x:Name="DisabledWarning" IsOpen="False" Severity="Warning" IsClosable="False" Title="暂时关闭缓存后，必须恢复默认再预热"
                             Message="关闭缓存不是推荐的长期设置。可先关闭、清理旧缓存，然后点下方按钮恢复全局和三角洲默认，再进入游戏预热。" />
                    <Button x:Name="RestoreButton" Content="全局和三角洲恢复默认（推荐）" Click="Restore_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Text="2. 删除旧着色器缓存" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="游戏运行时不能清理。请同时退出其他游戏和图形应用；被占用或链接路径会跳过并如实报告。缓存删除无法撤销，不删除驱动或驱动配置数据库。" TextWrapping="Wrap" />
                    <CheckBox x:Name="GameCacheChoice" Content="三角洲 PSOCache（已检测到的各安装目录）" IsChecked="True" />
                    <CheckBox x:Name="NvidiaCacheChoice" Content="当前用户的 NVIDIA DXCache 与 Windows D3DSCache（其他游戏也会重新编译）" IsChecked="True" />
                    <Button x:Name="CleanButton" Content="清理所选缓存" Click="Clean_Click" HorizontalAlignment="Left" />
                    <TextBlock x:Name="CleanupText" Text="尚未清理。修改大小和清理缓存需要分别确认。" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="3. 进入游戏重新预热" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock x:Name="WarmupText" Text="先确认全局及三角洲都已恢复驱动默认。随后手动启动三角洲，等待游戏内着色器编译结束；如果没有编译进度，在训练或非排位场景逐步加载常玩地图。首次加载可能卡顿，请等编译和加载稳定后再进行正式对局。工具不能确认游戏内预热是否完成。" TextWrapping="Wrap" />
                    <Button x:Name="VerifyButton" Content="检查是否可以开始预热" Click="Verify_Click" HorizontalAlignment="Left" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
