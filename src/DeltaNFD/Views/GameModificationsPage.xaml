<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:DeltaNFD.Controls" xmlns:svc="using:DeltaNFD.Services" x:Class="DeltaNFD.Views.GameModificationsPage">
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1440" Padding="28,20,28,32" Spacing="12">
            <ui:PageHeader Title="游戏改动"/>
            <TextBlock Text="管理三角洲的全屏兼容性与洲洲时刻录制组件。修改和恢复前请完全退出游戏及录制组件。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="RefreshButton" Content="刷新状态" Click="Refresh_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button Content="管理游戏目录" Click="Settings_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
            <InfoBar x:Name="OperationBar" IsOpen="False" IsClosable="True" AutomationProperties.LiveSetting="Polite"/>
            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="正在读取游戏文件状态" AutomationProperties.LiveSetting="Polite"/>
            <Border x:Name="FsoCard" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="全屏优化" Style="{StaticResource H2Style}" ui:HelpTip.Text="沿用原设置页功能：为所有登记的三角洲主程序设置全屏兼容性标记。开启前备份原值，关闭时恢复。下次启动游戏生效；实际体验请以游戏内对比为准。"/>
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="禁用全屏优化" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="对全部已识别安装生效，下次启动游戏生效；关闭时恢复原设置。" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                        </StackPanel>
                        <ToggleSwitch x:Name="FsoDisableToggle" Grid.Column="1" IsEnabled="False" Toggled="Fso_Toggled" OnContent="" OffContent="" MinWidth="0" Margin="0" VerticalAlignment="Center" AutomationProperties.Name="禁用三角洲全屏优化"/>
                    </Grid>
                    <TextBlock x:Name="FsoStatusText" Text="正在读取…" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource CaptionStyle}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="洲洲时刻 · 录制组件" Style="{StaticResource H2Style}" ui:HelpTip.Text="分别备份 icreateDF.exe 和 recorder.exe，再以只读空文件占位阻止启动。会影响对应的录制与精彩时刻功能；未量化帧率收益。恢复时只认本工具记录的原件和空文件。游戏更新或修复后请重新核对，发现变化时不会覆盖新文件。"/>
                    <TextBlock Text="替换为只读空文件后，对应录制与精彩时刻功能将无法启动。新备份保存在软件数据目录，可按项恢复；帧率收益尚未实测。" TextWrapping="Wrap" Style="{StaticResource BodyStyle}"/>
                    <TextBlock Text="更新或修复游戏前建议先恢复原件；更新后请刷新核对。工具不会自动重做替换。" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                </StackPanel>
            </Border>
            <ItemsControl x:Name="RecordingItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="svc:GameRecordingItem">
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <StackPanel Spacing="8">
                                <TextBlock Text="{x:Bind Title}" Style="{StaticResource H3Style}" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind State}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{x:Bind FilePath}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource CaptionStyle}"/>
                                <TextBlock Text="{x:Bind Detail}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource NoteStyle}"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="替换为只读空文件" IsEnabled="{x:Bind CanApply}" Click="Replace_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Content="恢复原文件" IsEnabled="{x:Bind CanRestore}" Click="Restore_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Content="核对处理" IsEnabled="{x:Bind NeedsReview}" Click="ReviewRecording_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
