<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="using:DeltaNFD.Controls" xmlns:local="using:DeltaNFD.Views" x:Class="DeltaNFD.Views.DriverPriorityPage">
    <Grid Padding="28,20,28,28" RowSpacing="12" MaxWidth="1440" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Spacing="6">
            <ui:PageHeader Title="驱动优先级"/>
            <TextBlock Text="管理PCI设备的MSI、消息数量上限和中断优先级。" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="写入后需手动重启电脑生效。逐设备按需调整，不自动提高所有设备；原值保存在软件备份目录。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <InfoBar Grid.Row="1" x:Name="GateNotice" IsOpen="False" IsClosable="False" Severity="Informational" Title="当前仅供查看"/>
        <ScrollViewer Grid.Row="2" MaxHeight="160" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
            <InfoBar x:Name="ResultBar" IsOpen="False" IsClosable="True" Severity="Informational" Title="操作结果"/>
        </ScrollViewer>
        <StackPanel Grid.Row="3" Spacing="8">
            <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Header="搜索设备" PlaceholderText="设备名称、类别或实例路径" TextChanged="Search_Changed" AutomationProperties.Name="搜索驱动优先级设备"/>
                <ProgressRing Grid.Column="1" x:Name="BusyRing" Width="24" Height="24" IsActive="False"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="RefreshButton" Content="刷新设备" Click="Refresh_Click" Style="{StaticResource SecondaryButtonStyle}"/>
            </StackPanel>
            <Button x:Name="RestoreAllButton" Content="恢复本工具修改的全部设备" Click="RestoreAll_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"/>
            <TextBlock x:Name="SummaryText" Text="正在读取设备…" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
            <TextBlock Text="MSI开关和消息上限是登记设置；当前分配的IRQ另行展示。未知能力不作为支持，设置写入不代表当前已生效。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
        </StackPanel>
        <ListView Grid.Row="4" ItemsSource="{x:Bind Rows}" SelectionMode="None" IsItemClickEnabled="False" HorizontalContentAlignment="Stretch">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:DriverPriorityRow">
                    <Border Style="{StaticResource CardBorderStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{x:Bind Info.Device.Name}" Style="{StaticResource H3Style}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Description}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <TextBlock Text="{x:Bind CurrentText}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind Info.Device.InstanceId}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
                            <TextBlock Text="{x:Bind Detail}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                            <Grid ColumnSpacing="12" RowSpacing="10" ui:AdaptiveColumns.Enabled="True" ui:AdaptiveColumns.Threshold="780" ui:AdaptiveColumns.LeftWeight="1" ui:AdaptiveColumns.RightWeight="1">
                                <StackPanel Spacing="8" ui:AdaptiveColumns.WideRow="0" ui:AdaptiveColumns.WideColumn="0">
                                    <ComboBox Header="MSI设置" SelectedIndex="{x:Bind MsiIndex, Mode=TwoWay}" IsEnabled="{x:Bind CanEditMsi, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="设备MSI设置">
                                        <ComboBoxItem Content="关闭"/><ComboBoxItem Content="开启"/>
                                    </ComboBox>
                                    <ComboBox Header="中断优先级" SelectedIndex="{x:Bind PriorityIndex, Mode=TwoWay}" IsEnabled="{x:Bind Editable, Mode=OneWay}" HorizontalAlignment="Stretch" AutomationProperties.Name="设备中断优先级">
                                        <ComboBoxItem Content="驱动默认"/><ComboBoxItem Content="低"/><ComboBoxItem Content="正常"/><ComboBoxItem Content="高"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Spacing="8" ui:AdaptiveColumns.WideRow="0" ui:AdaptiveColumns.WideColumn="1">
                                    <TextBox Header="消息数量上限（留空或0使用驱动默认）" Text="{x:Bind LimitText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" MaxLength="10" InputScope="Number" IsEnabled="{x:Bind CanEditLimit, Mode=OneWay}" AutomationProperties.Name="设备MSI消息数量上限"/>
                                    <TextBlock Text="{x:Bind ValidationText, Mode=OneWay}" Style="{StaticResource WarningTextStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="应用此设备" Click="Apply_Click" IsEnabled="{x:Bind CanApply, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Content="按备份恢复" Click="Restore_Click" IsEnabled="{x:Bind CanRestore, Mode=OneWay}" Visibility="{x:Bind BackupVisibility}" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                            <Button Content="保留当前并归档旧备份" Click="KeepCurrent_Click" IsEnabled="{x:Bind CanKeepCurrent, Mode=OneWay}" Visibility="{x:Bind BackupVisibility}" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
