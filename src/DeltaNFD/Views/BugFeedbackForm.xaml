<UserControl
    x:Class="DeltaNFD.Views.BugFeedbackForm"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxHeight="470" RowSpacing="10">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <InfoBar x:Name="ValidationSummary" Severity="Error" IsOpen="False" IsClosable="False"
                 Title="无法生成预览，请修改以下内容" AutomationProperties.LiveSetting="Assertive" />
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">
                <StackPanel Spacing="4">
                    <TextBox x:Name="TitleInput" Header="问题标题（必填，2–100 字）"
                             PlaceholderText="例如：运行库页点击刷新后没有结果" />
                    <TextBlock x:Name="TitleError" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <ComboBox x:Name="AreaInput" Header="问题所在模块" HorizontalAlignment="Stretch" />
                    <TextBlock x:Name="AreaError" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBox x:Name="DescriptionInput" Header="问题描述与复现步骤（必填，至少 10 字）"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140"
                             PlaceholderText="请写明：操作了什么、实际出现什么、希望得到什么结果；发生时间或错误码也请填写。" />
                    <TextBlock x:Name="DescriptionCounter" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock x:Name="DescriptionError" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBox x:Name="ContactInput" Header="联系方式（选填）" MaxLength="200"
                             PlaceholderText="QQ 或邮箱，便于补充询问；可以留空" />
                    <TextBlock x:Name="ContactError" Visibility="Collapsed" TextWrapping="Wrap"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                </StackPanel>
                <CheckBox x:Name="IncludeLogsInput" IsChecked="True">
                    <TextBlock Text="附带最近最多 3 份工具应用日志（每份最多末尾 256 KiB）" TextWrapping="Wrap" />
                </CheckBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
