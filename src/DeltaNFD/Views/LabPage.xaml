<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:DeltaNFD.Controls" xmlns:vm="using:DeltaNFD.ViewModels" x:Class="DeltaNFD.Views.LabPage">
    <ScrollViewer IsEnabled="{x:Bind ViewModel.NormalModeControlsEnabled, Mode=OneWay}" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1440" Padding="28,20,28,32" Spacing="12">
            <StackPanel Spacing="4">
                <ui:PageHeader Title="调度改善"/>
                <TextBlock Text="{x:Bind TargetLabel}" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                <TextBlock Text="按本机处理器显示可用的调度选项；单/双 CCD 调度由进程管理后台执行。" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
            </StackPanel>
                        <!-- CPU 拓扑 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="处理器" Style="{StaticResource H2Style}"/>
                            <TextBlock Text="{x:Bind ViewModel.CpuNameText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource H3Style}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="重新检测" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" Click="RefreshButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </Grid>
                    <TextBlock Text="{x:Bind ViewModel.VendorText, Mode=OneWay}" Style="{StaticResource NoteStyle}"/>
                    <TextBlock Text="{x:Bind ViewModel.TopologyText, Mode=OneWay}" Style="{StaticResource NoteStyle}"/>
                </StackPanel>
            </Border>
            <Border x:Name="IntelPcoresCard" x:Load="{x:Bind ViewModel.ShowIntelPcores, Mode=OneWay}" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Intel · 优先 P 核负载" Style="{StaticResource SectionTitleStyle}" ui:HelpTip.Text="一键将当前电源计划的「生效的异类策略」设为 0，「异类线程调度策略」和「异类短线程调度策略」设为首选性能处理器（2）。交流和电池同时生效。这是调度偏好，不会禁用 E 核或锁定进程亲和性。"/>
                    <TextBlock Text="让 Windows 优先把负载放到 P 核，不禁用 E 核也不锁定亲和性。" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="一键优先 P 核负载" Style="{StaticResource PrimaryButtonStyle}" IsEnabled="{x:Bind ViewModel.CanPreferIntelPcores, Mode=OneWay}" Click="PreferIntelPcores_Click"/>
                        <Button Content="还原已备份策略" IsEnabled="{x:Bind ViewModel.IntelPcoreControlsEnabled, Mode=OneWay}" Click="RestoreIntelPcores_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.IntelPcoresBusy, Mode=OneWay}"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.IntelPcoresStatusText, Mode=OneWay}" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
            <!-- AMD CCD 判定 -->
            <Border x:Name="CcdJudgeCard" x:Load="{x:Bind ViewModel.ShowCcdJudge, Mode=OneWay}" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.CcdSectionText, Mode=OneWay}" Style="{StaticResource H2Style}"/>
                    <TextBlock Text="{x:Bind ViewModel.CcdAdvice, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.CcdItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:CcdItemVm">
                                <TextBlock Text="{x:Bind Text}" Style="{StaticResource NoteStyle}" Padding="4,2" TextWrapping="Wrap"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Text="CCD 调度" Style="{StaticResource H3Style}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,8,0,0"/>
            <!-- 双CCD 专属调度 -->
            <Border x:Name="DualCcdCard" x:Load="{x:Bind ViewModel.ShowDualCcd, Mode=OneWay}" Style="{StaticResource CardBorderStyle}" ui:HoverLift.Enabled="False">
                <StackPanel Spacing="10">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="双CCD 专属调度" Style="{StaticResource H2Style}" VerticalAlignment="Center" ui:HelpTip.Text="游戏独占一个 CCD，所有其他进程推到另一个 CCD，让游戏获得最大的 CPU 资源。CPU0 留给系统中断和内核进程以保障系统流畅度下限。"/>
                        <Border Style="{StaticResource ChipBorderStyle}" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center">
                            <TextBlock Text="实验性" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource BadgeTextStyle}"/>
                        </Border>
                        <Border Style="{StaticResource ChipBorderStyle}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" VerticalAlignment="Center">
                            <TextBlock Text="会导致 CPU 发热和功耗上升" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Style="{StaticResource BadgeTextStyle}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="游戏独占一个 CCD，其余进程推到另一个 CCD。"/>
                    <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="游戏 CCD" TextWrapping="Wrap" Style="{StaticResource H3Style}"/>
                            <TextBlock Text="选择哪个 CCD 运行游戏（另一个 CCD 给其他进程）" Style="{StaticResource NoteStyle}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center" ItemsSource="{x:Bind ViewModel.DualCcdChoices}" SelectedIndex="{x:Bind ViewModel.DualCcdGameCcdIndex, Mode=TwoWay}"/>
                    </Grid>
                    <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3">
                            <TextBlock Text="生效方式" TextWrapping="Wrap" Style="{StaticResource H3Style}"/>
                            <TextBlock Text="立即生效：马上调整所有进程亲和性；帧格生效：加入帧格模式随开关自动启停" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" MinWidth="180" VerticalAlignment="Center" SelectedIndex="{x:Bind ViewModel.DualCcdApplyModeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="立即生效"/>
                            <ComboBoxItem Content="帧格生效"/>
                        </ComboBox>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="撤销调度" IsEnabled="{x:Bind ViewModel.DualCcdRevertEnabled, Mode=OneWay}" Click="RevertDualCcdButton_Click" Style="{StaticResource DangerButtonStyle}"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="应用双CCD调度" IsEnabled="{x:Bind ViewModel.DualCcdApplyEnabled, Mode=OneWay}" Click="ApplyDualCcdButton_Click"/>
                        <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsApplying, Mode=OneWay}" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.DualCcdStatusText, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <!-- 单CCD 优化调度 -->
            <Border x:Name="SingleCcdCard" x:Load="{x:Bind ViewModel.ShowSingleCcd, Mode=OneWay}" Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="单CCD 优化调度" Style="{StaticResource H2Style}" ui:HelpTip.Text="把目标游戏进程的 CPU0 让出来：系统中断和内核进程集中在 CPU0，游戏在其余核心运行，减少调度抖动。对全部 AMD 机型可用（双CCD 机型不做 CCD 隔离、只想把 CPU0 留给系统时同样适用）。规则持久化：游戏未运行时点击即登记，游戏启动后由轮询自动应用并持续保持，恢复全部核心即解除。"/>
                    <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="让游戏避开 CPU0，系统中断和内核进程留在 CPU0。"/>
                    <TextBlock Text="{x:Bind ViewModel.GameStatusText, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                        <Button Content="恢复全部核心" IsEnabled="{x:Bind ViewModel.SingleCcdRestoreEnabled, Mode=OneWay}" Click="RestoreCpu0Button_Click" Style="{StaticResource DangerButtonStyle}"/>
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="排除 CPU0" IsEnabled="{x:Bind ViewModel.SingleCcdApplyEnabled, Mode=OneWay}" Click="ExcludeCpu0Button_Click"/>
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.SingleCcdStatusText, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Text="系统调度" Style="{StaticResource H3Style}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,8,0,0"/>
            <!-- 无省电电源计划 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="无省电电源计划" Style="{StaticResource H2Style}" ui:HelpTip.Text="针对延迟与性能优化的电源计划（导入后显示为「无省电释放模式」，并自动激活立即生效；旧版计划可通过「修正计划名称」处理）。也可在 Windows 电源选项中切换；配合帧格页「电源计划锁定」可在游戏期间保持生效。"/>
                            <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="导入后自动激活；配合帧格「电源计划锁定」可在游戏期间保持生效。"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.SchemeBusy, Mode=OneWay}" Foreground="{StaticResource AppAccentBrush}"/>
                            <Button Content="切换到无省电电源计划" IsEnabled="{x:Bind ViewModel.CanSwitchScheme, Mode=OneWay}" Click="SwitchSchemeButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Style="{StaticResource PrimaryButtonStyle}" Content="{x:Bind ViewModel.ImportSchemeButtonText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanImportScheme, Mode=OneWay}" Click="ImportSchemeButton_Click"/>
                        </StackPanel>
                    </Grid>
                    <InfoBar IsOpen="{x:Bind ViewModel.PowerLockNoticeVisible, Mode=OneWay}" Severity="Warning" Title="帧格「电源计划锁定」已开启" Message="{x:Bind ViewModel.PowerLockNoticeText, Mode=OneWay}" IsClosable="False"/>
                    <TextBlock Text="{x:Bind ViewModel.SchemeStatusText, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <!-- 异类调度策略 -->
            <Border Style="{StaticResource CardBorderStyle}" ui:HoverLift.Enabled="False">
                <StackPanel Spacing="10">
                    <TextBlock Text="异类调度策略" Style="{StaticResource H2Style}" ui:HelpTip.Text="Windows 对混合架构 CPU（大小核 / 异构核心）的调度偏好，按当前电源计划交流/直流同时设置，选择后立即生效。仅对支持异构调度的平台有实际意义（Intel 大小核 / 部分 AMD 异构配置）。两个线程调度策略取值 0–5（5=自动，系统默认，让 Windows 自行选择落核偏好）；「生效的异类策略」为总策略（0–4，Windows 官方仅以编号命名，默认 4）。"/>
                    <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="仅对大小核 / 异构 CPU 有效，选择后立即生效。"/>
                    <InfoBar IsOpen="{x:Bind ViewModel.PowerLockNoticeVisible, Mode=OneWay}" Severity="Warning" Title="帧格「电源计划锁定」已开启" Message="{x:Bind ViewModel.PowerLockNoticeText, Mode=OneWay}" IsClosable="False"/>
                    <ItemsControl ItemsSource="{x:Bind ViewModel.HeteroItems}" IsEnabled="{x:Bind ViewModel.IntelPcoreControlsEnabled, Mode=OneWay}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HeteroPolicyVm">
                                <Grid ColumnSpacing="16" Style="{StaticResource FeatureTileGridStyle}" Margin="0,4" ui:HoverLift.Enabled="True">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Title}" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource H3Style}"/>
                                            <ProgressRing Width="16" Height="16" IsActive="{x:Bind IsBusy, Mode=OneWay}" Foreground="{StaticResource AppAccentBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind CurrentText, Mode=OneWay}" Style="{StaticResource NoteStyle}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1" MinWidth="190" VerticalAlignment="Center" ItemsSource="{x:Bind Options}" SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}" SelectionChanged="HeteroPolicyCombo_SelectionChanged"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{x:Bind ViewModel.HeteroStatusText, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <TextBlock Text="三角洲规则" Style="{StaticResource H3Style}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="4,8,0,0"/>
            <!-- 三角洲规则（原进程管理「三角洲规则」页签） -->
            <Border Style="{StaticResource CardBorderStyle}" ui:HoverLift.Enabled="False">
                <StackPanel Spacing="12">
                    <TextBlock Text="三角洲主进程规则" Style="{StaticResource H2Style}" ui:HelpTip.Text="无需启动游戏即可设置优先级、效率模式、动态提升、CPU 亲和性与集合、I/O、内存及 GPU 调度优先级。规则按一个完整 EXE 路径保存，游戏启动后自动尝试应用。"/>
                    <TextBlock Text="按完整 EXE 路径保存规则，游戏启动后自动应用。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                    <TextBox x:Name="GameRulePathBox" Header="三角洲主进程完整路径" PlaceholderText="…\DeltaForce\Binaries\Win64\DeltaForceClient-Win64-Shipping.exe" MaxLength="32760"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="UseGameRulePathButton" Content="使用此路径" Click="UseGameRulePath_Click"/>
                        <Button x:Name="DetectGameRulePathButton" Content="自动识别安装位置" Click="DetectGameRulePath_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                    </StackPanel>
                    <TextBlock x:Name="GameRuleStatusText" Text="进入此页后自动识别游戏安装位置；也可粘贴主进程路径。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                    <Grid ColumnSpacing="20" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="GameRuleEditor" Grid.Column="0" IsEnabled="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                        <StackPanel Spacing="12">
                            <ComboBox x:Name="GameRuleCapabilityCombo" Header="能力" SelectedIndex="0" MinWidth="180" SelectionChanged="GameRuleCapabilityCombo_SelectionChanged" HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="CPU 优先级"/>
                                <ComboBoxItem Content="效率模式（EcoQoS）"/>
                                <ComboBoxItem Content="动态优先级提升"/>
                                <ComboBoxItem Content="CPU 亲和性（g0:0x掩码）"/>
                                <ComboBoxItem Content="CPU 集合（按组掩码）"/>
                                <ComboBoxItem Content="I/O 优先级（Low/Normal 等）"/>
                                <ComboBoxItem Content="内存优先级"/>
                                <ComboBoxItem Content="GPU 调度优先级（0–4）"/>
                            </ComboBox>
                            <ComboBox x:Name="GameRuleValueCombo" Header="应用的设置" HorizontalAlignment="Stretch"/>
                            <StackPanel x:Name="GameRuleMaskPanel" Spacing="8" Visibility="Collapsed">
                                <TextBlock Text="直接选择本机逻辑 CPU，无需启动游戏；也可手动编辑处理器组掩码。" TextWrapping="Wrap" Style="{StaticResource NoteStyle}"/>
                                <StackPanel x:Name="GameRuleCpuGroupPanel" Spacing="12"/>
                                <Button Content="使用所选 CPU" Click="UseGameRuleCpus_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"/>
                                <TextBox x:Name="GameRuleValueBox" Header="处理器组掩码" PlaceholderText="例：g0:0xF" MaxLength="512"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="GameRuleEnabledToggle" Header="启用规则" OnContent="启用" OffContent="停用" IsOn="True"/>
                            <CheckBox x:Name="GameRuleAutoTakeoverCheck" Content="允许规则接管游戏模式控制的同一属性"/>
                            <Button x:Name="SaveGameRuleButton" Content="保存规则" Click="SaveGameRule_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                        </ContentControl>
                        <StackPanel Grid.Column="1" Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="已保存规则" Style="{StaticResource H3Style}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="刷新" Click="LoadGameRules_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            </Grid>
                            <TextBlock x:Name="GameRuleCountText" FontWeight="SemiBold" Text="尚未读取规则" TextWrapping="Wrap"/>
                            <StackPanel x:Name="GameRuleListPanel" Spacing="3"/>
                            <TextBlock x:Name="GameRuleNoteText" Style="{StaticResource CaptionStyle}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="后台抑制和自动内存回收请前往帧格页开启，三角洲主进程固定排除在这两项后台操作之外。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                    <Button Content="前往帧格开启后台功能" Click="OpenFrameBackground_Click" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
