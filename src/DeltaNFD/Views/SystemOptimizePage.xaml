<Page
    x:Class="DeltaNFD.Views.SystemOptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DeltaNFD.ViewModels">

    <ScrollViewer>
        <StackPanel MaxWidth="1080" Padding="28,20,28,32" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="系统优化" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="扩展优化库（减少掉帧：进程、内存、电源与系统级调优一站式完成）" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- 子栏目选择 + 全局备份 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Bx.Sections}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BxSectionChipVm">
                                <ToggleButton Content="{x:Bind Title}"
                                              IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                                              Click="BxChip_Click"
                                              FontWeight="SemiBold" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{x:Bind ViewModel.Bx.SectionSubtitle, Mode=OneWay}"
                               Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2" />

                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="全局备份 · 一键恢复" FontWeight="SemiBold" />
                            <TextBlock Text="{x:Bind ViewModel.Bx.BackupSummary, Mode=OneWay}"
                                       Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing Width="24" Height="24"
                                          IsActive="{x:Bind ViewModel.Bx.IsBusy, Mode=OneWay}"
                                          Foreground="{StaticResource AppAccentBrush}" />
                            <Button Content="刷新状态" Click="BxRefreshButton_Click" />
                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Content="一键恢复"
                                    Command="{x:Bind ViewModel.Bx.RestoreAllCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.Bx.StatusText, Mode=OneWay}"
                               Style="{StaticResource CardDescStyle}" />
                </StackPanel>
            </Border>

            <!-- 扩展优化库条目面板（全部子栏目，含 UP推荐） -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <Border CornerRadius="8" Padding="14,10" Background="#26EF4444">
                        <TextBlock FontSize="12" Foreground="#FECACA" TextWrapping="Wrap"
                                   Text="⚠ 开关拨动仅记录你的意图，不会立即生效——确认好要改的项目后，点击「应用更改」才会写入系统；未应用前可随时拨回。各子栏目的勾选会全部保留并累计，点一次「应用更改」即跨栏目统一生效。Defender / 防火墙 / VBS / 更新 等高危项在应用时会二次确认。" />
                    </Border>

                    <Grid ColumnSpacing="16" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.Bx.StatusText, Mode=OneWay}"
                                       Style="{StaticResource CardDescStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.Bx.ApplyProgressText, Mode=OneWay}"
                                       FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                                       Visibility="{x:Bind ViewModel.Bx.IsApplyingBatch, Mode=OneWay}" />
                            <ProgressBar Value="{x:Bind ViewModel.Bx.ApplyProgress, Mode=OneWay}"
                                         Maximum="100"
                                         Foreground="{StaticResource AppAccentBrush}"
                                         Visibility="{x:Bind ViewModel.Bx.IsApplyingBatch, Mode=OneWay}" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Bind ViewModel.Bx.ApplyChangesButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.Bx.ApplyChangesEnabled, Mode=OneWay}"
                                Command="{x:Bind ViewModel.Bx.ApplyChangesCommand}"
                                VerticalAlignment="Center" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Bx.Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BxItemVm">
                                <Grid ColumnSpacing="16" Padding="0,10" BorderThickness="0,0,0,1"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind DisplayName}" FontWeight="SemiBold" FontSize="14" />
                                            <ProgressRing Width="18" Height="18"
                                                          IsActive="{x:Bind IsBusy, Mode=OneWay}"
                                                          Foreground="{StaticResource AppAccentBrush}"
                                                          VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CardDescStyle}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Button Grid.Column="1" Content="{x:Bind DetailsButtonText, Mode=OneWay}"
                                            Visibility="{x:Bind HasDetails}"
                                            FontSize="11" Padding="10,4"
                                            VerticalAlignment="Center"
                                            Click="BxDetailsButton_Click" />

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}" FontSize="12"
                                                   Opacity="0.85" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <ComboBox MinWidth="150" VerticalAlignment="Center"
                                                  IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                  Visibility="{x:Bind HasGears, Mode=OneWay}"
                                                  ItemsSource="{x:Bind GearOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedIndex="{x:Bind SelectedGearIndex, Mode=TwoWay}"
                                                  SelectionChanged="GearSelection_Changed" />
                                        <ToggleSwitch VerticalAlignment="Center"
                                                      IsEnabled="{x:Bind CanEdit, Mode=OneWay}"
                                                      Visibility="{x:Bind ShowToggle, Mode=OneWay}"
                                                      IsOn="{x:Bind IsOn, Mode=OneWay}"
                                                      Toggled="BxToggle_Toggled"
                                                      OnContent="" OffContent=""
                                                      MinWidth="0" Margin="0" HorizontalAlignment="Right" />
                                    </StackPanel>

                                    <ItemsControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                  ItemsSource="{x:Bind Details}"
                                                  Visibility="{x:Bind DetailsVisible, Mode=OneWay}"
                                                  Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <TextBlock Text="{x:Bind}" FontSize="11" Opacity="0.7"
                                                           TextWrapping="Wrap" Padding="8,1" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- UP推荐 栏目：虚拟内存（页面文件）设置 -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Visibility="{x:Bind ViewModel.Bx.IsLegacySection, Mode=OneWay}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="虚拟内存（页面文件）" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                       Text="设置固定大小的页面文件，避免系统在内存吃紧时动态扩展页面文件造成卡顿。最小/最大均不得低于 16 GB（页面文件过小会导致大型游戏内存不足报错）；写入上方所选盘符（默认系统盘，机械盘/游戏盘应用前会提示建议更换），应用后需重启电脑生效。" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing Width="24" Height="24"
                                          IsActive="{x:Bind ViewModel.PagefileBusy, Mode=OneWay}"
                                          Foreground="{StaticResource AppAccentBrush}" />
                            <StackPanel Spacing="6">
                                <Button Content="恢复修改前配置" VerticalAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.PagefileApplyEnabled, Mode=OneWay}"
                                        Click="RestoreOriginalPagefileButton_Click" />
                                <Button Content="恢复系统托管" VerticalAlignment="Center"
                                        IsEnabled="{x:Bind ViewModel.PagefileApplyEnabled, Mode=OneWay}"
                                        Click="RestorePagefileButton_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.PagefileStatusText, Mode=OneWay}"
                               Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="目标盘符" FontSize="12" VerticalAlignment="Center" />
                        <ComboBox MinWidth="250"
                                  ItemsSource="{x:Bind ViewModel.PagefileDriveChoices}"
                                  SelectedIndex="{x:Bind ViewModel.SelectedDriveIndex, Mode=TwoWay}"
                                  IsEnabled="{x:Bind ViewModel.PagefileApplyEnabled, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock Text="最小（GB）" FontSize="12" VerticalAlignment="Center" />
                        <TextBox MinWidth="90" Text="{x:Bind ViewModel.PagefileMinText, Mode=TwoWay}"
                                 IsEnabled="{x:Bind ViewModel.PagefileApplyEnabled, Mode=OneWay}" />
                        <TextBlock Text="最大（GB）" FontSize="12" VerticalAlignment="Center" />
                        <TextBox MinWidth="90" Text="{x:Bind ViewModel.PagefileMaxText, Mode=TwoWay}"
                                 IsEnabled="{x:Bind ViewModel.PagefileApplyEnabled, Mode=OneWay}" />
                        <Button Style="{StaticResource AccentButtonStyle}" Content="应用设置"
                                IsEnabled="{x:Bind ViewModel.PagefileApplyEnabled, Mode=OneWay}"
                                Click="ApplyPagefileButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
