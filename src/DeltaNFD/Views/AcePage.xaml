<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:DeltaNFD.Controls" x:Class="DeltaNFD.Views.AcePage">
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1440" Padding="28,20,28,32" Spacing="12">
            <StackPanel Spacing="4">
                <ui:PageHeader Title="ACE 相关"/>
                <TextBlock Text="AntiCheatExpert 反作弊组件管理，等效官方卸载程序" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <!-- ACE 游戏与组件归属检测 -->
            <Grid RowSpacing="12" ColumnSpacing="12" ui:AdaptiveColumns.Enabled="True" ui:AdaptiveColumns.Threshold="900" ui:AdaptiveColumns.LeftWeight="1" ui:AdaptiveColumns.RightWeight="1">
                <Border Style="{StaticResource FeatureCardBorderStyle}" ui:AdaptiveColumns.WideRow="0" ui:AdaptiveColumns.WideColumn="0" ui:AdaptiveColumns.WideSpan="1">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4" Grid.Row="0">
                                <TextBlock Text="ACE 游戏与 ACE-CORE 检测" Style="{StaticResource SectionTitleStyle}"/>
                                <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Text="读取自动识别与手动关联的 ACE 游戏，并核对驱动副本。CORE 数量超过去重后的游戏数时：未有效手动关联显示黄色；有效手动关联后仍过多显示红色。读取缺口及未匹配文件保留核对明细。"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Grid.Row="1">
                                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.CoreCheckBusy, Mode=OneWay}" Foreground="{StaticResource AppAccentBrush}"/>
                                <Button Content="{x:Bind ViewModel.CoreCheckButtonText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanCheckCore, Mode=OneWay}" Click="CheckCoreButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                <Button Content="添加游戏目录并检索" IsEnabled="{x:Bind ViewModel.CanManageManualRoots, Mode=OneWay}" Click="AddManualGameButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.ManualRootCountText, Mode=OneWay}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="选择具体游戏的安装目录，会检索其中的 ACE 组件并记住该目录。移除仅取消检索记录，不会删除游戏文件。" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"/>
                        <ScrollViewer MaxHeight="200" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                        <ItemsControl ItemsSource="{x:Bind ViewModel.ManualGameRoots}" IsEnabled="{x:Bind ViewModel.CanManageManualRoots, Mode=OneWay}" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnSpacing="12" Margin="0,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" VerticalAlignment="Center"/>
                                        <Button Grid.Column="1" Content="移除" CommandParameter="{Binding}" Click="RemoveManualGameButton_Click" Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center" AutomationProperties.Name="从 ACE 检索列表移除此目录"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Text="{x:Bind ViewModel.ManualRootsStatusText, Mode=OneWay}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
                        <InfoBar IsOpen="{x:Bind ViewModel.CoreNeedsAttention, Mode=OneWay}" Severity="{x:Bind CoreAlertSeverity(ViewModel.CoreCheckLevel, ViewModel.CoreHasExcess), Mode=OneWay}" Title="{x:Bind ViewModel.CoreAlertTitle, Mode=OneWay}" Message="{x:Bind ViewModel.CoreCheckSummary, Mode=OneWay}" IsClosable="False"/>
                        <TextBlock Text="{x:Bind ViewModel.CoreCheckText, Mode=OneWay}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" FontFamily="Consolas"/>
                        <TextBlock Text="手动清理会删除共享目录内全部 ACE-CORE*.sys，可能影响多款 ACE 游戏。仅在有实际故障时使用，不应因文件数量多而清理；检测新增的其他游戏目录不会加入清理范围。" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"/>
                        <Button Content="{x:Bind ViewModel.CoreCleanButtonText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CoreCleanEnabled, Mode=OneWay}" Click="CleanCoreFilesButton_Click" Style="{StaticResource DangerButtonStyle}"/>
                        <TextBlock Text="{x:Bind ViewModel.CoreCleanupResultText, Mode=OneWay}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.LiveSetting="Polite"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FeatureCardBorderStyle}" ui:AdaptiveColumns.WideRow="1" ui:AdaptiveColumns.WideColumn="0" ui:AdaptiveColumns.WideSpan="2">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="组件扫描" Style="{StaticResource H2Style}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="重新扫描" VerticalAlignment="Center" IsEnabled="{x:Bind ViewModel.CleanRefreshEnabled, Mode=OneWay}" Click="RefreshButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.ScanSummary, Mode=OneWay}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                        <InfoBar IsOpen="{x:Bind ViewModel.DetectionPaused, Mode=OneWay}" Severity="Informational" Title="已暂停 ACE 检测" Message="{x:Bind ViewModel.DetectionPauseText, Mode=OneWay}" IsClosable="False"/>
                        <InfoBar IsOpen="{x:Bind ViewModel.HasBlockers, Mode=OneWay}" Severity="Warning" Title="检测到阻止清理的进程" Message="{x:Bind ViewModel.BlockingText, Mode=OneWay}" IsClosable="False"/>
                        <TextBlock Text="{x:Bind ViewModel.ServicesText, Mode=OneWay}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.PathsText, Mode=OneWay}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Bind ViewModel.RegistryText, Mode=OneWay}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource FeatureCardBorderStyle}" ui:AdaptiveColumns.WideRow="0" ui:AdaptiveColumns.WideColumn="1" ui:AdaptiveColumns.WideSpan="1">
                    <Grid ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4" Grid.Row="0">
                            <TextBlock Text="一键清除 ACE" TextWrapping="Wrap" Style="{StaticResource H2Style}"/>
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Text="等效 ACE 官方卸载程序：结束 ACE 进程 → SDDL 接管并删除全部 ACE 服务 → 清理注册表（卸载项/AppDataLow）→ 删除安装目录与游戏目录内 AntiCheatExpert 文件夹。"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Grid.Row="1">
                            <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.IsCleaning, Mode=OneWay}" Foreground="{StaticResource AppAccentBrush}"/>
                            <Button Style="{StaticResource DangerButtonStyle}" Content="{x:Bind ViewModel.CleanButtonText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CleanEnabled, Mode=OneWay}" Click="CleanButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Style="{StaticResource FeatureCardBorderStyle}" ui:AdaptiveColumns.WideRow="2" ui:AdaptiveColumns.WideColumn="0" ui:AdaptiveColumns.WideSpan="2">
                    <StackPanel Spacing="10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="虚拟化环境检测" Style="{StaticResource H2Style}"/>
                                <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Text="检查固件 CPU 虚拟化、Windows 当前内核 DMA 保护和 Hypervisor / VBS 运行状态。组件安装与引导配置单独提醒，无法查询的项目标为未知；检测结果不代表 ACE 通过保证。"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.VirtCheckBusy, Mode=OneWay}" Foreground="{StaticResource AppAccentBrush}"/>
                                <Button Content="{x:Bind ViewModel.VirtCheckButtonText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanCheckVirt, Mode=OneWay}" Click="CheckVirtButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{x:Bind ViewModel.VirtSummaryText, Mode=OneWay}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                        <StackPanel Spacing="4">
                            <TextBlock Text="硬件环境（BIOS / 固件层）" TextWrapping="Wrap" Style="{StaticResource H3Style}"/>
                            <TextBlock Text="{x:Bind ViewModel.HardwareCheckText, Mode=OneWay}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" FontFamily="Consolas"/>
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Text="系统环境（Windows 层）" TextWrapping="Wrap" Style="{StaticResource H3Style}"/>
                            <TextBlock Text="{x:Bind ViewModel.SystemCheckText, Mode=OneWay}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" FontFamily="Consolas"/>
                        </StackPanel>
                        <!-- 一键修复系统层冲突（复用「系统优化」的关闭 Hyper-V / VBS 流程） -->
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind ViewModel.VirtFixText, Mode=OneWay}" Style="{StaticResource BodyStyle}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <ProgressRing Width="20" Height="20" IsActive="{x:Bind ViewModel.VirtFixBusy, Mode=OneWay}" Foreground="{StaticResource AppAccentBrush}"/>
                                <Button Content="{x:Bind ViewModel.VirtFixButtonText, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.CanFixVirt, Mode=OneWay}" Click="FixVirtButton_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- 扫描结果 -->
            <!-- 一键清除 -->
            <InfoBar IsOpen="{x:Bind ViewModel.CleanupNeedsReview, Mode=OneWay}" Severity="Warning" Title="上次 ACE 清理需要核对" Message="{x:Bind ViewModel.CleanupReviewMessage, Mode=OneWay}" IsClosable="False">
                <InfoBar.ActionButton>
                    <Button Content="核对上次清理" Click="ReviewCleanupButton_Click" IsEnabled="{x:Bind ViewModel.CleanRefreshEnabled, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}"/>
                </InfoBar.ActionButton>
            </InfoBar>
            <!-- 虚拟化环境检测 -->
            <!-- 说明 -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20,14">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Text="· 三角洲进程运行时，本页的组件扫描与 ACE-CORE 游戏归属检测会整体暂停：完全不读取 ACE 服务、目录与注册表项，避免在反作弊运行期间触碰其组件。游戏退出后自动恢复，也可手动点「重新扫描」。"/>
                    <TextBlock Style="{StaticResource NoteStyle}" TextWrapping="Wrap" Text="· sguard64.exe（反作弊守卫）或游戏本体运行时，本功能会拒绝执行——请先完全退出游戏（含后台 sguard64 进程）。"/>
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Text="·「一键清除 ACE」会将被占用的文件登记为重启后删除；「仅清理 ACE-CORE SYS」会保留被占用的文件并显示原因，供退出游戏后重试。"/>
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" Text="· 清理后请先通过游戏启动器执行普通修复，补齐 ACE 组件，再启动游戏。"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
