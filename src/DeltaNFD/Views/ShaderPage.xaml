<Page
    x:Class="DeltaNFD.Views.ShaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="1080" Padding="28,20,28,32" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="着色器维护" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="N 卡驱动体检与三角洲着色器缓存清理，解决着色器缺失 / 异常问题" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- 运行库非最适版本提醒（黄色） -->
            <Border Style="{StaticResource CardBorderStyle}"
                    Background="#26FACC15"
                    Visibility="{x:Bind ViewModel.RuntimeSuboptimal, Mode=OneWay}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚠ 运行库非最适版本" Style="{StaticResource SectionTitleStyle}"
                                       Foreground="#FDE047" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.RuntimeWarnText, Mode=OneWay}"
                                   Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Foreground="#FDE047"
                                   Text="建议到「运行库」页执行「重装运行库」：全程静默，卸载现有全部 C++ 运行库后重装 2005–2026 官方最适全系列（约 3–5 分钟）。" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="去处理" Tag="runtime" Click="JumpButton_Click"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- N 卡驱动体检 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="N 卡驱动体检" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Text="{x:Bind ViewModel.DriverAdvice, Mode=OneWay}"
                                   Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="重新检测" VerticalAlignment="Center"
                            IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}"
                            Click="RefreshButton_Click" />
                </Grid>
            </Border>

            <!-- PSOCache 清理 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="PSOCache 旧着色器文件" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.CacheText, Mode=OneWay}"
                                       Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing Width="24" Height="24"
                                          IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                                          Foreground="{StaticResource AppAccentBrush}" />
                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Content="{x:Bind ViewModel.ClearButtonText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.ClearEnabled, Mode=OneWay}"
                                    Click="ClearButton_Click" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 着色器健康检测 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="着色器健康检测" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                       Text="检测 PSOCache 的 GameVer 版本残留与 NVPH 缓存文件缺失 / 损坏（0KB）。仅对 N 卡（驱动 ≥572.83）下结论；A 卡 / I 卡自动跳过判定。" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing Width="24" Height="24"
                                          IsActive="{x:Bind ViewModel.DiagBusy, Mode=OneWay}"
                                          Foreground="{StaticResource AppAccentBrush}" />
                            <Button Content="{x:Bind ViewModel.DiagButtonText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanDiagnose, Mode=OneWay}"
                                    Click="DiagnoseButton_Click" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.DiagText, Mode=OneWay}"
                               Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               FontFamily="Consolas" />
                </StackPanel>
            </Border>

            <!-- 系统级着色器缓存 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="系统级着色器缓存" Style="{StaticResource SectionTitleStyle}" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="清理 Windows / 显卡驱动的着色器缓存（%LocalAppData% 下的 D3DSCache、NVIDIA DXCache、AMD DxCache），不含游戏目录内的 PSOCache。清理后游戏首次启动会重新编译着色器。" />
                        <TextBlock Text="{x:Bind ViewModel.SysCacheText, Mode=OneWay}"
                                   FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressRing Width="24" Height="24"
                                      IsActive="{x:Bind ViewModel.IsCleaningSystem, Mode=OneWay}"
                                      Foreground="{StaticResource AppAccentBrush}" />
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Bind ViewModel.CleanSystemButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanCleanSystem, Mode=OneWay}"
                                Click="CleanSystemButton_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 说明 -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20,14">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· PSOCache 是三角洲的着色器管线缓存。出现着色器缺失、模型发黑、贴图闪烁等异常时，清除缓存让游戏重新编译通常可以解决。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 591 / 610 / 616 系 N 卡驱动存在着色器文件缺失问题；更换驱动后建议清除一次缓存再进游戏。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 低于 572.83 的驱动使用旧着色器渲染方法，不适合当前版本三角洲，建议升级驱动后清除旧缓存。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 清除后首次进入游戏会重新编译着色器，首局可能出现卡顿 / 掉帧，属正常现象。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 游戏运行中缓存文件被锁定，需要完全退出游戏后再清理。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
