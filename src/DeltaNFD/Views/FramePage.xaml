<Page
    x:Class="DeltaNFD.Views.FramePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="1080" Padding="28,20,28,32" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="帧格" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="游戏运行期间的自动化帧数保障功能，随开随用" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- 一键帧格模式（与主界面同步） -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="46" Height="46" CornerRadius="10" Background="{StaticResource AppAccentSoftBrush}">
                        <FontIcon Glyph="&#xE9D9;" FontSize="22" Foreground="{StaticResource AppAccentBrush}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="8" Height="8"
                                     Fill="{x:Bind GameDotBrush, Mode=OneWay}" VerticalAlignment="Center" />
                            <TextBlock Text="一键帧格模式" FontWeight="SemiBold" FontSize="14" />
                        </StackPanel>
                        <TextBlock FontSize="12" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="开启后启用已配置的帧格功能（各功能开关独立控制），与主界面的「一键帧格模式」开关同步。" />
                        <TextBlock Text="{x:Bind FrameSrv.StatusText, Mode=OneWay}"
                                   FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch Grid.Column="2" VerticalAlignment="Center"
                                  IsOn="{x:Bind FrameSrv.FrameModeEnabled, Mode=OneWay}"
                                  Toggled="FrameModeToggle_Toggled"
                                  OnContent="" OffContent=""
                                  MinWidth="0" Margin="0" HorizontalAlignment="Right" />
                </Grid>
            </Border>

            <!-- 帧格功能列表 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Text="帧格功能" Style="{StaticResource SectionTitleStyle}" />

                    <!-- 功能：三角洲启动时重启 DWM -->
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="三角洲启动时重启 DWM" FontWeight="SemiBold" />
                                <Border Style="{StaticResource ChipBorderStyle}"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <TextBlock Text="DeltaForceClient-Win64-Shipping.exe" FontSize="10" Opacity="0.75" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                       Text="在部分电脑上启动三角洲后，DWM（桌面窗口管理器）进程会出现异常高的 CPU 占用。启用后，会在三角洲进程运行时重启 DWM 以恢复 DWM 正常占用；系统会立即自动拉起新的 DWM，屏幕闪烁一下属正常现象。" />
                            <TextBlock Text="{x:Bind FrameSrv.StatusText, Mode=OneWay}"
                                       FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsOn="{x:Bind FrameSrv.DwmRestartOnGameStart, Mode=TwoWay}"
                                      IsEnabled="{x:Bind FrameSrv.FeaturesEditable, Mode=OneWay}"
                                      OnContent="" OffContent=""
                                      MinWidth="0" Margin="0" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- 功能：电源计划锁定（可选定目标计划防改） -->
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="电源计划锁定" FontWeight="SemiBold" />
                                <Border Style="{StaticResource ChipBorderStyle}"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <TextBlock Text="powercfg" FontSize="10" Opacity="0.75" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{x:Bind FrameSrv.PowerPlanLockText, Mode=OneWay}"
                                       Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                       Text="锁定计划可选：默认「当前计划」不切换任何计划；也可以在下方选择一个电源计划（如无省电极限模式 / 卓越性能），开启帧格时自动切换过去并锁定。选项在帧格模式激活期间锁定。" />
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,2,0,0">
                                <TextBlock Text="锁定计划" FontSize="12" Opacity="0.85" VerticalAlignment="Center" />
                                <ComboBox x:Name="PowerLockTargetCombo" MinWidth="240"
                                          IsEnabled="{x:Bind FrameSrv.FeaturesEditable, Mode=OneWay}"
                                          SelectionChanged="PowerLockTargetCombo_SelectionChanged" />
                            </StackPanel>
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsOn="{x:Bind FrameSrv.PowerPlanLockEnabled, Mode=TwoWay}"
                                      IsEnabled="{x:Bind FrameSrv.FeaturesEditable, Mode=OneWay}"
                                      OnContent="" OffContent=""
                                      MinWidth="0" Margin="0" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- 功能：加速系统响应模式（不改电源计划；总开关 + 三个子开关） -->
                    <StackPanel Spacing="4" Padding="0,10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="加速系统响应模式（不改电源计划）" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                           Text="三项机制让系统在帧格期间保持「随时就绪」：核心常驻（防核心停放）+ 游戏进程禁电源限制 + 定时器 0.5ms。全部为运行时行为——不写系统配置、不碰任何电源计划，退出帧格或关闭本工具后自动恢复、零残留。总开关关闭时三项全部停止。" />
                                <TextBlock Text="{x:Bind FrameSrv.StatusText, Mode=OneWay}"
                                           FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsOn="{x:Bind FrameSrv.ResponseBoostEnabled, Mode=TwoWay}"
                                          IsEnabled="{x:Bind FrameSrv.FeaturesEditable, Mode=OneWay}"
                                          OnContent="" OffContent=""
                                          MinWidth="0" Margin="0" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- 三个子开关（总开关关闭时置灰） -->
                        <Border Margin="16,4,0,2" Padding="12,8" CornerRadius="8"
                                Background="{StaticResource AppAccentSoftBrush}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="核心常驻（防核心停放）" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" FontSize="11"
                                                   Text="帧格激活全程：高频轮询逐核停靠状态并把轮询线程轮流钉到每个核心，让核心来不及深度停靠——「靠活动而非电源策略」实现核心常驻待命，降低突发调度的唤醒延迟。状态文字实时显示当前停靠核心数。" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                  IsOn="{x:Bind FrameSrv.ResponseBoostCoreParkingEnabled, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind SubTogglesEditable, Mode=OneWay}"
                                                  OnContent="" OffContent="" MinWidth="0" Margin="0"
                                                  HorizontalAlignment="Right" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="游戏进程禁电源限制" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" FontSize="11"
                                                   Text="游戏运行期间：对三角洲进程禁用 EcoQoS 电源限制（强制高性能电源状态），游戏内重启后自动对新进程重新应用，退出自动交还系统控制。" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                  IsOn="{x:Bind FrameSrv.ResponseBoostEcoQosEnabled, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind SubTogglesEditable, Mode=OneWay}"
                                                  OnContent="" OffContent="" MinWidth="0" Margin="0"
                                                  HorizontalAlignment="Right" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="系统定时器 0.5ms" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" FontSize="11"
                                                   Text="帧格激活且游戏运行期间：把系统定时器分辨率请求提升到 0.5ms，帧间隔更稳、输入延迟更低；游戏退出自动释放。配合系统优化·UP推荐的「计时器分辨率常驻」可全局生效。" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                  IsOn="{x:Bind FrameSrv.ResponseBoostTimerEnabled, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind SubTogglesEditable, Mode=OneWay}"
                                                  OnContent="" OffContent="" MinWidth="0" Margin="0"
                                                  HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 功能：前台加速响应（总开关 + 两个子开关；退出帧格自动还原） -->
                    <StackPanel Spacing="4" Padding="0,10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="前台加速响应" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                           Text="帧格期间把系统调度参数临时切换为前台优先：后台资源预留从 20% 降到 10%，前台（游戏）获得更长的处理器时间片与调度加速。开启帧格时写入，退出帧格时自动还原为开启前的原值（如果你已在系统优化里应用过同款优化，还原后仍保持优化值）。" />
                                <TextBlock Text="{x:Bind FrameSrv.StatusText, Mode=OneWay}"
                                           FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsOn="{x:Bind FrameSrv.ForegroundBoostEnabled, Mode=TwoWay}"
                                          IsEnabled="{x:Bind FrameSrv.FeaturesEditable, Mode=OneWay}"
                                          OnContent="" OffContent=""
                                          MinWidth="0" Margin="0" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- 两个子开关（总开关关闭时置灰） -->
                        <Border Margin="16,4,0,2" Padding="12,8" CornerRadius="8"
                                Background="{StaticResource AppAccentSoftBrush}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="系统后台资源预留降低" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" FontSize="11"
                                                   Text="把 Windows 为后台程序预留的 CPU 资源比例从默认 20% 降到 10%（SystemResponsiveness=10），多媒体/后台任务让出更多 CPU 时间给游戏。对应系统优化·调整里的「系统后台资源预留」。" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                  IsOn="{x:Bind FrameSrv.ForegroundResponsivenessEnabled, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind ForegroundSubTogglesEditable, Mode=OneWay}"
                                                  OnContent="" OffContent="" MinWidth="0" Margin="0"
                                                  HorizontalAlignment="Right" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="前台游戏优先调度" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" FontSize="11"
                                                   Text="启用前台程序优先的处理器调度策略（0x1A）：短时间片 + 前台高加速，游戏获得更多 CPU 时间片，后台任务自动让路。对应系统优化·调整里的「前台游戏优先调度」。" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                  IsOn="{x:Bind FrameSrv.ForegroundPriorityEnabled, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind ForegroundSubTogglesEditable, Mode=OneWay}"
                                                  OnContent="" OffContent="" MinWidth="0" Margin="0"
                                                  HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 功能：降低省电延迟（总开关 + 两个子开关；退出帧格自动还原） -->
                    <StackPanel Spacing="4" Padding="0,10">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="降低省电延迟" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                           Text="帧格期间临时关闭网卡与 USB 的省电休眠，消除设备从低功耗态唤醒带来的延迟毛刺：网卡掉 ping、键鼠/手柄/声卡短暂卡顿爆音。开启帧格时写入，退出帧格时自动还原。笔记本用户注意：开启期间耗电会略增。" />
                                <TextBlock Text="{x:Bind FrameSrv.StatusText, Mode=OneWay}"
                                           FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                            </StackPanel>

                            <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                          IsOn="{x:Bind FrameSrv.PowerSaveLatencyEnabled, Mode=TwoWay}"
                                          IsEnabled="{x:Bind FrameSrv.FeaturesEditable, Mode=OneWay}"
                                          OnContent="" OffContent=""
                                          MinWidth="0" Margin="0" HorizontalAlignment="Right" />
                        </Grid>

                        <!-- 两个子开关（总开关关闭时置灰） -->
                        <Border Margin="16,4,0,2" Padding="12,8" CornerRadius="8"
                                Background="{StaticResource AppAccentSoftBrush}">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="网卡省电全禁" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" FontSize="11"
                                                   Text="关闭所有物理网卡的「允许计算机关闭此设备以节约电源」（EnablePowerManagement=0 + PnPCapabilities=24），降低网络延迟与断流；立即生效。对应系统优化·调整里的「网卡省电全禁」。" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                  IsOn="{x:Bind FrameSrv.NicPowerSavingOffEnabled, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind PowerSaveSubTogglesEditable, Mode=OneWay}"
                                                  OnContent="" OffContent="" MinWidth="0" Margin="0"
                                                  HorizontalAlignment="Right" />
                                </Grid>

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="关闭 USB 选择性暂停" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" FontSize="11"
                                                   Text="阻止系统在空闲时挂起 USB 设备（全局注册表 DisableSelectiveSuspend=1 + 当前电源计划交流/直流设置），解决键鼠/手柄/声卡短暂卡顿、掉线、爆音。对应系统优化·调整里的「关闭 USB 选择性暂停」。" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                                  IsOn="{x:Bind FrameSrv.UsbSuspendOffEnabled, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind PowerSaveSubTogglesEditable, Mode=OneWay}"
                                                  OnContent="" OffContent="" MinWidth="0" Margin="0"
                                                  HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 功能：内存清理（实验性；清空待备内存列表） -->
                    <Grid ColumnSpacing="16" Padding="0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="内存清理" FontWeight="SemiBold" />
                                <Border Style="{StaticResource ChipBorderStyle}"
                                        Background="{ThemeResource ControlFillColorDefaultBrush}">
                                    <TextBlock Text="实验性" FontSize="10" Opacity="0.75" />
                                </Border>
                                <Border Style="{StaticResource ChipBorderStyle}"
                                        Background="#33E5484D">
                                    <TextBlock Text="可能导致性能下降" FontSize="10"
                                               Foreground="#FFE5484D" />
                                </Border>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                       Text="清空系统待备内存列表（standby list），把文件缓存占用的物理内存立即释放为可用内存，给三角洲腾出干净空间。开启帧格模式时自动执行一次；之后游戏运行期间每 30 秒检查一次，内存占用达到下方设定阈值时自动清理（默认 80%，可调 30–95；10 分钟冷却，避免反复清空文件缓存反而变卡）。也可随时点「立即清理」手动执行。纯运行时行为，不写任何系统配置。" />
                            <TextBlock Text="{x:Bind FrameSrv.MemoryCleanStatusText, Mode=OneWay}"
                                       FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <ToggleSwitch IsOn="{x:Bind FrameSrv.MemoryCleanEnabled, Mode=TwoWay}"
                                          IsEnabled="{x:Bind FrameSrv.FeaturesEditable, Mode=OneWay}"
                                          OnContent="" OffContent=""
                                          MinWidth="0" Margin="0" HorizontalAlignment="Right" />
                            <Button Content="立即清理" MinWidth="88"
                                    HorizontalAlignment="Right"
                                    Click="MemoryCleanButton_Click" />
                        </StackPanel>
                    </Grid>

                    <!-- 游戏内自动清理：开关 + 占用阈值（始终显示，避免找不到该选项） -->
                    <Grid ColumnSpacing="16" Padding="0,6,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="游戏内自动清理" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" FontSize="11"
                                       Text="三角洲运行期间，系统内存占用达到设定百分比时自动清空待备内存列表（10 分钟冷却，防止反复清空反而变卡）。" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBox MinWidth="64"
                                     Text="{x:Bind FrameSrv.MemoryCleanThresholdText, Mode=TwoWay}"
                                     IsEnabled="{x:Bind FrameSrv.FeaturesEditable, Mode=OneWay}"
                                     PlaceholderText="80" HorizontalAlignment="Right" />
                            <TextBlock Text="% 占用时清理" FontSize="12" Opacity="0.85" VerticalAlignment="Center" />
                            <ToggleSwitch IsOn="{x:Bind FrameSrv.MemoryCleanGameAutoEnabled, Mode=TwoWay}"
                                          IsEnabled="{x:Bind FrameSrv.FeaturesEditable, Mode=OneWay}"
                                          OnContent="" OffContent="" MinWidth="0" Margin="0"
                                          HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <!-- 功能：双CCD 专属调度（实验室登记为帧格生效时才显示） -->
                    <Grid ColumnSpacing="16" Padding="0,10"
                          Visibility="{x:Bind FrameSrv.IsDualCcdArmed, Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="双CCD 专属调度（帧格生效）" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                       Text="已在 CPU实验室 把双CCD调度的生效方式设为「帧格生效」：开启一键帧格模式时自动让游戏独占一个 CCD、其余进程推到另一个 CCD，退出帧格模式时自动撤销。关闭本开关则帧格模式不再联动双CCD调度（登记仍在，可在 CPU实验室 调整或撤销）。" />
                        </StackPanel>

                        <ToggleSwitch Grid.Column="1" VerticalAlignment="Center"
                                      IsOn="{x:Bind FrameSrv.DualCcdSchedulingEnabled, Mode=TwoWay}"
                                      IsEnabled="{x:Bind FrameSrv.FeaturesEditable, Mode=OneWay}"
                                      OnContent="" OffContent=""
                                      MinWidth="0" Margin="0" HorizontalAlignment="Right" />
                    </Grid>

                </StackPanel>
            </Border>

            <!-- 手动操作 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="手动重启 DWM" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="不等游戏启动，立即结束并让系统重启 DWM，临时处理 DWM 占用异常。" />
                    </StackPanel>

                    <Button Grid.Column="1" Content="立即重启 DWM" VerticalAlignment="Center"
                            Click="RestartDwmButton_Click" />
                </Grid>
            </Border>

            <!-- 说明 -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20,14">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 帧格功能在本程序运行期间持续生效，每次游戏会话只自动重启一次 DWM；游戏退出后重新等待下一次启动。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 开启「电源计划锁定」后，一键帧格模式会锁定你选择的计划（默认当前计划，防止被其他程序改成省电方案），退出时自动解除并还原原计划。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 「加速系统响应模式」三项机制全部为运行时行为：不写系统配置、不修改任何电源计划，退出帧格/关闭工具后自动恢复，重启无残留。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 「前台加速响应」与「降低省电延迟」在开启帧格时写入系统调度/省电设置，退出帧格时自动还原为开启前的原值；原值备份独立保存，重启后退出帧格仍能完整还原。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 帧格模式意外退出（如进程被结束）时，上述临时改写不会自动还原；重新打开本工具后再次开启/退出帧格模式即可还原。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 双CCD 专属调度在 CPU实验室 的生效方式选为「帧格生效」后会作为帧格选项出现在本页，随帧格模式自动启停。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 重启 DWM 瞬间屏幕会黑一下 / 闪一下并自动恢复，全屏游戏中执行会短暂切回桌面，属正常现象。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 开关状态会自动保存，重启程序后保持不变。帧格模式激活期间，功能开关会被锁定，请先退出帧格模式再修改。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
