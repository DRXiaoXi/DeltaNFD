<Page
    x:Class="DeltaNFD.Views.RuntimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="1080" Padding="28,20,28,32" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="运行库" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="兼容性修复 / 高帧性修复 / 新版运行库防护" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- 运行库检测 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4">
                            <TextBlock Text="运行库检测" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                       Text="检测运行库安装记录、分支版本和异常 v14 条目；安装记录与版本提醒不等于 DLL 完整性验证。" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing Width="24" Height="24"
                                          IsActive="{x:Bind ViewModel.IsChecking, Mode=OneWay}"
                                          Foreground="{StaticResource AppAccentBrush}" />
                            <Button Content="{x:Bind ViewModel.CheckButtonText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.CanCheck, Mode=OneWay}"
                                    Click="CheckButton_Click" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{x:Bind ViewModel.CheckText, Mode=OneWay}"
                               Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               FontFamily="Consolas" />
                </StackPanel>
            </Border>

            <!-- 高帧性修复：保留原 C++ AIO 流程 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="高帧性修复" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="使用 Beta0.9 修复机制：校验完整资源，卸载检测到的 Visual C++ 运行库条目，运行完整 AIO 安装器，再安装官方 x86/x64 基线并复检。运行库防护继续使用新版实现。" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="⚠ 注意：重装会改变系统运行库环境——如果你近期有用 C++ 写东西（开发环境依赖特定运行库版本），请谨慎修复。" />
                        <TextBlock Text="{x:Bind ViewModel.RepairStatusText, Mode=OneWay}"
                                   FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing Width="24" Height="24"
                                      IsActive="{x:Bind ViewModel.IsHighFpsRepairing, Mode=OneWay}"
                                      Foreground="{StaticResource AppAccentBrush}" />
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Bind ViewModel.RepairButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.RepairEnabled, Mode=OneWay}"
                                Click="RepairButton_Click" />
                        <Button Content="停止后续步骤" Click="CancelRepairButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanCancelHighFpsRepair, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Compatibility repairs use the project's own backend, not the third-party DX tool. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Text="兼容性修复" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="检测并修复 DirectX 旧版游戏组件和 C++ 依赖，不预先卸载已有运行库，保留较新版本。适合排查游戏启动及 DLL 依赖问题；系统自带的 DirectX 11/12 核心由 Windows 维护。" />
                        <TextBlock Text="{x:Bind ViewModel.CompatibilityRepairStatusText, Mode=OneWay}"
                                   FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing Width="24" Height="24" Foreground="{StaticResource AppAccentBrush}"
                                      IsActive="{x:Bind ViewModel.IsCompatibilityRepairing, Mode=OneWay}" />
                        <Button Style="{StaticResource AccentButtonStyle}"
                                Content="{x:Bind ViewModel.CompatibilityRepairButtonText, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.RepairEnabled, Mode=OneWay}" Click="CompatibilityRepairButton_Click" />
                        <Button Content="停止后续步骤" Click="CancelRepairButton_Click"
                                IsEnabled="{x:Bind ViewModel.CanCancelCompatibilityRepair, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Shared option for both repair entry points above. -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <CheckBox Content="强力修复模式"
                              IsChecked="{x:Bind ViewModel.StrongRepairMode, Mode=TwoWay}"
                              IsEnabled="{x:Bind ViewModel.RepairEnabled, Mode=OneWay}" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="{x:Bind ViewModel.StrongRepairDescription}" />
                </StackPanel>
            </Border>

            <!-- 单独卸载 V14 运行库 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="单独卸载 V14 运行库" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="仅选择名字带「v14」的包装条目，由工具核验其关联 MSI 后统一静默卸载。年份命名条目不自动纳入；若关联组件被其他包依赖、缓存缺失或身份无法确认，停止并提示。" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="⚠ 卸载后依赖该运行库的游戏 / 软件将无法启动，直到重装运行库；Steam 启动游戏时也可能自动重装（Steamworks 共享运行库机制），游戏 / 启动器侧的重装可用下方「运行库防护模式」拦截。防护开启时请先关闭再卸载（否则卸载器会被拦截）。" />
                        <TextBlock Text="{x:Bind ViewModel.UninstallV14StatusText, Mode=OneWay}"
                                   FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressRing Width="24" Height="24"
                                      IsActive="{x:Bind ViewModel.UninstallV14Busy, Mode=OneWay}"
                                      Foreground="{StaticResource AppAccentBrush}" />
                        <Button Content="单独卸载 V14"
                                IsEnabled="{x:Bind ViewModel.UninstallV14Enabled, Mode=OneWay}"
                                Click="UninstallV14Button_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 防护模式 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="运行库防护模式" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="基础 V14：仅拦截 vc_redist.x64/x86/arm64.exe，不修改 UE4 文件权限。完全防护：拦截全部 11 项安装器，并保护已找到的 UE4 前置包。拦截按文件名全系统生效，不只针对三角洲。" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="注意：需要手动安装运行库时请先临时关闭本开关，装完再开。" />
                        <ComboBox SelectedIndex="{x:Bind ViewModel.GuardModeIndex, Mode=OneWay}"
                                  IsEnabled="{x:Bind ViewModel.GuardModeEnabled, Mode=OneWay}"
                                  SelectionChanged="GuardMode_SelectionChanged" AutomationProperties.Name="防护范围">
                            <ComboBoxItem Content="基础 V14" />
                            <ComboBoxItem Content="完全防护" />
                        </ComboBox>
                        <Button Content="强制清理拦截" Click="CleanupGuard_Click"
                                IsEnabled="{x:Bind ViewModel.GuardCleanupEnabled, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.GuardStatusText, Mode=OneWay}"
                                   FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressRing Width="24" Height="24"
                                      IsActive="{x:Bind ViewModel.GuardIsBusy, Mode=OneWay}"
                                      Foreground="{StaticResource AppAccentBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.GuardToggleText, Mode=OneWay}"
                                   FontSize="12" Opacity="0.85" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ToggleSwitch IsOn="{x:Bind ViewModel.GuardIsEnabled, Mode=OneWay}"
                                      Toggled="GuardToggle_Toggled"
                                      IsEnabled="{x:Bind ViewModel.GuardToggleEnabled, Mode=OneWay}"
                                      OnContent="" OffContent=""
                                      MinWidth="0" Margin="0" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 说明 -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20,14">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 三角洲会静默强制安装「Microsoft Visual C++ v14 Redistributable」运行库（不完善版本），可能覆盖你已安装的官方运行库，导致其它游戏 / 软件崩溃或异常。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 修复原理 = 先卸载系统上全部 C++ 运行库，再用官方 MSI 安装包重装全系列（2005–2022），恢复干净状态。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 运行库拦截已按需求从「帧格」页移除，防护开关统一在本页管理。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 手动安装任意运行库 / DirectX 组件前，请先临时关闭防护模式，否则安装器会被拦截。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
