<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="using:DeltaNFD.Controls" x:Class="DeltaNFD.Views.RuntimePage">
    <ScrollViewer HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1440" Padding="28,20,28,32" Spacing="12">
            <StackPanel Spacing="4">
                <ui:PageHeader Title="运行库"/>
                <TextBlock Text="检测并修复 C++ 运行库；14.x 固定安装与修复为 14.44。" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="{x:Bind ViewModel.BaselineDriverNotice, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasAbnormal, Mode=OneWay}" IsClosable="False" Severity="Error" Title="{x:Bind ViewModel.AbnormalTitle, Mode=OneWay}" Message="{x:Bind ViewModel.AbnormalText, Mode=OneWay}" AutomationProperties.LiveSetting="Assertive"/>
            <InfoBar IsOpen="{x:Bind ViewModel.RuntimePolicyBlocked, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="运行库功能暂不可用" Message="{x:Bind ViewModel.RuntimePolicyReason, Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/>
            <InfoBar IsOpen="{x:Bind ViewModel.RuntimeDriverUnknown, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="无法确认显卡驱动" Message="{x:Bind ViewModel.RuntimeDriverUnknownText, Mode=OneWay}" AutomationProperties.LiveSetting="Polite"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="运行库版本提醒" Message="{x:Bind ViewModel.WarningText, Mode=OneWay}"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasEvaluation, Mode=OneWay}" IsClosable="False" Severity="Informational" Title="V14 / 14.50 / 14.51：待长期评估" Message="{x:Bind ViewModel.EvaluationText, Mode=OneWay}"/>
            <InfoBar IsOpen="{x:Bind ViewModel.HasManualRepairGuidance, Mode=OneWay}" IsClosable="False" Severity="Warning" Title="手动处理与检测设置">
                <StackPanel Spacing="10">
                    <TextBlock Text="{x:Bind ViewModel.ManualRepairGuidanceText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource BodyStyle}"/>
                    <Button Content="打开 Windows 已安装的应用" Click="OpenInstalledApps_Click" IsEnabled="{x:Bind ViewModel.GuardCleanupEnabled, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}"/>
                    <Button Content="打开 14.44 原包文件夹" Click="OpenBaselineFolder_Click" IsEnabled="{x:Bind ViewModel.CanUseBaselineActions, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}"/>
                    <TextBlock Text="只打开原包文件夹，需你手动确认并运行安装器。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </InfoBar>
            <!-- 防护模式 -->
            <Grid RowSpacing="12" ColumnSpacing="12" ui:AdaptiveColumns.Enabled="True" ui:AdaptiveColumns.Threshold="900" ui:AdaptiveColumns.LeftWeight="3" ui:AdaptiveColumns.RightWeight="2">
                <StackPanel Spacing="12" ui:AdaptiveColumns.WideRow="0" ui:AdaptiveColumns.WideColumn="0" ui:AdaptiveColumns.WideSpan="1">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="8">
                            <ToggleSwitch Header="运行库检测" OnContent="检测已开启" OffContent="检测已关闭" IsOn="{x:Bind ViewModel.RuntimeDetectionEnabled, Mode=OneWay}" Toggled="RuntimeDetection_Toggled" IsEnabled="{x:Bind ViewModel.CanChangeRuntimeDetection, Mode=OneWay}"/>
                            <TextBlock Text="关闭后停止运行库检测和检测提醒；防护与手动修复不受影响。" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="仅修复 C++ 14.x" Style="{StaticResource SectionTitleStyle}" ui:HelpTip.Text="仅处理 C++ 14.x：卸载检测到的 x86/x64 C++ 14.x 登记（含未知包装，按其登记的卸载命令执行），随后安装所选的 2015–2022 双架构原包并复检。不会处理 2005–2013、SDK/Debug、ARM64 或 DirectX；修复前请关闭游戏与其他应用，并手动关闭运行库防护。&#10;&#10;未检测到已安装的 14.x 运行库时显示红色缺失警告。V14、14.50、14.51 保留蓝色“待长期评估”；其他版本、安装包装登记和读取问题沿用旧版判定，未能关联的登记或未完成的扫描显示黄色待核对，不据此自动卸载或修复。Appx 系统组件包由 Windows 管理，不替代 Win32 运行库。14.x 是共享运行库；基线特点见下方说明。卸载完成后、安装基线前会备份并清理旧版工具留下的 v14/2026 残留登记；ARM64、2005–2013、SDK/Debug 与 DirectX 不在此单独修复范围内。&#10;&#10;绕过 Windows Installer 的较新文件保护，直接用所选基线的官方文件覆盖 System32/SysWOW64 的 51 个 14.x DLL（x64 26、x86 25），包括把本机其他 14.x 版本强制对齐到目标版本。对照 Vc14RuntimeFix 1.2 补齐：普通用户不可读的权限异常会重置为目录继承权限；属主为 TrustedInstaller / 管理员只读的文件会临时接管所有权，替换成功后恢复原属主与 ACL。执行前自动备份 DLL、原 ACL/属主快照与注册表只读快照，并生成 restore.ps1；被占用文件会安排到下次启动替换，可能需要重启。不修改 MSI/ARP 安装登记。仅在关闭游戏、其他应用和运行库防护后使用。&#10;&#10;卸载前可选择安全模式引导，确认后重启至 Windows 高级启动，再按引导进入安全模式；也可在当前环境继续。重启后不会自动执行修复。&#10;&#10;安全模式下仅执行卸载，回正常模式后可在“恢复与续装”中继续安装；停止任务和恢复临时 Installer 设置也在下方独立恢复区域。"/>
                            <TextBlock Text="卸载已登记的 14.x 后安装所选基线双架构原包并复检，不处理 2005–2013。" TextWrapping="Wrap"/>
                            <TextBlock Text="固定基线：14.44.35211 · x86 / x64" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.SelectedBaselineDescription, Mode=OneWay}" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button Content="预览并仅修复 14.x" Click="Repair14_Click" IsEnabled="{x:Bind ViewModel.CanUseBaselineActions, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}"/>
                                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.RepairIsBusy, Mode=OneWay}"/>
                            </StackPanel>
                            <Button Content="强制替换 14.x DLL（高风险）" Click="ForceReplace14_Click" IsEnabled="{x:Bind ViewModel.CanUseBaselineActions, Mode=OneWay}" HorizontalAlignment="Left" Style="{StaticResource DangerButtonStyle}"/>
                            <TextBlock Text="直接覆盖 System32/SysWOW64 的 51 个 14.x DLL，可能影响其他软件，执行前会备份。" Style="{StaticResource WarningTextStyle}" TextWrapping="Wrap"/>
                            <TextBlock Style="{StaticResource WarningTextStyle}" Text="可选择重启进入安全模式卸载；重启后不会自动执行修复。" TextWrapping="Wrap"/>
                            <TextBlock Text="{x:Bind ViewModel.RepairStatusText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Style="{StaticResource BodyStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="检测并修复非 C++ 运行库" Style="{StaticResource SectionTitleStyle}" ui:HelpTip.Text="检查固定清单中的 186 项非 C++ 运行库文件，先展示清单摘要，经确认后修复。Windows 管理的组件只诊断，不覆盖；未知状态保留记录。"/>
                            <TextBlock Text="先检测并预览文件清单，再确认修复；Windows 管理的组件只诊断。" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                            <Button Content="检测并预览非 C++ 修复" Click="RepairNonCpp_Click" IsEnabled="{x:Bind ViewModel.CanUseBaselineActions, Mode=OneWay}" Style="{StaticResource PrimaryButtonStyle}"/>
                            <Button Content="恢复非 C++ 修复前文件" Click="RestoreNonCpp_Click" IsEnabled="{x:Bind ViewModel.GuardCleanupEnabled, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}"/>
                            <TextBlock Text="修复可能变更 COM 登记；恢复仅还原修复前文件，不撤销 COM 登记，不代表完整恢复。" Style="{StaticResource WarningTextStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <TextBlock Text="需要通过官方安装器安装运行库或 DirectX 时，请先关闭防护；防护按安装器文件名全系统生效。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
                <StackPanel Spacing="12" ui:AdaptiveColumns.WideRow="0" ui:AdaptiveColumns.WideColumn="1" ui:AdaptiveColumns.WideSpan="1">
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="完整重装 C++ 运行库" Style="{StaticResource H2Style}" ui:HelpTip.Text="受控卸载检测到的 C++ 2005–2013 与 14.x 后，安装 2005–2013 和 14.44 的 x86/x64 微软原包并复检。不包含 VSTO、VB 或非 C++ 运行库。身份变化、卸载失败、需要重启或结果未知时停止，保留记录；安全模式只卸载，需回正常模式重新确认安装。"/>
                            <TextBlock Text="固定基线：14.44.35211 · x86 / x64" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                            <InfoBar IsOpen="True" IsClosable="False" Severity="Warning" Title="修复前请关闭游戏、其他应用和运行库防护" Message="各修复入口共用「修复进度与恢复」区域；「停止后续步骤」不会强制结束当前安装器。"/>
                            <Button Content="预览完整重装 C++" Click="RepairHighFps_Click" IsEnabled="{x:Bind ViewModel.CanUseBaselineActions, Mode=OneWay}" HorizontalAlignment="Left" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <Grid ColumnSpacing="16" RowSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4" Grid.Row="0">
                                <TextBlock Text="运行库防护模式" TextWrapping="Wrap" Style="{StaticResource H3Style}" ui:HelpTip.Text="基础 V14：仅拦截 vc_redist.x64/x86/arm64.exe，不修改 UE4 文件权限。完全防护：拦截全部 11 项安装器，并保护已找到的 UE4 前置包。拦截按文件名全系统生效，不只针对三角洲。需要手动安装运行库时请先临时关闭防护，安装完成后再开启。"/>
                                <ComboBox SelectedIndex="{x:Bind ViewModel.GuardModeIndex, Mode=OneWay}" IsEnabled="{x:Bind ViewModel.GuardModeEnabled, Mode=OneWay}" SelectionChanged="GuardMode_SelectionChanged" AutomationProperties.Name="防护范围">
                                    <ComboBoxItem Content="基础 V14"/>
                                    <ComboBoxItem Content="完全防护"/>
                                </ComboBox>
                                <Button Content="强制清理拦截" Click="CleanupGuard_Click" IsEnabled="{x:Bind ViewModel.GuardCleanupEnabled, Mode=OneWay}" Style="{StaticResource DangerButtonStyle}"/>
                                <TextBlock Text="{x:Bind ViewModel.GuardStatusText, Mode=OneWay}" TextWrapping="Wrap" Style="{StaticResource CaptionStyle}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Grid.Row="1">
                                <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.GuardIsBusy, Mode=OneWay}" Foreground="{StaticResource AppAccentBrush}"/>
                                <TextBlock Text="{x:Bind ViewModel.GuardToggleText, Mode=OneWay}" VerticalAlignment="Center" TextWrapping="Wrap" Style="{StaticResource H3Style}"/>
                                <ToggleSwitch IsOn="{x:Bind ViewModel.GuardIsEnabled, Mode=OneWay}" Toggled="GuardToggle_Toggled" IsEnabled="{x:Bind ViewModel.GuardToggleEnabled, Mode=OneWay}" OnContent="" OffContent="" MinWidth="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="修复进度与恢复" Style="{StaticResource H2Style}"/>
                            <Button Content="停止后续步骤" Click="CancelRepair_Click" IsEnabled="{x:Bind ViewModel.RepairIsBusy, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}"/>
                            <TextBlock Text="停止后将等待当前安装事务结束，不强制结束安装器。中断后的续装和临时设置恢复可展开下方入口。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                            <Expander Header="恢复与续装" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <StackPanel Spacing="10">
                                    <Button Content="{x:Bind ViewModel.ContinueInstallLabel, Mode=OneWay}" Tag="install" Click="Repair14_Click" IsEnabled="{x:Bind ViewModel.CanUseBaselineActions, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <Button Content="恢复临时 Installer 设置" Click="RestoreInstaller_Click" Style="{StaticResource SecondaryButtonStyle}"/>
                                    <TextBlock Text="安全模式卸载后，回正常模式在此继续安装或核对恢复。" Style="{StaticResource BodyStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="InstalledRegistryDetails" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <Expander.Header>
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="安装登记（只读）" Style="{StaticResource H2Style}"/>
                                        <TextBlock Text="展开查看已安装组件和版本详情" Style="{StaticResource NoteStyle}"/>
                                    </StackPanel>
                                </Expander.Header>
                                <StackPanel Spacing="10">
                                    <ScrollViewer MaxHeight="280" HorizontalContentAlignment="Stretch" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{x:Bind ViewModel.InstalledText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" FontFamily="Consolas" Style="{StaticResource CaptionStyle}"/>
                                    </ScrollViewer>
                                    <TextBlock Text="绿色为已核验基线，红色为不兼容版本，黄色为其他或待核对条目。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Expander>
                            <Button Content="刷新防护状态" Click="RefreshGuard_Click" IsEnabled="{x:Bind ViewModel.CanReviewRuntimeRecovery, Mode=OneWay}" HorizontalAlignment="Left" Style="{StaticResource SecondaryButtonStyle}"/>
                            <Button Content="核对未完成操作" Click="ReviewRuntimeOperation_Click" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.CanReviewRuntimeRecovery, Mode=OneWay}" Style="{StaticResource SecondaryButtonStyle}"/>
                            <TextBlock Text="旧操作核对只检查事务是否结束并归档记录，不重新安装、不卸载运行库，也不代表旧修复成功。" Style="{StaticResource NoteStyle}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
