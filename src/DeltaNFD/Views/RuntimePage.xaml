<Page x:Class="DeltaNFD.Views.RuntimePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel MaxWidth="1080" Padding="28,20,28,32" Spacing="16">
            <StackPanel Spacing="4">
                <TextBlock Text="运行库" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="检测 C++ 14.x 兼容性、定向修复与管理安装器防护。" Style="{StaticResource PageSubtitleStyle}" TextWrapping="Wrap" />
            </StackPanel>
            <InfoBar IsOpen="{x:Bind ViewModel.HasAbnormal, Mode=OneWay}" IsClosable="False" Severity="Error"
                     Title="14.x 兼容性异常：14.51 或 Visual C++ v14" Message="{x:Bind ViewModel.AbnormalText, Mode=OneWay}" />
            <InfoBar IsOpen="{x:Bind ViewModel.HasWarning, Mode=OneWay}" IsClosable="False" Severity="Warning"
                     Title="版本提醒或状态待核对" Message="{x:Bind ViewModel.WarningText, Mode=OneWay}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="C++ 14.x 定向修复" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="只卸载已核验的 x86/x64 C++ 14.x 可再发行组件，再安装工具原有的 2015–2022 14.42.34433。修复前请关闭游戏与其他应用，并手动关闭运行库防护。旧版高帧、兼容、强力及全量修复已下线。" TextWrapping="Wrap" />
                    <TextBlock Text="14.x 是共享运行库；依赖较新版本的其他软件可能需要重新安装其要求的版本。修复末尾会备份并处理已核验的旧版 INF 包装残留。未知身份保留并说明原因；共享依赖不清理。颜色是项目兼容性规则，不代表文件损坏或已验证所有电脑掉帧。" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="预览并修复 14.x" Click="Repair14_Click" IsEnabled="{x:Bind ViewModel.GuardCleanupEnabled, Mode=OneWay}" />
                        <Button Content="停止后续步骤" Click="CancelRepair_Click" IsEnabled="{x:Bind ViewModel.RepairIsBusy, Mode=OneWay}" />
                        <ProgressRing Width="24" Height="24" IsActive="{x:Bind ViewModel.RepairIsBusy, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.RepairStatusText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="旧版 2026 / v14 包装残留" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="历史版本可能只剩安装列表中的 2026/v14 名称和 INF 文件。当前组件已是 14.42 时，可只处理旧包装；不需要反复卸载重装。" TextWrapping="Wrap" />
                    <TextBlock Text="{x:Bind ViewModel.LegacyText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Button Content="预览并仅处理旧版残留" Click="ProcessLegacy_Click"
                            IsEnabled="{x:Bind ViewModel.LegacyProcessingEnabled, Mode=OneWay}" HorizontalAlignment="Left" />
                    <TextBlock Text="先备份并核验旧 INF、登记及产品码，仅处理固定范围的旧包装登记和 INF/PNF。旧 MSI 仍存在时先定向修复；文件被修改、来源无法核验或事务未结束时保留并说明原因。备份路径会显示在结果中。" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <!-- 防护模式 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="4">
                        <TextBlock Text="运行库防护模式" FontWeight="SemiBold" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="基础 V14：仅拦截 vc_redist.x64/x86/arm64.exe，不修改 UE4 文件权限。完全防护：拦截全部 11 项安装器，并保护已找到的 UE4 前置包。拦截按文件名全系统生效，不只针对三角洲。" />
                        <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                   Text="注意：需要手动安装运行库时请先临时关闭本开关，装完再开。" />
                        <ComboBox SelectedIndex="{x:Bind ViewModel.GuardModeIndex, Mode=OneWay}"
                                  IsEnabled="{x:Bind ViewModel.GuardModeEnabled, Mode=OneWay}"
                                  SelectionChanged="GuardMode_SelectionChanged" AutomationProperties.Name="防护范围">
                            <ComboBoxItem Content="基础 V14" />
                            <ComboBoxItem Content="完全防护" />
                        </ComboBox>
                        <Button Content="强制清理拦截" Click="CleanupGuard_Click"
                                IsEnabled="{x:Bind ViewModel.GuardCleanupEnabled, Mode=OneWay}" />
                        <TextBlock Text="{x:Bind ViewModel.GuardStatusText, Mode=OneWay}"
                                   FontSize="11" Opacity="0.75" TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <ProgressRing Width="24" Height="24"
                                      IsActive="{x:Bind ViewModel.GuardIsBusy, Mode=OneWay}"
                                      Foreground="{StaticResource AppAccentBrush}" />
                        <TextBlock Text="{x:Bind ViewModel.GuardToggleText, Mode=OneWay}"
                                   FontSize="12" Opacity="0.85" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <ToggleSwitch IsOn="{x:Bind ViewModel.GuardIsEnabled, Mode=OneWay}"
                                      Toggled="GuardToggle_Toggled"
                                      IsEnabled="{x:Bind ViewModel.GuardToggleEnabled, Mode=OneWay}"
                                      OnContent="" OffContent=""
                                      MinWidth="0" Margin="0" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <TextBlock Text="安装登记（只读）" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.InstalledText, Mode=OneWay}" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <TextBlock Text="红色优先：14.51.x 或 Visual C++ v14；其余 14.x 非 14.42.x 黄色；14.42.x 无版本提醒。检测失败保留待核对，安装登记不能证明 DLL 完整性或游戏性能。" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                    <Button Content="刷新防护状态" Click="RefreshGuard_Click" IsEnabled="{x:Bind ViewModel.GuardCleanupEnabled, Mode=OneWay}" HorizontalAlignment="Left" />
                    <Button Content="核对未完成操作" Click="ReviewRuntimeOperation_Click" HorizontalAlignment="Left" IsEnabled="{x:Bind ViewModel.GuardCleanupEnabled, Mode=OneWay}" />
                    <TextBlock Text="旧操作核对只检查事务是否结束并归档记录，不重新安装、不卸载运行库，也不代表旧修复成功。" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardBorderStyle}">
                <TextBlock Text="需要通过官方安装器安装运行库或 DirectX 时，请先关闭防护；防护按安装器文件名全系统生效。" Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
