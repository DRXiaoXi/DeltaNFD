<Page
    x:Class="DeltaNFD.Views.NvSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:DeltaNFD.ViewModels">

    <ScrollViewer>
        <StackPanel MaxWidth="1080" Padding="28,20,28,32" Spacing="16">

            <StackPanel Spacing="4">
                <TextBlock Text="NVIDIA显卡设置" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{x:Bind TargetLabel}" TextWrapping="Wrap" Style="{StaticResource CardDescStyle}" />
                <TextBlock Text="针对目标游戏进程的驱动级设置（DLSS 模型 / 渲染比例 / 帧生成 / Smooth Motion / 抗锯齿 / 显存回退）" Style="{StaticResource PageSubtitleStyle}" />
            </StackPanel>

            <!-- 环境状态 + 数据库锁定 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="驱动环境" Style="{StaticResource SectionTitleStyle}" />
                            <TextBlock Text="{x:Bind ViewModel.GpuSummaryText, Mode=OneWay}"
                                       Style="{StaticResource CardDescStyle}" TextWrapping="Wrap" />
                            <TextBlock Text="{x:Bind ViewModel.LockStatusText, Mode=OneWay}"
                                       FontSize="12" Opacity="0.85" TextWrapping="Wrap" FontWeight="SemiBold" />
                            <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                                       Text="驱动配置数据库 = C:\ProgramData\NVIDIA Corporation\Drs\nvdrsdb0.bin 与 nvdrsdb1.bin。锁定为只读后，驱动更新 / NVIDIA App / 其他工具都无法改写驱动配置，本工具写入的优化不会被重置；需要修改任何驱动级设置（含本页）前请先解锁。" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing Width="24" Height="24"
                                          IsActive="{x:Bind ViewModel.LockBusy, Mode=OneWay}"
                                          Foreground="{StaticResource AppAccentBrush}" />
                            <Button Content="锁定为只读"
                                    IsEnabled="{x:Bind CanLock, Mode=OneWay}"
                                    Click="LockButton_Click" />
                            <Button Content="解除只读"
                                    IsEnabled="{x:Bind CanUnlock, Mode=OneWay}"
                                    Click="UnlockButton_Click" />
                        </StackPanel>
                    </Grid>

                    <InfoBar IsOpen="{x:Bind ViewModel.DrsFilesLocked, Mode=OneWay}"
                             Severity="Warning"
                             Title="数据库处于只读锁定状态"
                             Message="当前无法应用设置：请先点「解除只读」，设置完成后再重新锁定。"
                             IsClosable="False" />

                    <InfoBar IsOpen="{x:Bind ShowNoNvidia, Mode=OneWay}"
                             Severity="Error"
                             Title="未检测到 NVIDIA 显卡"
                             Message="本页功能仅面向 N 卡；A 卡 / Intel 显卡无需这些设置。"
                             IsClosable="False" />
                </StackPanel>
            </Border>

            <!-- 设置条目 -->
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="16" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                   Style="{StaticResource CardDescStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                            <ProgressRing Width="24" Height="24"
                                          IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                                          Foreground="{StaticResource AppAccentBrush}" />
                            <Button Content="刷新状态" Click="RefreshButton_Click"
                                    IsEnabled="{x:Bind CanRefresh, Mode=OneWay}" />
                            <Button Content="全部恢复默认" Click="ResetButton_Click"
                                    IsEnabled="{x:Bind CanReset, Mode=OneWay}" />
                            <Button Style="{StaticResource AccentButtonStyle}"
                                    Content="{x:Bind ViewModel.ApplyButtonText, Mode=OneWay}"
                                    IsEnabled="{x:Bind ViewModel.ApplyEnabled, Mode=OneWay}"
                                    Click="ApplyButton_Click" />
                        </StackPanel>
                    </Grid>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,2" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:NvSettingRowVm">
                                <Grid ColumnSpacing="16" Padding="0,10" BorderThickness="0,0,0,1"
                                      BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" FontSize="14" />
                                        <TextBlock Text="{x:Bind Description}" Style="{StaticResource CardDescStyle}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind StateText, Mode=OneWay}"
                                                   FontSize="11" Opacity="0.75" TextWrapping="Wrap" FontWeight="SemiBold" />
                                    </StackPanel>

                                    <ComboBox Grid.Column="1" MinWidth="230" MaxWidth="330" VerticalAlignment="Center"
                                              Visibility="{x:Bind ShowComboBox, Mode=OneWay}"
                                              ItemsSource="{x:Bind OptionLabels}"
                                              SelectedIndex="{x:Bind SelectedIndex, Mode=TwoWay}"
                                              SelectionChanged="RowCombo_SelectionChanged" />

                                    <!-- 百分比缩放行（DLSS 超分渲染比例）：覆盖开关 + 33–100% 滑条任意调节 -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12"
                                                VerticalAlignment="Center"
                                                Visibility="{x:Bind IsScale, Mode=OneWay}">
                                        <ToggleSwitch OnContent="覆盖" OffContent="默认"
                                                      IsOn="{x:Bind ScaleOverride, Mode=TwoWay}"
                                                      Toggled="ScaleToggle_Toggled"
                                                      MinWidth="0" Margin="0" />
                                        <Slider Width="190" VerticalAlignment="Center"
                                                Minimum="{x:Bind ScaleMin}" Maximum="{x:Bind ScaleMax}"
                                                StepFrequency="1" SnapsTo="StepValues"
                                                Value="{x:Bind SelectedScale, Mode=TwoWay}"
                                                IsEnabled="{x:Bind ScaleOverride, Mode=OneWay}"
                                                ValueChanged="ScaleSlider_ValueChanged" />
                                        <TextBlock Text="{x:Bind ScaleText, Mode=OneWay}"
                                                   FontSize="14" FontWeight="SemiBold" MinWidth="44"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 说明 -->
            <Border Style="{StaticResource CardBorderStyle}" Padding="20,14">
                <StackPanel Spacing="6">
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 全部设置只写入目标游戏进程（DeltaForceClient-Win64-Shipping.exe）的独立驱动配置，不影响其他游戏；首次应用时自动创建配置。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 设置立即保存到驱动配置数据库，对之后启动的游戏会话生效；游戏正在运行时建议重启游戏后确认效果。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 「恢复默认」= 删除该设置的覆盖，交还给游戏内选项 / 驱动默认值。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· 锁定数据库只读是防重置手段：驱动更新或 NVIDIA App 不会覆盖你的优化；换驱动 / 需要改设置时记得先解锁。" />
                    <TextBlock Style="{StaticResource CardDescStyle}" TextWrapping="Wrap"
                               Text="· DLSS 超分模型/渲染比例与帧生成模型的覆盖需要驱动 545 以上；Smooth Motion 档位需要支持该功能的显卡与驱动。设置项不被当前驱动支持时应用会如实报错。" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
