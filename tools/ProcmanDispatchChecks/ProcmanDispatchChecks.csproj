<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ProcmanServiceSource Condition="'$(ProcmanServiceSource)' == ''">../../src/DeltaNFD/Services/Backends/BackendProcmanService.cs</ProcmanServiceSource>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/DeltaNFD.Contracts/DeltaNFD.Contracts.csproj" />
    <Compile Include="$(ProcmanServiceSource)" Link="BackendProcmanService.cs" />
    <Compile Include="../../src/DeltaNFD/Services/CpuFrameStatusState.cs" Link="CpuFrameStatusState.cs" />
  </ItemGroup>
</Project>
