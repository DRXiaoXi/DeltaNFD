[Version]
Signature=$Windows NT$

[DefaultInstall.ntamd64]
RegisterDLLs           =Start.Installx64

[Install.ntamd64]
OptionDesc             =%AppName%
Modes                  =0,1,2,3
BeginPrompt            =BeginInsPrompt
CopyFiles              =@vcred14_x64.inf
AddReg                 =Registry.Install, Registry.nat.Install

[Uninstall.ntamd64]
BeginPrompt            =BeginUniPrompt
RunPreSetupCommands    =Msi.Uninstall
DelReg                 =Registry.Uninstall
DelFiles               =Inf.File, PNF.File

[Unattend.ntamd64]
RunPreSetupCommands    =Msi.Unattend:1
DelReg                 =Registry.Uninstall
DelFiles               =Inf.File, PNF.File

[BeginInsPrompt]
Title                  ="%AppName% Setup"
Prompt                 ="This will install %AppName% INF override. Continue?"
ButtonType             =YESNO

[BeginUniPrompt]
Title                  ="Programs and Features"
Prompt                 ="Are you sure you want to uninstall %AppName%?"
ButtonType             =YESNO

[Inf.File]
vcred14_x64.inf

[PNF.File]
vcred14_x64.PNF

[SourceDisksNames.amd64]
1 = %DiskId%

[DestinationDirs]
Inf.File               =10, inf
PNF.File               =10, inf
DefaultDestDir         =17

[Registry.Install]
HKLM,"%NatKey%\%AppARP%","DisplayIcon",0x00001000,"%11%\msiexec.exe,0"
HKLM,"%NatKey%\%AppARP%","DisplayName",0x00001000,"%AppName%"
HKLM,"%NatKey%\%AppARP%","DisplayVersion",0x00001000,"%AppVer%"
HKLM,"%NatKey%\%AppARP%","HelpLink",0x00001000,"https://aka.ms/vcredist"
HKLM,"%NatKey%\%AppARP%","URLInfoAbout",0x00001000,"http://go.microsoft.com/fwlink/?LinkId=133405"
HKLM,"%NatKey%\%AppARP%","Publisher",0x00001000,"Microsoft Corporation"
HKLM,"%NatKey%\%AppARP%","UninstallString",0x00001000,"rundll32.exe advpack.dll,LaunchINFSection vcred14_x64.inf,Uninstall"
HKLM,"%NatKey%\%AppARP%","NoModify",0x00011001,0x1
HKLM,"%NatKey%\%AppARP%","NoRepair",0x00011001,0x1
HKLM,"%NatKey%\%AppARP%","EstimatedSize",0x00011001,0x3815
HKLM,"%NatKey%\%AppARP%","SystemComponent",0x00001004

[Registry.nat.Install]
HKLM,"%NatKey%\%GuidMin%","SystemComponent",0x00010001,0x1
HKLM,"%NatKey%\%GuidAdd%","SystemComponent",0x00010001,0x1

[Registry.Uninstall]
HKLM,"%NatKey%\%AppARP%"

[Msi.Uninstall]
msiexec.exe /X%GuidAdd% /passive /norestart
msiexec.exe /X%GuidMin% /passive /norestart

[Msi.Unattend]
msiexec.exe /X%GuidAdd% /quiet /norestart
msiexec.exe /X%GuidMin% /quiet /norestart

[Start.Installx64]
11,,rundll32.exe,,,"advpack.dll,LaunchINFSection %1%\vcred14_x64.inf,Install.ntamd64"

[Strings]
DiskId                 ="vcred14_x64"
AppName                ="Microsoft Visual C++ 2026 Redistributable (x64)"
AppARP                 ="vcredist14_x64"
AppVer                 ="14.51.36247.0"
GuidMin                ="{931A2CF0-2404-45EA-82F5-345735AE6A90}"
GuidAdd                ="{6FA797CF-6B76-4B6D-87EE-768F92008720}"
NatKey                 ="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall"
WowKey                 ="SOFTWARE\Wow6432Node\Microsoft\Windows\CurrentVersion\Uninstall"
