# Windows 默认 CRLF，仓库统一 LF 由 git 处理换行转换
* text=auto
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf

# 源码文件强制 LF 入库
*.cs text eol=lf
*.xaml text eol=lf
*.csproj text eol=lf
*.sln text eol=crlf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.manifest text eol=lf
*.ps1 text eol=lf
*.py text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.cmd text eol=crlf
*.bat text eol=crlf
*.sh text eol=lf

# 二进制文件
*.png binary
*.ico binary
*.jpg binary
*.jpeg binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
*.zip binary
*.7z binary
*.pow binary

